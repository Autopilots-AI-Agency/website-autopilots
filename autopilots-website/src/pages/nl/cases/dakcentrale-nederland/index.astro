---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuizCTA from '../../../../components/premium/QuizCTA.astro';
import '../../../../styles/dcn-case.css';
const steps=[['Inspectie gepland','De juiste afspraak. Op de juiste plek.','AI-funnel en medewerkers brengen aanvragen samen in de inspectieagenda.'],['Inspecteur op pad','Iedereen weet wat er gepland staat.','Inspecteurs zien hun afspraken. Verkoop houdt overzicht over de volgende stap.'],['Offerte in opvolging','Geen offerte uit het zicht.','Zie welke offertes opvolging nodig hebben en waar een aanvraag staat.'],['Werkplanning','Van akkoord naar uitvoering.','Een gewonnen opdracht gaat verder naar de werkplanning.']];
---
<BaseLayout title="CRM op maat voor Dakcentrale Nederland | Autopilots" description="Van leadaanvraag naar inspectie, offerteopvolging en werkplanning. Een verbonden CRM voor Dakcentrale Nederland." locale="nl" customChrome>
 <Fragment slot="head">
  <link rel="alternate" hreflang="nl-NL" href={new URL('/nl/cases/dakcentrale-nederland/', Astro.site ?? Astro.url.origin).toString()} />
  <link rel="alternate" hreflang="x-default" href={new URL('/nl/cases/dakcentrale-nederland/', Astro.site ?? Astro.url.origin).toString()} />
 </Fragment>
 <div id="dcn-case">
  <header class="dc-nav dc-wrap"><a href="/nl/" class="dc-brand">AUTOPILOTS</a><QuizCTA label="Start de AI-scan" compact/></header>
  <main>
   <section class="dc-hero dc-wrap"><a class="dc-back" href="/nl/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h15"/></svg>Terug naar Autopilots</a><img class="dc-logo" src="/samenwerkingen/dakcentrale-nederland.png" alt="Dakcentrale Nederland"/><h1>AI Software die zorgt voor<br/><em>automatisering en structuur</em></h1><p class="dc-impact-period">BEHAALD IN 2026</p>
    <div class="dc-metrics">{[[20,'+','Workflows'],[4000,'+','Leads verwerkt'],[4,'','Pipelines'],[5,'','Dashboards']].map(([value,suffix,label])=><article><strong aria-label={`${value}${suffix}`}><span data-dc-count={value} aria-hidden="true">{Number(value).toLocaleString('nl-NL')}</span><small>{suffix}</small></strong><span>{label}</span></article>)}</div>
   </section>
   <section class="dc-section dc-wrap"><div class="dc-heading"><p class="dc-kicker">ALLES BEGINT BIJ DE AANVRAAG</p><h2>Verschillende kanalen.<br/><em>Eén klantbeeld.</em></h2><p>Waar de aanvraag ook binnenkomt, jullie werken vanuit hetzelfde dossier.</p></div><div class="dc-integrations"><div class="dc-channel-grid" aria-label="Kies een kanaal">{['Salesdock','Solvari','Homedeal','Meta','Google','Website','WhatsApp','Telefonie'].map((name,i)=><button type="button" data-channel={name} aria-pressed={i===1?'true':'false'} aria-controls="dc-incoming"><span class="dc-channel-symbol" aria-hidden="true">{['SD','S','H','M','G','WWW','WA','TEL'][i]}</span><span>{name}</span></button>)}</div><svg class="dc-channel-lines" aria-hidden="true"><g data-channel-tracks></g><path data-channel-active/><path data-channel-pulse pathLength="100"/></svg><div id="dc-incoming" class="dc-incoming"><div class="dc-incoming-bar"><span><i></i> DCN / NIEUWE AANVRAAG</span><small>Voorbeeld</small></div><div class="dc-incoming-body"><span class="dc-incoming-id">DOSSIER DCN-024</span><h3>Dakinspectie</h3><p>Een nieuwe aanvraag. Alle context bij elkaar.</p><dl class="dc-contact-fields"><div><dt>Naam</dt><dd>Voorbeeldklant</dd></div><div><dt>Telefoonnummer</dt><dd>06 •••• ••••</dd></div><div><dt>E-mailadres</dt><dd>klant@example.com</dd></div><div><dt>Probleembeschrijving</dt><dd>Lekkage bij de dakrand na regen. Graag een inspectie om de oorzaak vast te stellen.</dd></div><div><dt>In CRM gekomen op</dt><dd><time datetime="2026-10-30">30 oktober 2026</time></dd></div></dl><div class="dc-incoming-details"><span>Herkomst<strong data-channel-label>Solvari</strong></span><span>Status<strong class="dc-new-status">Nieuw</strong></span></div></div><div class="dc-incoming-bottom"><span class="dc-ready-dot"></span>Klaar voor opvolging<span aria-hidden="true">01</span></div></div></div></section>
   <section class="dc-section dc-wrap dc-followup"><div class="dc-heading"><p class="dc-kicker">TWEE ROUTES. ÉÉN PROCES.</p><h2>AI versnelt.<br/><em>Mensen houden de regie.</em></h2><p>Automatisch waar het kan. Persoonlijk waar het nodig is.</p></div><div class="dc-route-switch" aria-label="Kies een opvolgroute"><button data-route="0" aria-pressed="true">Via AI</button><button data-route="1" aria-pressed="false">Via medewerker</button></div><div class="dc-routes"><article class="dc-panel" data-dc-reveal><span class="dc-route-icon">AI</span><h3>Opvolging met AI</h3><p>Van de aanvraag naar een geplande inspectie via de AI-funnel.</p><ol><li>Aanvraag ontvangen</li><li>Gerichte vragen</li><li>Inspectie gepland</li></ol></article><article class="dc-panel" data-dc-reveal><span class="dc-route-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 3 3 5-2 2c1 3 2 4 5 5l2-2 5 3c-1 4-3 5-6 4C8 18 4 14 3 8c-1-3 1-5 5-5Z"/></svg></span><h3>Persoonlijke opvolging</h3><p>Medewerkers bekijken de aanvraag en bellen direct vanuit het systeem.</p><ol><li>Klantcontext bekijken</li><li>Direct contact opnemen</li><li>Inspectie inplannen</li></ol></article></div><div class="dc-route-lines" aria-hidden="true"><i></i><i></i></div><div class="dc-join"><span class="dc-kicker">DOSSIER DCN-024 · VOORBEELD</span><strong>Inspectie ingepland</strong><span data-route-result>Via de AI-funnel. Zichtbaar voor de inspecteur.</span></div></section>
   <section class="dc-section dc-journey dc-wrap"><div class="dc-heading"><p class="dc-kicker">VAN VERKOOP NAAR UITVOERING</p><h2>Eén aanvraag.<br/><em>Elke stap in beeld.</em></h2></div><div class="dc-console dc-timeline"><div class="dc-tabs" role="tablist" aria-label="Stappen in het proces">{['Inspectie plannen','Inspectie uitvoeren','Offerte opvolgen','Werk inplannen'].map((label,i)=><button role="tab" id={`dc-tab-${i}`} aria-controls={`dc-step-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-dc-tab={i}><span>0{i+1}</span>{label}</button>)}</div>{['De afspraak staat in de agenda.','De inspecteur ziet waar hij moet zijn.','Verkoop ziet wat nog aandacht vraagt.','Na akkoord wordt de uitvoering gepland.'].map((caption,i)=><div class="dc-stage dc-simple-stage" id={`dc-step-${i}`} role="tabpanel" aria-labelledby={`dc-tab-${i}`} hidden={i!==0}><div class:list={['dc-process-card',`dc-process-${i}`]}><header><span>DAKINSPECTIE · DCN-024</span><small>Voorbeeld</small></header><div class="dc-process-content"><span class="dc-process-status">{['Afspraak ingepland','Klaar voor inspectie','Opvolging nodig','Akkoord ontvangen'][i]}</span><h3>{['Dakinspectie gepland','De inspecteur aan zet','Offerte in opvolging','Door naar uitvoering'][i]}</h3><div class="dc-step-visual">{i===0?<div class="dc-booking-ticket"><div class="dc-ticket-date"><span>WOENSDAG</span><strong>14</strong><small>Voorbeelddatum</small></div><div class="dc-ticket-info"><span>DAKINSPECTIE</span><strong>10:00 — 11:00</strong><p>Lekkage bij de dakrand</p><div class="dc-person"><i aria-hidden="true">DC</i><span>Inspecteur<strong>Toegewezen medewerker</strong></span></div></div></div>:i===1?<div class="dc-inspection-visual"><svg viewBox="0 0 240 130" aria-hidden="true"><path d="M20 100 95 28l122 45-75 42Z" fill="#bd875d12"/><path d="m20 100 75-72 122 45-75 42Zm75-72 47 87M46 76l123 27M70 52l122 37" stroke="#bd875d" fill="none"/><circle cx="183" cy="83" r="17" fill="#d8b394"/><path d="m177 83 4 4 8-9" stroke="#101e25" fill="none"/></svg><div><span>AFSPRAAK BESCHIKBAAR</span><strong>Alles bij de hand.</strong><p>Tijd, aanvraag en klantcontext in één overzicht.</p><small>DCN-024 · Dakinspectie</small></div></div>:i===2?<div class="dc-offer-visual"><div class="dc-paper"><span>DCN / OFFERTE</span><strong>Dakwerk</strong><i></i><i></i><i></i><div>In opvolging</div></div><div class="dc-offer-action"><span>VOLGENDE ACTIE</span><strong>Persoonlijk contact</strong><p>De offerte bespreken en de vervolgstap vastleggen.</p><small>Verantwoordelijk: verkoop</small></div></div>:<div class="dc-planning-visual"><div class="dc-plan-head"><span>WERKPLANNING</span><small>Na akkoord</small></div><div class="dc-plan-days">{['MA','DI','WO','DO','VR'].map(d=><span>{d}</span>)}</div><div class="dc-plan-track"><span>Opdracht DCN-024</span><strong>Dakwerk voorbereiden</strong><small>Dezelfde aanvraag. Verder naar uitvoering.</small></div><div class="dc-plan-empty"><i></i><i></i><i></i></div></div>}</div></div><footer><span class="dc-ready-dot"></span>{['Zichtbaar in de inspectieagenda','Afspraak en aanvraag bij elkaar','Status en opvolging inzichtelijk','Van gewonnen opdracht naar planning'][i]}</footer></div>{i!==0&&<p class="dc-step-caption">{caption}</p>}</div>)}</div><div class="dc-scroll-steps" aria-hidden="true">{steps.map((_,i)=><div data-dc-scroll={i}></div>)}</div></section>
   <section class="dc-section dc-wrap"><div class="dc-heading"><p class="dc-kicker">VIJF DASHBOARDS. MEER OVERZICHT.</p><h2>Niet alleen gegevens.<br/><em>Weten waar je moet handelen.</em></h2><p>Inzicht in omzet, gemiste kansen en conversie per kanaal.</p></div>
    <div class="dc-insights" data-dc-reveal>
     <header class="dc-insights-header"><div><h3>Grip op je verkoop.</h3></div><span class="dc-demo-badge">Voorbeelddata · geen live cijfers</span></header>
     <div class="dc-insights-toolbar"><span>Commercieel overzicht</span><span>Oktober 2026 · voorbeeldperiode</span></div>
     <div class="dc-kpi-grid">{[['Ontvangen leads','240','Uit 5 kanalen'],['Inspecties gepland','84','35% van alle leads'],['Openstaande offertes','32','€ 288.000 offertewaarde'],['Gewonnen omzet','€ 180.000','18 getekende offertes']].map(([label,value,note])=><article><span>{label}</span><strong>{value}</strong><small>{note}</small></article>)}</div>
     <div class="dc-insights-middle">
      <article class="dc-insight-panel"><header><div><span class="dc-kicker">VERKOOP</span><h4>Van offerte naar opdracht</h4></div><span class="dc-insight-total">€ 180.000</span></header><div class="dc-revenue-chart" role="img" aria-label="Fictieve gewonnen omzet per week: 30.000, 45.000, 40.000 en 65.000 euro.">{[['Week 1',30],['Week 2',45],['Week 3',40],['Week 4',65]].map(([week,value])=><div><span>€ {value}k</span><i style={`--bar-height:${Number(value)/65*100}%`}></i><small>{week}</small></div>)}</div></article>
      <article class="dc-insight-panel dc-attention"><header><div><span class="dc-kicker">AANDACHT NODIG</span><h4>Geen kans uit het oog.</h4></div></header>{[['12','Leads nog niet bereikt','Opnieuw contact opnemen'],['8','Offertes zonder reactie','Persoonlijk opvolgen'],['3','Inspecties te bevestigen','Afspraak afstemmen']].map(([n,title,note])=><div class="dc-attention-row"><strong>{n}</strong><div><b>{title}</b><small>{note}</small></div><span class="dc-attention-dot" aria-hidden="true"></span></div>)}</article>
     </div>
     <article class="dc-insight-panel dc-source-panel"><header><div><span class="dc-kicker">LEADS & BRONNEN</span><h4>Welk kanaal levert resultaat?</h4></div><span>Conversie = lead naar inspectie</span></header><div class="dc-table-scroll" tabindex="0" role="region" aria-label="Voorbeeldresultaten per kanaal"><table><thead><tr><th scope="col">Kanaal</th><th scope="col">Leads</th><th scope="col">Inspecties</th><th scope="col">Conversie</th><th scope="col">Getekend</th><th scope="col">Omzet</th></tr></thead><tbody>{[['Solvari',80,28,'35%',6,'€ 60.000'],['Homedeal',60,18,'30%',4,'€ 40.000'],['Meta',50,15,'30%',3,'€ 30.000'],['Google',30,15,'50%',3,'€ 30.000'],['Website',20,8,'40%',2,'€ 20.000']].map(([name,leads,visits,conversion,deals,revenue])=><tr><th scope="row">{name}</th><td>{leads}</td><td>{visits}</td><td><span class="dc-conversion">{conversion}</span></td><td>{deals}</td><td>{revenue}</td></tr>)}</tbody><tfoot><tr><th scope="row">Totaal</th><td>240</td><td>84</td><td>35%</td><td>18</td><td>€ 180.000</td></tr></tfoot></table></div></article>
     <p class="dc-insights-note">Alle bedragen en aantallen in dit dashboard zijn fictieve voorbeelddata.</p>
    </div>
   </section>
   <section class="dc-section dc-cta dc-wrap"><p class="dc-kicker">GEBOUWD RONDOM JULLIE WERK</p><h2>Meer overzicht.<br/><em>Grip op iedere volgende stap.</em></h2><p>Wat zou meer overzicht voor jullie bedrijf betekenen?</p><QuizCTA label="Ontdek jullie AI mogelijkheden"/></section>
  </main><footer class="dc-footer dc-wrap"><a class="dc-brand" href="/nl/">AUTOPILOTS</a><a href="/nl/privacy/">Privacy</a></footer>
 </div>
 <script>import '../../../../scripts/dcn-case';</script>
</BaseLayout>
