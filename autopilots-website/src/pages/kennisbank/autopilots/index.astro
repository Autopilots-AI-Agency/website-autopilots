---
import KnowledgeLibrary from "../../../components/ecosystem/KnowledgeLibrary.astro";
import { solutionCopy } from '../../../data/solutions';
import type { SupportedLocale } from "../../../i18n/languages";
import { localizedPath } from "../../../i18n/routes";
interface Props {locale?:SupportedLocale}
const {locale="nl"}=Astro.props;
const rows={
 nl:[["Zo bouwen we een AI-medewerker die live kan","Van onboarding en architectuur tot AI-brein, koppelingen, demo, livegang en optimalisatie.","Implementatie","Proces"],["Het AI-brein: kennis, regels en menselijke fallback","Hoe scripts, klantcontext, uitzonderingen en tone of voice samen een betrouwbare AI-medewerker vormen.","AI-brein","Autopilots methode"],["Onze producten voor één doorlopende klantreis","Bekijk hoe Inboxmedewerker, Leadopvolger, Telefoniste, CRM en Leadsmachine samen of los werken.","Producten","Productoverzicht"],["Van gesprek naar CRM-actie","Waarom een AI-gesprek pas waarde krijgt wanneer afspraak, taak, ticket, status of overdracht wordt verwerkt.","CRM-acties","Autopilots CRM"],["Een eigen klantreis voor iedere branche","Intake, urgentie, planning, systemen en uitzonderingen worden per branche ingericht.","Klantreizen","21 branches"],["Hoe we koppelingen bepalen","We toetsen kanalen, agenda, CRM, formulieren, API’s, rechten en menselijke overdracht vóór de bouw.","Koppelingen","Architectuur"],["Monitoring en optimalisatie na livegang","Echte gesprekken laten zien waar antwoorden, routes en systeemacties slimmer kunnen worden.","Optimalisatie","Na livegang"],["De mensen achter Autopilots","Maak kennis met het team voor strategie, bouw, operations en voortdurende optimalisatie.","Crew","Over Autopilots"]],
 en:[["How we build an AI colleague ready for launch","From onboarding and architecture to AI brain, integrations, demo, launch and optimisation.","Implementation","Process"],["The AI brain: knowledge, rules and human fallback","How scripts, customer context, exceptions and tone create a reliable AI colleague.","AI brain","Autopilots method"],["Our products for one continuous customer journey","See how Inbox, Follow-up, Receptionist, CRM and Lead Engine work together or separately.","Products","Product overview"],["From conversation to CRM action","Why an AI conversation creates value when the appointment, task, ticket, status or handoff is processed.","CRM actions","Autopilots CRM"],["A dedicated customer journey for every industry","Intake, urgency, planning, systems and exceptions are configured per industry.","Customer journeys","21 industries"],["How we determine integrations","We verify channels, calendar, CRM, forms, APIs, rights and human handoff before building.","Integrations","Architecture"],["Monitoring and optimisation after launch","Real conversations reveal where answers, routes and system actions can improve.","Optimisation","After launch"],["The people behind Autopilots","Meet the team for strategy, development, operations and ongoing optimisation.","Team","About Autopilots"]],
 es:[["Cómo creamos un colaborador de IA listo para operar","De la incorporación y arquitectura al cerebro de IA, integraciones, demo, lanzamiento y optimización.","Implementación","Proceso"],["El cerebro de IA: conocimiento, reglas y transferencia","Cómo guiones, contexto, excepciones y tono forman un colaborador fiable.","Cerebro de IA","Método Autopilots"],["Nuestros productos para un recorrido continuo","Descubre cómo bandeja, seguimiento, recepcionista, CRM y captación funcionan juntos o por separado.","Productos","Resumen"],["De conversación a acción CRM","El valor aparece cuando se procesa cita, tarea, ticket, estado o transferencia.","Acciones CRM","Autopilots CRM"],["Un recorrido propio para cada sector","Toma de datos, urgencia, agenda, sistemas y excepciones se configuran por sector.","Recorridos","21 sectores"],["Cómo definimos las integraciones","Comprobamos canales, agenda, CRM, formularios, APIs, permisos y transferencia antes de construir.","Integraciones","Arquitectura"],["Monitorización y optimización tras el lanzamiento","Las conversaciones reales muestran dónde mejorar respuestas, rutas y acciones.","Optimización","Tras el lanzamiento"],["Las personas detrás de Autopilots","Conoce al equipo de estrategia, desarrollo, operaciones y mejora continua.","Equipo","Sobre Autopilots"]],
 de:[["So bauen wir einen livefähigen KI-Kollegen","Von Onboarding und Architektur bis KI-Gehirn, Integrationen, Demo, Livegang und Optimierung.","Implementierung","Prozess"],["Das KI-Gehirn: Wissen, Regeln und menschliche Übergabe","Wie Skripte, Kontext, Ausnahmen und Tonalität einen verlässlichen KI-Kollegen bilden.","KI-Gehirn","Autopilots Methode"],["Unsere Produkte für eine durchgängige Kundenreise","So arbeiten Postfach, Nachverfolgung, Telefon, CRM und Leadmaschine zusammen oder einzeln.","Produkte","Übersicht"],["Vom Gespräch zur CRM-Aktion","Wert entsteht, wenn Termin, Aufgabe, Ticket, Status oder Übergabe verarbeitet werden.","CRM-Aktionen","Autopilots CRM"],["Eine eigene Kundenreise für jede Branche","Aufnahme, Dringlichkeit, Planung, Systeme und Ausnahmen werden je Branche eingerichtet.","Kundenreisen","21 Branchen"],["So bestimmen wir Integrationen","Wir prüfen Kanäle, Kalender, CRM, Formulare, APIs, Rechte und Übergabe vor dem Bau.","Integrationen","Architektur"],["Monitoring und Optimierung nach Livegang","Echte Gespräche zeigen, wo Antworten, Routen und Aktionen verbessert werden.","Optimierung","Nach Livegang"],["Die Menschen hinter Autopilots","Lernen Sie das Team für Strategie, Entwicklung, Operations und laufende Optimierung kennen.","Team","Über Autopilots"]],
 it:[["Come costruiamo un collaboratore AI pronto al lancio","Da onboarding e architettura a cervello AI, integrazioni, demo, lancio e ottimizzazione.","Implementazione","Processo"],["Il cervello AI: conoscenze, regole e passaggio umano","Come script, contesto, eccezioni e tono creano un collaboratore affidabile.","Cervello AI","Metodo Autopilots"],["I nostri prodotti per un customer journey continuo","Scopri come inbox, follow-up, receptionist, CRM e lead machine lavorano insieme o separati.","Prodotti","Panoramica"],["Dalla conversazione all'azione CRM","Il valore nasce quando appuntamento, attività, ticket, stato o passaggio vengono elaborati.","Azioni CRM","Autopilots CRM"],["Un customer journey per ogni settore","Raccolta, urgenza, agenda, sistemi ed eccezioni sono configurati per settore.","Customer journey","21 settori"],["Come definiamo le integrazioni","Verifichiamo canali, agenda, CRM, moduli, API, permessi e passaggio prima dello sviluppo.","Integrazioni","Architettura"],["Monitoraggio e ottimizzazione dopo il lancio","Le conversazioni reali mostrano dove migliorare risposte, percorsi e azioni.","Ottimizzazione","Dopo il lancio"],["Le persone dietro Autopilots","Conosci il team per strategia, sviluppo, operations e ottimizzazione continua.","Team","Chi siamo"]],
 fr:[["Comment nous construisons un collaborateur IA prêt à être lancé","De l'intégration et l'architecture au cerveau IA, connexions, démo, lancement et optimisation.","Implémentation","Processus"],["Le cerveau IA : connaissances, règles et transfert humain","Comment scripts, contexte, exceptions et ton créent un collaborateur fiable.","Cerveau IA","Méthode Autopilots"],["Nos produits pour un parcours client continu","Découvrez comment messagerie, suivi, standardiste, CRM et machine à leads fonctionnent ensemble ou séparément.","Produits","Vue d'ensemble"],["De la conversation à l'action CRM","La valeur apparaît lorsque rendez-vous, tâche, ticket, statut ou transfert sont traités.","Actions CRM","Autopilots CRM"],["Un parcours propre à chaque secteur","Collecte, urgence, planning, systèmes et exceptions sont configurés par secteur.","Parcours clients","21 secteurs"],["Comment nous définissons les connexions","Nous vérifions canaux, agenda, CRM, formulaires, API, droits et transfert avant la construction.","Connexions","Architecture"],["Suivi et optimisation après lancement","Les conversations réelles montrent où améliorer réponses, parcours et actions.","Optimisation","Après lancement"],["Les personnes derrière Autopilots","Rencontrez l'équipe chargée de la stratégie, du développement, des opérations et de l'optimisation.","Équipe","À propos"]]
}[locale];
const routeIds=[null,null,"page.products","product.autopilots-crm","page.niches",null,null,"page.crew"];
const solutions = solutionCopy(locale);
rows[2] = [solutions.title, solutions.intro, solutions.title, solutions.title];
const hashes=["","#processtappen","","","","#processtappen","#processtappen",""];
const items=rows.flatMap(([title,description,category,label],index)=>routeIds[index] ? [{title,description,category,label,href:`${localizedPath(routeIds[index],locale)}${hashes[index]}`,keywords:[category,label,title]}] : []);
---
<KnowledgeLibrary mode="autopilots" items={items} locale={locale} />
