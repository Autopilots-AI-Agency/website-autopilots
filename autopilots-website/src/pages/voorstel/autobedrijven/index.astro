---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { productBySlug } from "../../../data/products";
import { commerceByNiche } from "../../../data/commerce";
import { pricingRequest } from "../../../i18n/pricingRequest";
import { nicheBySlug } from "../../../data/niches";
import RoiCalculator from "../../../components/ecosystem/RoiCalculator.astro";
import type { SupportedLocale } from "../../../i18n/languages";
import { localizedPath } from "../../../i18n/routes";
import { localizedNiche } from "../../../i18n/catalog";
import { localizedProductData } from "../../../i18n/productPage";

interface Props { locale?: SupportedLocale }
const { locale="nl" }=Astro.props;

const commerce = commerceByNiche.autobedrijven;
const offers = Object.values(commerce.offers).filter(Boolean);
const niche = nicheBySlug.autobedrijven;
const nicheLocalized=localizedNiche(locale,"autobedrijven",niche.name);
const localizedOffers = offers.map(offer => ({ offer, product: localizedProductData(locale, productBySlug[offer.product]) }));
const text={
nl:{title:"Voorstel AI-producten voor autobedrijven",desc:"Bekijk bevestigde configuraties en prijzen voor AI Inboxmedewerker, AI Telefoniste en AI Leadopvolger voor autobedrijven.",crumb:"Voorstel",kick:"Bevestigd voorstel voor autobedrijven",h1:"Kies de AI-medewerker die past bij je",accent:"eerste proces.",lead:"Deze prijzen en betaalroutes zijn beschikbaar voor de drie bevestigde productconfiguraties. CRM en Leadsmachine AI vragen eerst een scopecheck.",view:"Bekijk voorstellen",talk:"Eerst overleggen",pk:"Product en prijs",ph:"Maandbedrag, implementatie en usage helder bij elkaar.",pp:"Alle bedragen zijn exclusief btw. Controleer scope en voorwaarden in de Stripe-betaalomgeving voordat je bevestigt.",month:"per maand",impl:"Implementatie",usage:"Usage en voorwaarden",cancel:"Maandelijks opzegbaar met een opzegtermijn van één maand. Definitieve product- en betaalvoorwaarden staan in de betaalomgeving.",custom:"Maatwerk nodig?",customH:"CRM of Leadsmachine AI op maat",customP:"Deze producten hangen af van je bestaande data, campagneomvang en benodigde koppelingen. Daarom bepalen we de definitieve inrichting en prijs na een korte scopecheck.",tags:["Migratie","Campagneomvang","Koppelingen"],request:"Vraag een passend voorstel aan",after:"Na je bestelling",afterH:"Dit gebeurt voordat de AI-medewerker live gaat.",steps:["Je ontvangt de bestelbevestiging","Je plant de implementatiecall","We leggen scope, toegang en fallback vast","De verwerkersovereenkomst wordt ondertekend","We bouwen, testen en plannen de livegang"],stepP:"Je krijgt voor iedere fase een duidelijke vervolgstap.",last:"Doorgaans binnen twee tot vier weken na de implementatiecall, afhankelijk van toegang, koppelingen en feedback.",legal:"Juridisch en privacy",legalH:"Betaling is niet hetzelfde als directe livegang.",legalP:"Voor livegang controleren we rechten, gegevensbronnen, menselijke fallback en de verwerkersovereenkomst.",contact:"Neem contact op"},
en:{title:"AI product proposal for car dealerships",desc:"View confirmed configurations and prices for AI Inbox Agent, AI Receptionist and AI Lead Follow-up for car dealerships.",crumb:"Proposal",kick:"Confirmed proposal for car dealerships",h1:"Choose the AI employee that fits your",accent:"first process.",lead:"These prices and payment routes are available for three confirmed product configurations. CRM and AI Lead Engine require a scope check first.",view:"View proposals",talk:"Discuss first",pk:"Product and price",ph:"Monthly fee, implementation and usage in one clear overview.",pp:"All amounts exclude VAT. Check scope and terms in the Stripe checkout before confirming.",month:"per month",impl:"Implementation",usage:"Usage and terms",cancel:"Cancellable monthly with one month's notice. Final product and payment terms are shown at checkout.",custom:"Need a custom setup?",customH:"Custom CRM or AI Lead Engine",customP:"These products depend on existing data, campaign size and required integrations. We determine the final setup and price after a short scope check.",tags:["Migration","Campaign size","Integrations"],request:"Request a tailored proposal",after:"After your order",afterH:"What happens before the AI employee goes live.",steps:["You receive the order confirmation","You schedule the implementation call","We define scope, access and fallback","The data processing agreement is signed","We build, test and schedule launch"],stepP:"You receive a clear next step for every phase.",last:"Usually within two to four weeks after the implementation call, depending on access, integrations and feedback.",legal:"Legal and privacy",legalH:"Payment does not mean immediate launch.",legalP:"Before launch we verify access rights, data sources, human fallback and the data processing agreement.",contact:"Contact us"},
es:{title:"Propuesta de productos de IA para concesionarios",desc:"Consulta configuraciones y precios confirmados para tres empleados de IA.",crumb:"Propuesta",kick:"Propuesta confirmada para concesionarios",h1:"Elige el empleado de IA adecuado para tu",accent:"primer proceso.",lead:"Estos precios y rutas de pago están disponibles para tres configuraciones confirmadas. El CRM y el motor de leads requieren una revisión de alcance.",view:"Ver propuestas",talk:"Consultar primero",pk:"Producto y precio",ph:"Cuota mensual, implementación y uso en un resumen claro.",pp:"Importes sin IVA. Comprueba el alcance y las condiciones en Stripe antes de confirmar.",month:"al mes",impl:"Implementación",usage:"Uso y condiciones",cancel:"Cancelación mensual con un mes de preaviso. Las condiciones definitivas aparecen en el pago.",custom:"¿Necesitas personalización?",customH:"CRM o motor de leads a medida",customP:"Dependen de datos existentes, volumen de campaña e integraciones. Definimos configuración y precio tras revisar el alcance.",tags:["Migración","Volumen de campaña","Integraciones"],request:"Solicitar una propuesta",after:"Después del pedido",afterH:"Qué ocurre antes de poner en marcha el empleado de IA.",steps:["Recibes la confirmación","Programas la llamada de implementación","Definimos alcance, acceso y transferencia","Se firma el acuerdo de tratamiento","Construimos, probamos y planificamos la puesta en marcha"],stepP:"Cada fase tiene un siguiente paso claro.",last:"Normalmente entre dos y cuatro semanas después de la llamada, según accesos, integraciones y comentarios.",legal:"Legal y privacidad",legalH:"El pago no implica una puesta en marcha inmediata.",legalP:"Antes de activar verificamos permisos, fuentes de datos, transferencia humana y el acuerdo de tratamiento.",contact:"Contactar"},
de:{title:"KI-Produktangebot für Autohäuser",desc:"Bestätigte Konfigurationen und Preise für drei KI-Mitarbeiter.",crumb:"Angebot",kick:"Bestätigtes Angebot für Autohäuser",h1:"Wählen Sie den KI-Mitarbeiter für Ihren",accent:"ersten Prozess.",lead:"Diese Preise und Zahlungswege gelten für drei bestätigte Konfigurationen. CRM und KI-Leadmaschine benötigen zuerst einen Scope-Check.",view:"Angebote ansehen",talk:"Zuerst besprechen",pk:"Produkt und Preis",ph:"Monatspreis, Implementierung und Nutzung übersichtlich zusammen.",pp:"Alle Beträge zzgl. MwSt. Prüfen Sie Umfang und Bedingungen vor der Bestätigung in Stripe.",month:"pro Monat",impl:"Implementierung",usage:"Nutzung und Bedingungen",cancel:"Monatlich mit einem Monat Frist kündbar. Endgültige Bedingungen stehen im Checkout.",custom:"Individuelle Lösung nötig?",customH:"CRM oder KI-Leadmaschine nach Maß",customP:"Diese Produkte hängen von Daten, Kampagnenumfang und Integrationen ab. Einrichtung und Preis folgen nach einem kurzen Scope-Check.",tags:["Migration","Kampagnenumfang","Integrationen"],request:"Passendes Angebot anfordern",after:"Nach Ihrer Bestellung",afterH:"Das geschieht vor dem Livegang.",steps:["Sie erhalten die Bestätigung","Sie planen den Implementierungstermin","Wir definieren Scope, Zugang und Übergabe","Der Auftragsverarbeitungsvertrag wird unterzeichnet","Wir bauen, testen und planen den Livegang"],stepP:"Jede Phase hat einen klaren nächsten Schritt.",last:"Meist zwei bis vier Wochen nach dem Termin, abhängig von Zugängen, Integrationen und Feedback.",legal:"Recht und Datenschutz",legalH:"Zahlung bedeutet nicht sofortigen Livegang.",legalP:"Vor dem Livegang prüfen wir Rechte, Datenquellen, menschliche Übergabe und Auftragsverarbeitung.",contact:"Kontakt aufnehmen"},
it:{title:"Proposta di prodotti AI per concessionarie",desc:"Consulta configurazioni e prezzi confermati per tre collaboratori AI.",crumb:"Proposta",kick:"Proposta confermata per concessionarie",h1:"Scegli il collaboratore AI adatto al tuo",accent:"primo processo.",lead:"Prezzi e pagamenti sono disponibili per tre configurazioni confermate. CRM e macchina lead richiedono prima una verifica dell'ambito.",view:"Vedi le proposte",talk:"Parliamone prima",pk:"Prodotto e prezzo",ph:"Canone, implementazione e utilizzo in un quadro chiaro.",pp:"Importi IVA esclusa. Verifica ambito e condizioni nel checkout Stripe.",month:"al mese",impl:"Implementazione",usage:"Utilizzo e condizioni",cancel:"Recesso mensile con un mese di preavviso. Le condizioni definitive sono nel checkout.",custom:"Serve una soluzione su misura?",customH:"CRM o macchina lead su misura",customP:"Dipendono da dati esistenti, volume campagne e integrazioni. Definiamo configurazione e prezzo dopo una breve verifica.",tags:["Migrazione","Volume campagne","Integrazioni"],request:"Richiedi una proposta",after:"Dopo l'ordine",afterH:"Cosa accade prima del go live.",steps:["Ricevi la conferma","Pianifichi la call di implementazione","Definiamo ambito, accesso e passaggio","Si firma l'accordo sul trattamento dati","Costruiamo, testiamo e pianifichiamo il go live"],stepP:"Ogni fase ha un passo successivo chiaro.",last:"In genere da due a quattro settimane dopo la call, secondo accessi, integrazioni e feedback.",legal:"Aspetti legali e privacy",legalH:"Il pagamento non equivale al go live immediato.",legalP:"Prima del go live verifichiamo diritti, fonti dati, passaggio umano e accordo sul trattamento.",contact:"Contattaci"},
fr:{title:"Proposition de produits IA pour concessions",desc:"Consultez les configurations et tarifs confirmés pour trois collaborateurs IA.",crumb:"Proposition",kick:"Proposition confirmée pour concessions",h1:"Choisissez le collaborateur IA adapté à votre",accent:"premier processus.",lead:"Ces tarifs et paiements concernent trois configurations confirmées. Le CRM et la machine à prospects nécessitent d'abord une vérification du périmètre.",view:"Voir les propositions",talk:"Échanger d'abord",pk:"Produit et tarif",ph:"Mensualité, implémentation et usage réunis clairement.",pp:"Montants hors TVA. Vérifiez le périmètre et les conditions dans Stripe avant confirmation.",month:"par mois",impl:"Implémentation",usage:"Usage et conditions",cancel:"Résiliable chaque mois avec un mois de préavis. Les conditions définitives figurent au paiement.",custom:"Besoin de sur-mesure ?",customH:"CRM ou machine à prospects sur mesure",customP:"Ces produits dépendent des données, du volume de campagne et des intégrations. Nous définissons configuration et prix après une vérification.",tags:["Migration","Volume de campagne","Intégrations"],request:"Demander une proposition",after:"Après votre commande",afterH:"Ce qui se passe avant la mise en ligne.",steps:["Vous recevez la confirmation","Vous planifiez l'appel d'implémentation","Nous définissons périmètre, accès et relais","L'accord de traitement est signé","Nous construisons, testons et planifions la mise en ligne"],stepP:"Chaque phase comporte une prochaine étape claire.",last:"Généralement deux à quatre semaines après l'appel, selon les accès, intégrations et retours.",legal:"Juridique et confidentialité",legalH:"Le paiement ne signifie pas une mise en ligne immédiate.",legalP:"Avant la mise en ligne, nous vérifions les droits, sources de données, relais humain et accord de traitement.",contact:"Nous contacter"}}[locale];
const quote = pricingRequest[locale];
Object.assign(text, {desc:quote.lead, kick:quote.request, lead:quote.lead, ph:quote.lead, pp:quote.terms, cancel:quote.terms});
const clientData = JSON.stringify(offers.map((offer) => offer.product)).replaceAll("<", "\\u003c");
---

<BaseLayout title={`${text.title} | Autopilots`} description={text.desc} canonical={localizedPath("landing.autobedrijven-voorstel",locale)} locale={locale} contentId="landing.autobedrijven-voorstel" noindex={true}>
  <article class="ap-ecosystem ap-proposal-page" data-proposal-root>
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><div class="ap-container"><a href={`/${locale}/`}>Home</a><span aria-hidden="true">/</span><a href={localizedPath("niche.autobedrijven",locale)}>{nicheLocalized.name}</a><span aria-hidden="true">/</span><span aria-current="page">{text.crumb}</span></div></nav>
    <section class="ap-eco-hero">
      <div class="ap-container ap-eco-copy">
        <div class="ap-kicker">{text.kick}</div><h1>{text.h1} <span class="ap-title-accent">{text.accent}</span></h1><p class="ap-lead">{text.lead}</p>
        <div class="ap-actions"><a class="ap-button ap-button-primary" href="#voorstellen">{text.view}</a><a class="ap-button ap-button-secondary" href={localizedPath("page.appointment",locale)}>{text.talk}</a></div>
      </div>
    </section>

    <RoiCalculator niche={niche} locale={locale} />

    <section class="ap-section ap-soft-section" id="voorstellen">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">{text.pk}</div><h2>{text.ph}</h2><p>{text.pp}</p></div>
        <div class="ap-proposal-grid">
          {localizedOffers.map(({offer,product:localizedProduct}) => {
            return <article class="ap-proposal-card" data-proposal-card={offer.product}>
              <div class="ap-kicker">{localizedProduct.eyebrow}</div><h2>{localizedProduct.name}</h2><p>{localizedProduct.promise}</p>
              <div class="ap-proposal-price"><span>{quote.setup}: <b>{quote.request}</b><br />{quote.monthly}: <b>{quote.request}</b></span></div>
              <ul>{localizedProduct.core.slice(0, 4).map((item) => <li>{item.title}</li>)}</ul>
              <details><summary>{text.usage}<span aria-hidden="true">+</span></summary><p>{quote.terms}</p></details>
              <div class="ap-stripe-shell">
                <a class="ap-button ap-button-primary" href="/ontwerpen/intake/">{quote.cta}</a>
              </div>
            </article>;
          })}
          <article class="ap-proposal-card ap-proposal-fallback">
            <div class="ap-kicker">{text.custom}</div><h2>{text.customH}</h2><p>{text.customP}</p><div class="ap-custom-scope">{text.tags.map(tag=><span>{tag}</span>)}</div><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{text.request}</a>
          </article>
        </div>
      </div>
    </section>

    <section class="ap-section">
      <div class="ap-container ap-two-column">
        <div><div class="ap-section-head"><div class="ap-kicker">{text.after}</div><h2>{text.afterH}</h2></div><ol class="ap-workflow-list">{text.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{step}</h3><p>{index === 4 ? text.last : text.stepP}</p></div></li>)}</ol></div>
        <aside class="ap-integration-card"><div class="ap-kicker">{text.legal}</div><h3>{text.legalH}</h3><p>{text.legalP} <a href={localizedPath("page.privacy",locale)}>Privacy</a> · <a href={localizedPath("page.terms",locale)}>Terms</a>.</p><a class="ap-button ap-button-secondary" href={localizedPath("page.contact",locale)}>{text.contact}</a></aside>
      </div>
    </section>
  </article>
  <script id="ap-proposal-data" type="application/json" set:html={clientData}></script>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-proposal-root]");
    const node = document.getElementById("ap-proposal-data");
    if (!root || !node) return;
    const valid = new Set(JSON.parse(node.textContent || "[]"));
    const requested = new URLSearchParams(location.search).get("product");
    if (!valid.has(requested)) return;
    const card = root.querySelector(`[data-proposal-card="${CSS.escape(requested)}"]`);
    if (!card) return;
    card.classList.add("is-selected");
    requestAnimationFrame(() => card.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" }));
  })();
</script>

<style>
  .ap-proposal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}.ap-proposal-card{display:flex;min-width:0;flex-direction:column;border:1px solid var(--ap-line);border-radius:30px;background:#fff;padding:27px;box-shadow:0 16px 45px rgba(17,17,17,.045)}.ap-proposal-card.is-selected{border-color:var(--ap-brown);box-shadow:0 0 0 4px rgba(159,56,38,.12),0 18px 55px rgba(17,17,17,.08)}.ap-proposal-card h2{margin:0;font-size:29px;line-height:1.08}.ap-proposal-card>p{margin:12px 0 0;color:var(--ap-muted);font-size:14px;line-height:1.55}.ap-proposal-price{display:flex;align-items:flex-end;gap:15px;margin-top:25px;border-radius:22px;background:#f5f5f2;padding:18px}.ap-proposal-price strong{font-family:"Syne",sans-serif;font-size:42px;line-height:1}.ap-proposal-price span{color:var(--ap-muted);font-size:12px;line-height:1.5;font-weight:750}.ap-proposal-card ul{display:grid;gap:9px;margin:24px 0;padding:0;list-style:none}.ap-proposal-card li{font-size:13px;font-weight:750}.ap-proposal-card li:before{content:"✓";margin-right:9px;color:var(--ap-brown);font-weight:900}.ap-proposal-card details{margin-top:auto;border:1px solid var(--ap-line);border-radius:18px;overflow:hidden}.ap-proposal-card summary{display:flex;justify-content:space-between;gap:12px;padding:15px;cursor:pointer;font-size:13px;font-weight:900;list-style:none}.ap-proposal-card details p{margin:0;padding:0 15px 15px;color:var(--ap-muted);font-size:12px;line-height:1.55}.ap-stripe-shell{min-height:84px;margin-top:16px;border:1px solid var(--ap-line);border-radius:20px;background:#fafaf8;padding:12px}.ap-stripe-shell stripe-buy-button{display:block;max-width:100%}.ap-proposal-fallback{position:relative;overflow:hidden;align-self:start;justify-content:flex-start;border-color:rgba(231,162,149,.24);background:radial-gradient(circle at 100% 0,rgba(159,56,38,.3),transparent 34%),#111;color:#fff;padding:32px}.ap-proposal-fallback:after{content:"";position:absolute;right:-56px;bottom:-70px;width:170px;height:170px;border:1px solid rgba(231,162,149,.18);border-radius:50%}.ap-proposal-fallback>*{position:relative;z-index:1}.ap-proposal-fallback h2{max-width:520px;margin-top:18px}.ap-proposal-fallback>p{max-width:560px;margin-top:16px;color:rgba(255,255,255,.66)}.ap-custom-scope{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.ap-custom-scope span{border:1px solid rgba(255,255,255,.14);border-radius:999px;background:rgba(255,255,255,.07);padding:8px 11px;color:rgba(255,255,255,.78);font-size:10px;font-weight:800}.ap-proposal-fallback .ap-button{align-self:flex-start;margin-top:26px}.ap-integration-card a{color:var(--ap-brown);font-weight:850}.ap-integration-card .ap-button{margin-top:22px;color:#111}@media(max-width:760px){.ap-proposal-grid{grid-template-columns:1fr}.ap-proposal-card{border-radius:25px;padding:22px}.ap-proposal-price strong{font-size:36px}.ap-proposal-fallback{padding:25px}}
  .ap-proposal-card.is-selected{order:-1}
</style>
