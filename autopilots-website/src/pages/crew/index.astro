---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const crew = [
  ["Tim Kuiper","Sales & Partnerships","/team/tim-kuiper.png"],
  ["Larissa Rosanna Pen","Head of Operations","/team/larissa-rosanna-pen.webp"],
  ["Hasan Shabbir","Head of Development","/team/hasan-shabbir.png"],
  ["Albert Verlinden","AI Consultant","/team/albert-verlinden.png"],
  ["Pratt Olan","AI Specialist","/team/pratt-olan.webp"],
  ["Luca van der Meer","Online Marketeer","/team/luca-van-der-meer.webp"],
  ["Mit Dong","AI Specialist","/team/mit-dong.webp"],
  ["Rohail Zuberi","AI Specialist","/team/rohail-zuberi.webp"]
];
const copy = {
  nl:{description:"Maak kennis met de Autopilots crew achter AI medewerkers, CRM-koppelingen, workflows en optimalisatie.",kicker:"Crew",title:"Autopilots maakt AI begrijpelijk, menselijk en",accent:"bruikbaar in de praktijk.",lead:"We maken AI behapbaar voor bedrijven die klantcontact slimmer willen organiseren, zonder het menselijke uit het proces te halen.",whyLabel:"Waarom Autopilots",method:"Autopilots werkwijze",human:"Mens + AI",whyTitle:"AI wordt pas waardevol als je team ermee kan werken.",whyText:"Autopilots vertaalt AI naar concrete processen: klantvragen, opvolging, planning, CRM en service. Praktisch, menselijk en passend bij het bedrijf.",values:[["AI behapbaar maken","Heldere taal, duidelijke keuzes en een route die het team begrijpt."],["Vrijheid voor bedrijven","Minder herhaalwerk, snellere opvolging en meer ruimte voor menselijk contact."],["Een toekomstbestendige operatie","Elk contactmoment bouwt aan betere data, processen en klantrelaties."]],stages:["Begrijpen","Bouwen","Meegroeien"],connection:"Oprechte verbinding",connectionTitle:"We bouwen met bedrijven die vooruit willen.",connectionText:"Onze beste samenwerkingen ontstaan met teams die willen verbeteren en verantwoordelijkheid nemen. Geen losse AI-truc, maar techniek, mensen en operatie die samen volwassen worden.",principles:["Groeiambitie","Blijven leren","Lange termijn"],meet:"Meet the crew",built:"Built by the",team:"Autopilots team.",teamText:"Een compact team voor strategie, bouw, operations en optimalisatie. Autopilots blijft betrokken na livegang, zodat de AI beter wordt op basis van echte gesprekken.",previous:"Vorige",next:"Volgende",stand:"Waar we voor staan",bandTitle:"Vrijheid, groei en oprechte samenwerking.",bandText:"Autopilots bouwt AI die menselijk voelt en praktisch werkt. Vanuit vertrouwen, heldere communicatie en een samenwerking die blijft meegroeien."},
  en:{description:"Meet the Autopilots team behind AI employees, CRM integrations, workflows and optimisation.",kicker:"Team",title:"Autopilots makes AI understandable, human and",accent:"useful in day-to-day operations.",lead:"We make AI manageable for companies that want smarter customer contact without removing people from the process.",whyLabel:"Why Autopilots",method:"The Autopilots approach",human:"People + AI",whyTitle:"AI only becomes valuable when your team can work with it.",whyText:"Autopilots translates AI into concrete processes for customer questions, follow-up, planning, CRM and service. Practical, human and suited to the company.",values:[["Make AI manageable","Clear language, deliberate choices and a route the team understands."],["Freedom for companies","Less repetitive work, faster follow-up and more room for human contact."],["A future-ready operation","Every interaction improves data, processes and customer relationships."]],stages:["Understand","Build","Grow"],connection:"Genuine connection",connectionTitle:"We build with companies that want to move forward.",connectionText:"Our best partnerships are with teams that want to improve and take responsibility. Not a standalone AI trick, but technology, people and operations that mature together.",principles:["Ambition to grow","Keep learning","Long-term thinking"],meet:"Meet the team",built:"Built by the",team:"Autopilots team.",teamText:"A compact team for strategy, development, operations and optimisation. Autopilots stays involved after launch so the AI improves through real conversations.",previous:"Previous",next:"Next",stand:"What we stand for",bandTitle:"Freedom, growth and genuine partnership.",bandText:"Autopilots builds AI that feels human and works in practice—based on trust, clear communication and a partnership that keeps growing."},
  de:{description:"Lernen Sie das Autopilots Team hinter KI-Mitarbeitern, CRM-Integrationen, Workflows und Optimierung kennen.",kicker:"Team",title:"Autopilots macht KI verständlich, menschlich und",accent:"im Alltag nutzbar.",lead:"Wir machen KI für Unternehmen greifbar, die ihren Kundenkontakt intelligenter organisieren möchten, ohne den Menschen aus dem Prozess zu nehmen.",whyLabel:"Warum Autopilots",method:"Die Autopilots Arbeitsweise",human:"Mensch + KI",whyTitle:"KI wird erst wertvoll, wenn Ihr Team damit arbeiten kann.",whyText:"Autopilots übersetzt KI in konkrete Prozesse für Kundenfragen, Nachverfolgung, Planung, CRM und Service. Praktisch, menschlich und passend zum Unternehmen.",values:[["KI greifbar machen","Klare Sprache, bewusste Entscheidungen und ein Weg, den das Team versteht."],["Freiraum für Unternehmen","Weniger Wiederholungsarbeit, schnellere Nachverfolgung und mehr Raum für persönlichen Kontakt."],["Ein zukunftsfähiger Betrieb","Jeder Kontakt verbessert Daten, Prozesse und Kundenbeziehungen."]],stages:["Verstehen","Bauen","Mitwachsen"],connection:"Echte Verbindung",connectionTitle:"Wir bauen mit Unternehmen, die vorankommen wollen.",connectionText:"Unsere besten Partnerschaften entstehen mit Teams, die sich verbessern und Verantwortung übernehmen möchten. Kein isolierter KI-Trick, sondern Technik, Menschen und Betrieb, die gemeinsam reifen.",principles:["Wachstumsambition","Weiterlernen","Langfristigkeit"],meet:"Das Team",built:"Entwickelt vom",team:"Autopilots Team.",teamText:"Ein kompaktes Team für Strategie, Entwicklung, Operations und Optimierung. Autopilots bleibt nach dem Livegang beteiligt, damit die KI aus echten Gesprächen lernt.",previous:"Zurück",next:"Weiter",stand:"Wofür wir stehen",bandTitle:"Freiheit, Wachstum und echte Zusammenarbeit.",bandText:"Autopilots entwickelt KI, die menschlich wirkt und praktisch arbeitet – mit Vertrauen, klarer Kommunikation und einer Partnerschaft, die mitwächst."},
  es:{description:"Conoce al equipo de Autopilots detrás de empleados de IA, integraciones CRM, flujos y optimización.",kicker:"Equipo",title:"Autopilots hace que la IA sea comprensible, humana y",accent:"útil en la práctica.",lead:"Hacemos que la IA sea manejable para empresas que quieren organizar mejor la atención al cliente sin eliminar a las personas del proceso.",whyLabel:"Por qué Autopilots",method:"El método Autopilots",human:"Personas + IA",whyTitle:"La IA solo aporta valor cuando tu equipo puede trabajar con ella.",whyText:"Autopilots traduce la IA en procesos concretos para consultas, seguimiento, planificación, CRM y servicio. Práctico, humano y adaptado a la empresa.",values:[["Hacer manejable la IA","Lenguaje claro, decisiones conscientes y una ruta que el equipo entiende."],["Libertad para las empresas","Menos trabajo repetitivo, seguimiento más rápido y más espacio para el contacto humano."],["Una operación preparada para el futuro","Cada interacción mejora los datos, procesos y relaciones con clientes."]],stages:["Comprender","Construir","Crecer"],connection:"Conexión auténtica",connectionTitle:"Construimos con empresas que quieren avanzar.",connectionText:"Nuestras mejores colaboraciones nacen con equipos que quieren mejorar y asumir responsabilidad. No es un truco aislado de IA, sino tecnología, personas y operaciones que maduran juntas.",principles:["Ambición de crecer","Seguir aprendiendo","Largo plazo"],meet:"Conoce al equipo",built:"Creado por el",team:"equipo Autopilots.",teamText:"Un equipo compacto para estrategia, desarrollo, operaciones y optimización. Autopilots sigue involucrado después del lanzamiento para mejorar la IA con conversaciones reales.",previous:"Anterior",next:"Siguiente",stand:"Lo que defendemos",bandTitle:"Libertad, crecimiento y colaboración auténtica.",bandText:"Autopilots crea IA que se siente humana y funciona en la práctica, basada en confianza, comunicación clara y una colaboración que sigue creciendo."},
  it:{description:"Conosci il team Autopilots che sviluppa collaboratori AI, integrazioni CRM, workflow e ottimizzazione.",kicker:"Team",title:"Autopilots rende l'AI comprensibile, umana e",accent:"utile nella pratica.",lead:"Rendiamo l'AI gestibile per le aziende che vogliono organizzare meglio il contatto clienti senza eliminare le persone dal processo.",whyLabel:"Perché Autopilots",method:"Il metodo Autopilots",human:"Persone + AI",whyTitle:"L'AI crea valore solo quando il tuo team può usarla.",whyText:"Autopilots traduce l'AI in processi concreti per domande, follow-up, pianificazione, CRM e servizio. Pratico, umano e adatto all'azienda.",values:[["Rendere l'AI gestibile","Linguaggio chiaro, scelte consapevoli e un percorso che il team comprende."],["Libertà per le aziende","Meno lavoro ripetitivo, follow-up più rapido e più spazio per il contatto umano."],["Un'operazione pronta per il futuro","Ogni interazione migliora dati, processi e relazioni con i clienti."]],stages:["Comprendere","Costruire","Crescere"],connection:"Connessione autentica",connectionTitle:"Costruiamo con aziende che vogliono andare avanti.",connectionText:"Le collaborazioni migliori nascono con team che vogliono migliorare e assumersi responsabilità. Non un trucco AI isolato, ma tecnologia, persone e operazioni che maturano insieme.",principles:["Ambizione di crescita","Continuare a imparare","Lungo termine"],meet:"Conosci il team",built:"Creato dal",team:"team Autopilots.",teamText:"Un team compatto per strategia, sviluppo, operations e ottimizzazione. Autopilots resta coinvolto dopo il lancio, così l'AI migliora grazie alle conversazioni reali.",previous:"Precedente",next:"Successivo",stand:"Ciò in cui crediamo",bandTitle:"Libertà, crescita e collaborazione autentica.",bandText:"Autopilots crea AI che sembra umana e funziona nella pratica, basata su fiducia, comunicazione chiara e una collaborazione che continua a crescere."},
  fr:{description:"Découvrez l'équipe Autopilots derrière les collaborateurs IA, les connexions CRM, les workflows et l'optimisation.",kicker:"Équipe",title:"Autopilots rend l'IA compréhensible, humaine et",accent:"utile au quotidien.",lead:"Nous rendons l'IA accessible aux entreprises qui souhaitent mieux organiser leur relation client sans retirer l'humain du processus.",whyLabel:"Pourquoi Autopilots",method:"La méthode Autopilots",human:"Humain + IA",whyTitle:"L'IA ne crée de valeur que lorsque votre équipe peut l'utiliser.",whyText:"Autopilots traduit l'IA en processus concrets pour les demandes, le suivi, la planification, le CRM et le service. Une approche pratique, humaine et adaptée à l'entreprise.",values:[["Rendre l'IA accessible","Un langage clair, des choix réfléchis et un parcours compris par l'équipe."],["Libérer les entreprises","Moins de travail répétitif, un suivi plus rapide et davantage de place pour l'humain."],["Des opérations prêtes pour demain","Chaque échange améliore les données, les processus et la relation client."]],stages:["Comprendre","Construire","Évoluer"],connection:"Une relation authentique",connectionTitle:"Nous construisons avec les entreprises qui veulent avancer.",connectionText:"Nos meilleures collaborations naissent avec des équipes qui souhaitent progresser et prendre leurs responsabilités. Pas une astuce IA isolée, mais une technologie, des personnes et des opérations qui mûrissent ensemble.",principles:["Ambition de croissance","Continuer d'apprendre","Vision à long terme"],meet:"Découvrez l'équipe",built:"Conçu par",team:"l'équipe Autopilots.",teamText:"Une équipe compacte pour la stratégie, le développement, les opérations et l'optimisation. Autopilots reste impliqué après le lancement afin que l'IA progresse grâce aux échanges réels.",previous:"Précédent",next:"Suivant",stand:"Nos convictions",bandTitle:"Liberté, croissance et collaboration authentique.",bandText:"Autopilots conçoit une IA humaine et réellement utile, fondée sur la confiance, une communication claire et une collaboration qui continue d'évoluer."}
}[locale];
---
<BaseLayout title={`${copy.kicker} | Autopilots`} description={copy.description} canonical={localizedPath("page.crew",locale)} locale={locale} contentId="page.crew">
  <main id="ap-crew" class="ap-crew-page"><section class="ap-section"><div class="ap-container">
    <div class="ap-kicker">{copy.kicker}</div><h1 class="ap-page-title">{copy.title} <span class="ap-accent">{copy.accent}</span></h1>
    <p class="ap-lead">{copy.lead}</p>

    <section class="ap-crew-intro" aria-label={copy.whyLabel}>
      <div class="ap-crew-console">
        <header class="ap-crew-console-head"><div><i></i><span>{copy.method}</span></div><strong>{copy.human}</strong></header>
        <div class="ap-crew-console-body">
          <article class="ap-crew-story"><div class="ap-kicker">{copy.whyLabel}</div><h2>{copy.whyTitle}</h2><p>{copy.whyText}</p></article>
          <ol class="ap-crew-values">{copy.values.map((item,index)=><li><span>{String(index+1).padStart(2,"0")}</span><div><h3>{item[0]}</h3><p>{item[1]}</p></div></li>)}</ol>
        </div>
        <footer class="ap-crew-console-foot"><span>{copy.stages[0]}</span><i></i><span>{copy.stages[1]}</span><i></i><strong>{copy.stages[2]}</strong></footer>
      </div>
    </section>

    <section class="ap-crew-connection"><div class="ap-crew-connection-copy"><div class="ap-kicker">{copy.connection}</div><h2>{copy.connectionTitle}</h2><p>{copy.connectionText}</p></div><ol class="ap-crew-principles">{copy.principles.map((item,index)=><li><span>{String(index+1).padStart(2,"0")}</span><strong>{item}</strong></li>)}</ol></section>

    <section class="ap-section ap-team-inline"><div class="ap-section-head"><div class="ap-kicker">{copy.meet}</div><h2 class="ap-section-title">{copy.built} <span class="ap-accent">{copy.team}</span></h2><p class="ap-lead">{copy.teamText}</p></div><div class="ap-team-shell"><div class="ap-team-slider" data-crew-slider>{crew.map(member=><article><img src={member[2]} alt={member[0]} loading="lazy" /><strong>{member[0]}</strong><span>{member[1]}</span></article>)}</div><div class="ap-team-controls"><span>Autopilots</span><div><button type="button" data-crew-prev aria-label={copy.previous}>←</button><button type="button" data-crew-next aria-label={copy.next}>→</button></div></div></div></section>
    <div class="ap-crew-band"><div class="ap-kicker">{copy.stand}</div><h2>{copy.bandTitle}</h2><p>{copy.bandText}</p></div>
  </div></section></main>
</BaseLayout>

<script is:inline>(()=>{const slider=document.querySelector('[data-crew-slider]');if(!slider)return;const move=direction=>slider.scrollBy({left:direction*(slider.clientWidth*.72),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});document.querySelector('[data-crew-prev]')?.addEventListener('click',()=>move(-1));document.querySelector('[data-crew-next]')?.addEventListener('click',()=>move(1))})();</script>

<style>
  .ap-crew-page .ap-lead{max-width:900px}.ap-crew-intro{margin-top:56px}.ap-crew-console{overflow:hidden;border:1px solid rgba(255,255,255,.08);border-radius:34px;background:radial-gradient(circle at 92% 8%,rgba(159,56,38,.22),transparent 27%),linear-gradient(145deg,#111 0%,#111 72%,#18110f 100%);color:#fff;box-shadow:0 24px 70px rgba(17,17,17,.14)}.ap-crew-console-head{display:flex;min-height:62px;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.09);padding:0 34px;color:rgba(255,255,255,.66);font-family:"Syne",sans-serif;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase}.ap-crew-console-head div{display:flex;align-items:center;gap:11px}.ap-crew-console-head i{width:7px;height:7px;border-radius:50%;background:#9f3826;box-shadow:0 0 0 6px rgba(159,56,38,.13)}.ap-crew-console-head strong{color:#fff;font:inherit}.ap-crew-console-body{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(340px,.92fr)}.ap-crew-story{display:flex;min-height:440px;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.09);padding:46px 48px}.ap-crew-story .ap-kicker{margin-bottom:20px;color:#e4a092}.ap-crew-story h2,.ap-crew-connection h2{font-size:clamp(30px,3.7vw,48px);line-height:1.08}.ap-crew-story p{max-width:590px;margin-top:22px;color:rgba(255,255,255,.68);font-size:16px;line-height:1.7}.ap-crew-values{display:flex;margin:0;padding:25px 34px;flex-direction:column;justify-content:center;list-style:none}.ap-crew-values li{display:grid;grid-template-columns:42px minmax(0,1fr);gap:18px;align-items:start;padding:26px 0;border-bottom:1px solid rgba(255,255,255,.09)}.ap-crew-values li:last-child{border-bottom:0}.ap-crew-values>li>span,.ap-crew-connection-cards span{display:grid;width:42px;height:42px;place-items:center;border-radius:14px;background:rgba(255,255,255,.08);color:#e4a092;font-family:"Syne",sans-serif;font-size:11px;font-weight:700}.ap-crew-values h3{margin:1px 0 0;color:#fff;font-size:20px;line-height:1.25}.ap-crew-values p,.ap-crew-connection-cards p{margin:8px 0 0;color:rgba(255,255,255,.58);font-size:14px;line-height:1.55}.ap-crew-console-foot{display:grid;grid-template-columns:auto minmax(30px,1fr) auto minmax(30px,1fr) auto;gap:18px;align-items:center;border-top:1px solid rgba(255,255,255,.09);padding:19px 34px;color:rgba(255,255,255,.62);font-family:"Syne",sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase}.ap-crew-console-foot i{height:1px;background:linear-gradient(90deg,rgba(228,160,146,.18),rgba(228,160,146,.72),rgba(228,160,146,.18))}.ap-crew-console-foot strong{color:#e4a092}.ap-crew-connection{overflow:hidden;margin-top:28px;border:1px solid var(--ap-line);border-radius:34px;background:radial-gradient(circle at 92% 18%,rgba(159,56,38,.09),transparent 26%),#fff;padding:34px;box-shadow:0 16px 50px rgba(17,17,17,.055)}.ap-crew-connection-copy{max-width:880px}.ap-crew-connection-copy p{margin:18px 0 0;color:var(--ap-muted);font-size:17px;line-height:1.7}.ap-crew-connection-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:26px}.ap-crew-connection-cards article{border:1px solid var(--ap-line);border-radius:24px;background:var(--ap-soft-2);padding:20px}.ap-crew-connection-cards strong{display:block;margin-top:16px;font-size:19px}.ap-crew-connection-cards p{color:var(--ap-muted)}.ap-inspiration-marquee{margin-top:28px;overflow:hidden;border-radius:26px;background:#111;padding:20px 0;color:#fff}.ap-inspiration-marquee .ap-kicker{margin:0 24px 14px;color:#e4a092}.ap-inspiration-track{display:flex;width:max-content;gap:10px;animation:crewMarquee 96s linear infinite}.ap-inspiration-track span{border:1px solid rgba(255,255,255,.13);border-radius:999px;background:rgba(255,255,255,.075);padding:10px 14px;font-size:13px;font-weight:700}@keyframes crewMarquee{to{transform:translateX(-50%)}}.ap-team-inline{padding-bottom:28px}.ap-team-shell{overflow:hidden;margin-top:32px;border:1px solid var(--ap-line);border-radius:34px;background:#fff;box-shadow:0 16px 50px rgba(17,17,17,.06)}.ap-team-slider{display:flex;gap:0;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:8px}.ap-team-slider::-webkit-scrollbar{display:none}.ap-team-slider article{flex:0 0 33.333%;scroll-snap-align:start;padding:10px}.ap-team-slider img{display:block;width:100%;aspect-ratio:1/1;border-radius:999px;object-fit:cover;background:#111}.ap-team-slider strong{display:block;margin-top:16px;font-size:21px}.ap-team-slider span{display:block;margin-top:6px;color:var(--ap-muted);font-size:13px;font-weight:700}.ap-team-controls{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--ap-line);padding:16px 20px}.ap-team-controls>span{color:var(--ap-muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px}.ap-team-controls button{width:42px;height:42px;margin-left:6px;border:1px solid var(--ap-line);border-radius:50%;background:#fff;cursor:pointer}.ap-crew-band{border-radius:30px;background:linear-gradient(135deg,#111,#151312 68%,#24130f);color:#fff;padding:32px}.ap-crew-band .ap-kicker{color:#e4a092}.ap-crew-band h2{font-size:clamp(26px,3.1vw,40px)}.ap-crew-band p{max-width:660px;margin-top:14px;color:rgba(255,255,255,.68);line-height:1.58}@media(max-width:900px){.ap-crew-console-body{grid-template-columns:1fr}.ap-crew-story{min-height:0;border-right:0;border-bottom:1px solid rgba(255,255,255,.09)}.ap-crew-connection-cards{grid-template-columns:1fr}.ap-team-slider article{flex-basis:50%}}@media(max-width:560px){.ap-crew-intro{margin-top:42px}.ap-crew-console{border-radius:26px}.ap-crew-console-head{min-height:56px;padding:0 22px}.ap-crew-console-head strong{display:none}.ap-crew-story{padding:34px 22px}.ap-crew-values{padding:9px 22px}.ap-crew-values li{gap:14px;padding:22px 0}.ap-crew-console-foot{grid-template-columns:1fr;gap:11px;padding:20px 22px}.ap-crew-console-foot i{display:none}.ap-crew-console-foot span,.ap-crew-console-foot strong{position:relative;padding-left:20px}.ap-crew-console-foot span:before,.ap-crew-console-foot strong:before{position:absolute;left:0;content:"\2192";color:#e4a092}.ap-crew-connection{border-radius:24px;padding:22px}.ap-team-slider article{flex-basis:100%}.ap-team-shell{border-radius:26px}.ap-crew-band{padding:24px}}
  .ap-team-slider article{display:flex;flex-direction:column;align-items:center;text-align:center;padding:24px 10px}.ap-team-slider img{width:40%;max-width:150px;min-width:112px;margin:0 auto}.ap-team-slider strong{margin-top:18px}
  .ap-crew-connection{border:0;border-top:1px solid var(--ap-line);border-radius:0;background:transparent;box-shadow:none;padding:clamp(42px,6vw,72px) 0 0}
  .ap-crew-connection-copy{max-width:760px}
  .ap-crew-connection-copy p{font-size:16px}
  .ap-crew-principles{display:grid;grid-template-columns:repeat(3,1fr);margin:30px 0 0;padding:0;border-top:1px solid var(--ap-line);list-style:none}
  .ap-crew-principles li{display:flex;gap:14px;align-items:center;border-bottom:1px solid var(--ap-line);padding:18px 0}
  .ap-crew-principles li+li{padding-left:24px}
  .ap-crew-principles span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px;letter-spacing:1px}
  .ap-crew-principles strong{font-size:16px}
  @media(max-width:560px){.ap-team-slider img{width:40%;max-width:140px;min-width:108px}}
  @media(max-width:700px){.ap-crew-principles{grid-template-columns:1fr}.ap-crew-principles li+li{padding-left:0}}
</style>

<style is:inline>
  #ap-crew{color:#f5f1e8;background:radial-gradient(ellipse at 15% 20%,rgba(228,240,242,.055),transparent 45%),#101f26}
  #ap-crew .ap-container{max-width:1120px}
  #ap-crew .ap-container>.ap-kicker,#ap-crew .ap-page-title,#ap-crew .ap-container>.ap-lead{text-align:center;margin-left:auto;margin-right:auto}
  #ap-crew .ap-page-title{max-width:850px;font-size:clamp(34px,4.3vw,54px);line-height:1.12;letter-spacing:-.045em;text-wrap:balance}
  #ap-crew .ap-accent{color:#be8a5c;font-style:italic}
