---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { getPrivacySections, privacyPageCopy } from "../../i18n/legalPage";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const copy = privacyPageCopy[locale];
const sections = getPrivacySections(locale);
const subprocessors = {
 nl: "Bekijk de subverwerkerslijst",
 en: "View the subprocessor list (Dutch)",
 de: "Liste der Unterauftragsverarbeiter ansehen (Niederländisch)",
 fr: "Consulter les sous-traitants ultérieurs (néerlandais)",
 es: "Ver la lista de subencargados (neerlandés)",
 it: "Consulta i sub-responsabili (olandese)",
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} canonical={localizedPath("page.privacy",locale)} locale={locale} contentId="page.privacy">
  <article class="ap-ecosystem ap-legal-page">
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><div class="ap-container"><a href={localizedPath("page.home",locale)}>{copy.home}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.name}</span></div></nav>
    <section class="ap-eco-hero"><div class="ap-container ap-eco-copy"><div class="ap-kicker">{copy.updated}</div><h1>{copy.hero} <span class="ap-title-accent">{copy.accent}</span></h1><p class="ap-lead">{copy.lead}</p></div></section>
    <section class="ap-section ap-soft-section"><div class="ap-container ap-legal-layout"><aside class="ap-legal-nav"><strong>{copy.onPage}</strong>{sections.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</aside><div class="ap-legal-content">
      {sections.map(([id,label,title,text])=><section id={id}><div class="ap-kicker">{label}</div><h2>{title}</h2><p>{text.replace("info@auto-pilots.io","")} {text.includes("info@auto-pilots.io") && <a href="mailto:info@auto-pilots.io">info@auto-pilots.io</a>}</p>{id === "diensten" && <p><a href="/subprocessors/" hreflang="nl">{subprocessors}</a></p>}</section>)}
    </div></div></section>
  </article>
</BaseLayout>

<style>
  .ap-legal-layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:40px;align-items:start}.ap-legal-nav{position:sticky;top:96px;display:grid;gap:8px;border:1px solid var(--ap-line);border-radius:24px;background:#fff;padding:18px}.ap-legal-nav strong{margin-bottom:7px;font-size:14px}.ap-legal-nav a{color:var(--ap-muted);font-size:13px;font-weight:750}.ap-legal-nav a:hover{color:var(--ap-brown)}.ap-legal-content{display:grid;gap:14px}.ap-legal-content section{scroll-margin-top:96px;border:1px solid var(--ap-line);border-radius:28px;background:#fff;padding:30px}.ap-legal-content h2{margin:0;font-size:30px;line-height:1.1}.ap-legal-content p{margin-top:16px;color:var(--ap-muted);font-size:16px;line-height:1.7}.ap-legal-content p a{color:var(--ap-brown);font-weight:850}@media(max-width:760px){.ap-legal-layout{grid-template-columns:1fr}.ap-legal-nav{position:static}.ap-legal-content section{border-radius:24px;padding:22px}.ap-legal-content h2{font-size:26px}}
</style>
