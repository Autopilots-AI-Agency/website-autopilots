---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { solutionCopy, solutionItems } from '../../data/solutions';
import { intakePath } from '../../config/intake';
import { localizedPath } from '../../i18n/routes';
import type { SupportedLocale } from '../../i18n/languages';
interface Props { locale?: SupportedLocale }
const { locale = 'nl' } = Astro.props;
const c = solutionCopy(locale);
const items = solutionItems(locale);
---
<BaseLayout title={`${c.title} | Autopilots`} description={c.intro} canonical={localizedPath('page.products',locale)} locale={locale} contentId="page.products">
<article id="ap-solutions">
  <header class="intro"><p class="eyebrow">AUTOPILOTS / {c.title}</p><h1>{c.hero}<em>{c.accent}</em></h1><p>{c.intro}</p><a class="cta" href={intakePath(locale)}>{c.scan}</a></header>
  <nav class="pillars" aria-label={c.title}>{items.map((item,i) => <a href={`#${item.id}`}><span>0{i+1}</span><strong>{item.name}</strong><p>{item.features.join(' · ')}</p></a>)}</nav>
  {items.map((item,i) => <section id={item.id} class="solution"><div class="solution-copy"><p class="eyebrow">0{i+1} / AUTOPILOTS</p><h2>{item.name}</h2><p>{item.description}</p><a class="text-link" href={intakePath(locale)}>{c.scan}</a></div><div class="product-stage">
  <div class={`product-visual visual-${i}`} aria-hidden="true">
    <div class="window-top"><span class="window-dots"><i></i><i></i><i></i></span><span>AUTOPILOTS / 0{i+1}</span><span class="status-light"></span></div>
    {i === 0 && <div class="agent-preview"><div class="agent-orbit"><span>AI</span></div><div class="waveform">{Array.from({length:25},(_,n)=><i style={`--bar:${12 + Math.sin(n*1.7)**2*30}px;--delay:${n*45}ms`}></i>)}</div><div class="channel-list">{item.features.map((f)=><span>{f}</span>)}</div><div class="context-lines"><i></i><i></i><i></i></div></div>}
    {i === 1 && <div class="software-preview"><div class="app-sidebar"><b>A</b><i></i><i></i><i></i></div><div class="app-workspace"><div class="app-heading"><span></span><i></i></div><div class="mini-metrics"><i></i><i></i><i></i></div><div class="kanban">{[0,1,2].map(n=><div><span class="column-mark"></span>{Array.from({length:3-n},()=> <div class="task"><i></i><i></i><span></span></div>)}</div>)}</div></div></div>}
    {i === 2 && <div class="website-preview"><div class="site-nav"><b>STUDIO.</b><span></span></div><div class="site-hero"><div class="site-type"><i></i><i></i><span></span><span></span><b></b></div><div class="architecture"><div class="sun"></div><div class="house"><i></i><i></i><i></i></div><div class="ground"></div></div></div><div class="site-bottom"><i></i><i></i><i></i></div></div>}
  </div><div class="capabilities">{item.features.map((feature,j) => <div><span>0{j+1}</span><h3>{feature}</h3></div>)}
  {i < 2 && <a class="application" href={localizedPath(`product.${i === 0 ? 'ai-telefoniste' : 'autopilots-crm'}`,locale)}>{c.detail}: {i === 0 ? item.features[0] : 'CRM'}</a>}
  {i === 0 && <a class="application" href={localizedPath('product.ai-inboxmedewerker',locale)}>{c.detail}: {item.features.slice(1).join(' / ')}</a>}
  </div></div></section>)}
  <section class="closing"><p class="eyebrow">AUTOPILOTS</p><h2>{c.together}</h2><p>{c.explanation}</p><p class="cost">{c.cost}</p><a class="cta" href={intakePath(locale)}>{c.scan}</a></section>
</article>
</BaseLayout>
<style is:inline>
#ap-solutions{max-width:1120px;margin:auto;padding:0 24px 80px;color:#f6f1e9}
#ap-solutions .intro{text-align:center;padding:80px 0 56px;max-width:880px;margin:auto}
#ap-solutions .eyebrow{font-family:Syne,sans-serif;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#d4a17e;margin:0 0 22px}
#ap-solutions h1{font-size:clamp(34px,4.5vw,54px);line-height:1.1;letter-spacing:-.045em;margin:0 0 28px}
#ap-solutions h1 em{display:block;color:#bc895e}
#ap-solutions p{color:#aabcc2;font-size:18px;line-height:1.7}
#ap-solutions .cta{display:inline-flex;justify-content:center;align-items:center;margin-top:20px;padding:17px 26px;background:linear-gradient(110deg,#784a32,#a57046,#784a32);border:1px solid #c09574;border-radius:10px;font-weight:750;color:#fff8ef;text-decoration:none;text-align:center}
#ap-solutions .pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-bottom:64px}
#ap-solutions .pillars a{padding:28px;border:1px solid #34474e;border-radius:24px;background:#192d35;text-decoration:none;color:inherit;transition:transform .2s,border-color .2s}
#ap-solutions .pillars a:hover{transform:translateY(-4px);border-color:#c09574}
#ap-solutions .pillars span{display:block;color:#d4a17e;font-family:Syne,sans-serif;font-size:13px;margin-bottom:24px}
#ap-solutions .pillars strong{font-size:24px;letter-spacing:-.03em}
#ap-solutions .pillars p{font-size:14px;margin:12px 0 0}
#ap-solutions .solution{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding:64px 0;border-top:1px solid #34474e;scroll-margin-top:110px}
#ap-solutions h2{font-size:clamp(28px,3.5vw,42px);line-height:1.1;letter-spacing:-.04em;margin:0 0 24px}
#ap-solutions .text-link{display:inline-block;color:#dfb590;margin-top:16px;text-underline-offset:6px}
#ap-solutions .capabilities{padding:10px 28px;border:1px solid #34474e;border-radius:24px;background:linear-gradient(145deg,#213740,#152830)}
#ap-solutions .capabilities>div{display:flex;align-items:center;gap:22px;padding:20px 0;border-bottom:1px solid #34474e}
#ap-solutions .capabilities span{color:#d4a17e;font-family:Syne,sans-serif;font-size:12px}
#ap-solutions h3{font-size:18px;margin:0}
#ap-solutions .application{display:block;padding:16px 0;color:#b9c8cd;font-size:13px;text-underline-offset:4px}
#ap-solutions .closing{max-width:850px;margin:40px auto 0;text-align:center;padding:48px 32px;border:1px solid #34474e;border-radius:28px;background:radial-gradient(ellipse at top,rgba(255,255,255,.07),transparent 75%)}
#ap-solutions .cost{font-size:14px;max-width:620px;margin:24px auto 0}
#ap-solutions a:focus-visible{outline:2px solid #e0b995;outline-offset:5px}
@media(max-width:700px){#ap-solutions{padding:0 20px 50px}#ap-solutions .intro{padding:48px 0 36px}#ap-solutions .pillars{grid-template-columns:1fr;gap:12px;margin-bottom:40px}#ap-solutions .pillars a{padding:22px}#ap-solutions .pillars span{margin-bottom:12px}#ap-solutions .solution{grid-template-columns:1fr;gap:24px;padding:40px 0}#ap-solutions p{font-size:16px}#ap-solutions .closing{padding:32px 22px}#ap-solutions .cta{font-size:14px}}
@media(prefers-reduced-motion:reduce){#ap-solutions .pillars a{transition:none}}
</style>
<style is:inline>
#ap-solutions{position:relative;isolation:isolate;--line:rgba(174,197,203,.18);--bronze:#d5ae8d}
#ap-solutions:before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 65% 16% at 50% 10%,#ffffff08,transparent),radial-gradient(ellipse 65% 22% at 80% 52%,#ffffff06,transparent);pointer-events:none;z-index:-1}
#ap-solutions .intro{padding:88px 0 64px;max-width:800px}#ap-solutions .intro>p:not(.eyebrow){max-width:660px;margin:24px auto}#ap-solutions h1{font-size:clamp(34px,4.5vw,54px);line-height:1.13;text-wrap:balance}#ap-solutions h1 em{margin-top:6px}
#ap-solutions .pillars{gap:0;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:linear-gradient(135deg,#24384080,#14272e90);margin-bottom:28px}
#ap-solutions .pillars a{position:relative;border:0;border-radius:0;background:transparent;padding:26px 28px;transition:background .3s}#ap-solutions .pillars a+a{border-left:1px solid var(--line)}#ap-solutions .pillars a:hover{transform:none;background:#ffffff08}#ap-solutions .pillars span{margin:0 0 14px}#ap-solutions .pillars strong{font-size:22px}#ap-solutions .pillars p{font-size:12px;max-width:230px;line-height:1.8}
#ap-solutions .solution{gap:64px;padding:88px 0;border-top:0;position:relative}#ap-solutions .solution+.solution{border-top:1px solid var(--line)}#ap-solutions .solution-copy{max-width:440px}#ap-solutions .solution-copy h2{font-size:clamp(32px,4vw,46px);margin-bottom:22px}#ap-solutions .solution-copy>p:not(.eyebrow){font-size:17px;line-height:1.85}#ap-solutions .text-link{font-size:14px;font-weight:700;padding-bottom:7px;border-bottom:1px solid #d5ae8d60;text-decoration:none}
#ap-solutions .product-stage{min-width:0;border-radius:24px;border:1px solid var(--line);background:linear-gradient(145deg,#243a43,#15282f);box-shadow:0 24px 70px #00000026,inset 0 1px #ffffff0b;overflow:hidden;transition:transform .6s cubic-bezier(.2,.7,.3,1),box-shadow .6s}#ap-solutions .product-stage:hover{transform:translateY(-4px);box-shadow:0 30px 70px #00000036,inset 0 1px #ffffff12}
#ap-solutions .product-visual{margin:16px 16px 0;border-radius:14px;overflow:hidden;background:#10232b;border:1px solid var(--line)}#ap-solutions .window-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line);font-size:9px;letter-spacing:.13em;color:#adbec4}#ap-solutions .window-dots{display:flex;gap:4px}#ap-solutions .window-dots i{width:4px;height:4px;border-radius:50%;background:#71878e}#ap-solutions .status-light{height:5px;width:5px;background:#bacbb0;border-radius:50%}
#ap-solutions .agent-preview{padding:26px 24px;height:258px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;background:radial-gradient(ellipse at 50% 30%,#d5ae8d10,transparent 70%)}#ap-solutions .agent-orbit{border:1px solid #d5ae8d22;border-radius:50%;padding:10px;box-shadow:0 0 0 12px #d5ae8d04}#ap-solutions .agent-orbit>span{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#e0bb95,#8c5e3e);color:#10232b;font-weight:800;font-size:20px}#ap-solutions .waveform{display:flex;align-items:center;gap:4px;height:38px}#ap-solutions .waveform i{width:3px;height:var(--bar);background:#d5ae8d;border-radius:5px;animation:ap-wave 2.4s var(--delay) ease-in-out infinite}#ap-solutions .channel-list{display:flex;flex-wrap:wrap;justify-content:center;gap:7px}#ap-solutions .channel-list span{font-size:10px;color:#c9d4d6;border:1px solid var(--line);padding:5px 9px;border-radius:6px}#ap-solutions .context-lines{display:none}
#ap-solutions .software-preview{height:258px;display:flex}#ap-solutions .app-sidebar{width:48px;border-right:1px solid var(--line);padding:22px 14px;display:flex;align-items:center;gap:18px;flex-direction:column}#ap-solutions .app-sidebar b{font-size:20px;color:#d5ae8d}#ap-solutions .app-sidebar i{width:12px;height:12px;border:1px solid #637c85;border-radius:3px}#ap-solutions .app-workspace{padding:24px 18px;flex:1;min-width:0}#ap-solutions .app-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}#ap-solutions .app-heading span{width:45%;height:7px;background:#acbec3;border-radius:3px}#ap-solutions .app-heading i{width:18px;height:18px;border-radius:50%;background:#be8a5c60}#ap-solutions .mini-metrics{display:flex;gap:7px;margin-bottom:20px}#ap-solutions .mini-metrics i{height:32px;flex:1;border:1px solid var(--line);border-radius:5px;background:#ffffff04}#ap-solutions .kanban{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}#ap-solutions .column-mark{display:block;width:24px;height:3px;background:#69818a;margin-bottom:10px}#ap-solutions .task{padding:9px;background:#243b44;border:1px solid var(--line);border-radius:5px;margin-bottom:7px}#ap-solutions .task i{display:block;width:80%;height:3px;background:#7f959c;margin-bottom:5px}#ap-solutions .task i+i{width:50%;background:#526b75}#ap-solutions .kanban>div:nth-child(2) .task{border-color:#be8a5c80;background:#be8a5c16}
#ap-solutions .website-preview{height:258px;background:#e9e5da;padding:20px;color:#19302d}#ap-solutions .site-nav{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #20363022;padding-bottom:14px}#ap-solutions .site-nav b{font-size:12px;letter-spacing:.08em}#ap-solutions .site-nav span{width:16px;height:6px;border-block:1px solid #203630}#ap-solutions .site-hero{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:22px 0}#ap-solutions .site-type{padding-top:14px}#ap-solutions .site-type i{display:block;width:95%;height:10px;background:#294139;margin-bottom:6px}#ap-solutions .site-type i+i{width:70%}#ap-solutions .site-type span{display:block;width:90%;height:3px;background:#68796b66;margin-top:14px}#ap-solutions .site-type span+span{margin-top:5px;width:70%}#ap-solutions .site-type b{display:block;width:44px;height:17px;background:#354b3b;margin-top:18px;border-radius:3px}#ap-solutions .architecture{height:132px;position:relative;overflow:hidden;background:linear-gradient(#b9c4bb,#d3cfba)}#ap-solutions .sun{position:absolute;width:26px;height:26px;background:#e8dfba;border-radius:50%;top:12px;right:17px}#ap-solutions .ground{position:absolute;bottom:0;height:24px;width:100%;background:#a2aa8c}#ap-solutions .house{position:absolute;bottom:24px;left:15%;width:74%;height:56px;background:#ece1c9;border-top:8px solid #f6eedf;display:flex;align-items:end;padding:7px;gap:3px;transform:skewY(-5deg);z-index:1;box-shadow:8px 8px #4d5c4520}#ap-solutions .house i{flex:1;height:30px;background:#344c46}#ap-solutions .site-bottom{display:flex;gap:10px}#ap-solutions .site-bottom i{height:3px;background:#8b988255;flex:1}
#ap-solutions .capabilities{border:0;border-radius:0;background:transparent;padding:10px 24px 16px}#ap-solutions .capabilities>div{padding:13px 0;gap:14px}#ap-solutions .capabilities h3{font-size:14px;font-weight:600}#ap-solutions .application{font-size:12px;padding:12px 0 0;line-height:1.6}#ap-solutions .closing{margin-top:24px;padding:54px 40px;max-width:none;background:radial-gradient(ellipse at 50% 0%,#ffffff0c,transparent 75%),#182c3380}#ap-solutions .closing>p:not(.eyebrow){max-width:660px;margin-left:auto;margin-right:auto}
@keyframes ap-wave{0%,100%{transform:scaleY(.65)}50%{transform:scaleY(1)}}
@media(min-width:901px){#ap-solutions .solution:nth-of-type(2) .solution-copy{order:2}#ap-solutions .solution:nth-of-type(2) .product-stage{order:1}}
@media(max-width:700px){#ap-solutions{padding-inline:18px}#ap-solutions .intro{padding:48px 0 32px}#ap-solutions .pillars{grid-template-columns:1fr}#ap-solutions .pillars a{padding:18px 20px;display:grid;grid-template-columns:30px 1fr;gap:0 10px;align-items:center}#ap-solutions .pillars a+a{border-left:0;border-top:1px solid var(--line)}#ap-solutions .pillars span{margin:0}#ap-solutions .pillars strong{font-size:19px}#ap-solutions .pillars p{grid-column:2;max-width:none;margin-top:5px;font-size:11px}#ap-solutions .solution{padding:44px 0;gap:24px}#ap-solutions .solution-copy{max-width:none}#ap-solutions .solution-copy>p:not(.eyebrow){font-size:15px;line-height:1.8}#ap-solutions .solution-copy h2{font-size:32px;margin-bottom:16px}#ap-solutions .product-visual{margin:10px 10px 0}#ap-solutions .capabilities{padding:8px 18px 18px}#ap-solutions .closing{padding:34px 22px}#ap-solutions .cta{max-width:100%;font-size:13px;padding:16px 20px}#ap-solutions .agent-preview{padding-inline:12px}#ap-solutions .channel-list{gap:4px}#ap-solutions .channel-list span{padding:5px 6px}#ap-solutions .window-top{font-size:8px}}
@media(prefers-reduced-motion:reduce){#ap-solutions .waveform i{animation:none}#ap-solutions .product-stage,#ap-solutions .pillars a{transition:none}#ap-solutions .product-stage:hover{transform:none}}
</style>
