---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { termsDocuments } from "../../i18n/termsContent";
import subheadings from "../../i18n/termsSubheadings.json";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const copy = termsDocuments[locale];
const pdfPath = "/downloads/autopilots-algemene-servicevoorwaarden-v1.10.pdf";
const slug = (index: number) => `artikel-${index + 1}`;
---

<BaseLayout title={copy.title} description={copy.description} canonical={localizedPath("page.terms",locale)} locale={locale} contentId="page.terms" noindex={true}>
  <article class="ap-ecosystem ap-legal-page ap-terms-page">
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><div class="ap-container"><a href={localizedPath("page.home",locale)}>{copy.home}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.name}</span></div></nav>
    <section class="ap-eco-hero"><div class="ap-container ap-eco-copy"><div class="ap-kicker">{copy.kicker}</div><h1>{copy.hero} <span class="ap-title-accent">{copy.accent}</span></h1><p class="ap-lead">{copy.lead}</p><div class="ap-terms-meta"><span>{copy.updated}</span><span>{copy.version}</span></div><div class="ap-actions"><a class="ap-button ap-button-primary" href={pdfPath} download>{copy.download}</a><a class="ap-button ap-button-secondary" href={localizedPath("page.privacy",locale)}>{copy.privacy}</a></div></div></section>
    <section class="ap-section ap-soft-section"><div class="ap-container ap-terms-layout">
      <aside class="ap-terms-toc"><strong>{copy.contents}</strong><ol>{copy.sections.map((section,index)=><li><a href={`#${slug(index)}`}>{section.title.replace(/^\d+\.\s*/,"")}</a></li>)}</ol></aside>
      <div class="ap-terms-document" lang="nl">
        <p class="ap-terms-language" lang={locale}><strong>{copy.languageNotice}</strong></p>
        {copy.sections.map((section,index)=><section id={slug(index)} class="ap-terms-section"><h2>{section.title}</h2>{section.paragraphs.map((paragraph, paragraphIndex)=><div id={`${slug(index)}-${paragraphIndex + 1}`} class="ap-terms-clause"><h3>{index + 1}.{paragraphIndex + 1} {subheadings[index][paragraphIndex]}</h3><p>{paragraph}</p></div>)}</section>)}
        <div class="ap-terms-contact"><p>{copy.languageNotice}</p><a class="ap-button ap-button-secondary" href={localizedPath("page.contact",locale)}>{copy.contact}</a></div>
      </div>
    </div></section>
  </article>
</BaseLayout>

<style>
  .ap-terms-clause{scroll-margin-top:110px}.ap-terms-clause h3{font-size:16px;line-height:1.45;margin:22px 0 8px;font-weight:700;color:var(--ap-text)}
  .ap-terms-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.ap-terms-meta span{font-family:Syne,sans-serif;font-size:13px;font-weight:700;background:var(--ap-soft);border:1px solid var(--ap-line);border-radius:999px;padding:8px 12px}.ap-terms-layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:32px;align-items:start}.ap-terms-toc{position:sticky;top:96px;background:var(--ap-card);border:1px solid var(--ap-line);border-radius:24px;padding:24px}.ap-terms-toc strong{font-family:Syne,sans-serif}.ap-terms-toc ol{margin:16px 0 0;padding-left:22px}.ap-terms-toc li{margin:0 0 9px;color:var(--ap-muted);font-size:14px}.ap-terms-toc a{color:inherit;text-decoration:none}.ap-terms-toc a:hover{color:var(--ap-brown)}.ap-terms-document{background:var(--ap-card);border:1px solid var(--ap-line);border-radius:28px;padding:clamp(24px,4vw,48px);box-shadow:0 18px 50px rgba(0,0,0,.05)}.ap-terms-language{padding:18px 20px;background:var(--ap-soft-2);border-left:4px solid var(--ap-brown);border-radius:12px;margin:0 0 34px}.ap-terms-section{scroll-margin-top:110px;padding:0 0 32px;margin:0 0 32px;border-bottom:1px solid var(--ap-line)}.ap-terms-section:last-of-type{border-bottom:0}.ap-terms-section h2{font-size:clamp(21px,2.5vw,28px);line-height:1.2;margin:0 0 16px}.ap-terms-section p{color:var(--ap-muted);line-height:1.75;margin:0 0 14px}.ap-terms-contact{padding:24px;background:var(--ap-soft-2);border-radius:20px}.ap-terms-contact p{margin:0 0 16px;color:var(--ap-muted)}@media(max-width:820px){.ap-terms-layout{grid-template-columns:1fr}.ap-terms-toc{position:static}.ap-terms-document{border-radius:22px}.ap-terms-toc ol{columns:2}}@media(max-width:520px){.ap-terms-toc ol{columns:1}}
</style>
