---
import { supportedLocales } from "../../i18n/languages";
import ConnectedHome from "../../components/premium/ConnectedHome.astro";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const locale = supportedLocales.find((item) => item.code === lang)?.code;
if (!locale) return Astro.redirect("/", 302);
---

<ConnectedHome locale={locale} />
