---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { localizedProductData } from "../../i18n/productPage";
import { localizedNicheData } from "../../i18n/catalog";
import { orderPageCopy } from "../../i18n/orderPage";
import { pricingRequest } from "../../i18n/pricingRequest";

interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const quote = pricingRequest[locale];
const original = orderPageCopy[locale];
const copy = {...original, kicker:quote.cta, proof:quote.lead, lead:quote.lead, faqLead:quote.terms, faq:[[quote.request,quote.lead],[quote.setup,quote.terms],original.faq[2]]};
const pageProducts = products.map((item)=>localizedProductData(locale,item));
const pageNiches = niches.map((item)=>({...localizedNicheData(locale,item),href:localizedPath(`niche.${item.slug}`,locale)}));
const clientData = JSON.stringify({ products:pageProducts, niches:pageNiches, locale, nichePrefix:localizedPath("page.niches",locale), productsPath:localizedPath("page.products",locale) }).replaceAll("<", "\\u003c");
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: copy.title,
  description: copy.description
};
---

<BaseLayout title={copy.title} description={copy.description} canonical={localizedPath("page.order",locale)} locale={locale} contentId="page.order" schema={schema}>
  <article class="ap-ecosystem ap-order-page" data-order-root>
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><div class="ap-container"><a href={localizedPath("page.home",locale)}>{copy.home}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.order}</span></div></nav>

    <section class="ap-eco-hero">
      <div class="ap-container ap-eco-hero-grid">
        <div class="ap-eco-copy">
          <div class="ap-kicker">{copy.kicker}</div>
          <h1>{copy.hero} <span class="ap-title-accent">{copy.accent}</span></h1>
          <p class="ap-lead">{copy.lead}</p>
          <div class="ap-inline-proof"><span class="ap-proof-dot" aria-hidden="true"></span><span>{copy.proof}</span></div>
        </div>
        <aside class="ap-order-summary" aria-live="polite">
          <div class="ap-kicker">{copy.route}</div>
          <span>{copy.chosen}</span>
          <strong data-order-product>{pageProducts[0].name}</strong>
          <p data-order-promise>{pageProducts[0].promise}</p>
          <a class="ap-button ap-button-secondary" href="#kies-product">{copy.change}</a>
        </aside>
      </div>
    </section>

    <section class="ap-section ap-soft-section" id="kies-product">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">{copy.step1}</div><h2>{copy.chooseProduct}</h2><p>{copy.chooseProductText}</p></div>
        <div class="ap-order-products" role="radiogroup" aria-label={copy.productAria}>
          {pageProducts.map((product, index) => <button type="button" role="radio" aria-checked={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} class:list={[{ "is-active": index === 0 }]} data-order-product-choice={product.slug} data-order-index={index}><span>{String(index + 1).padStart(2, "0")}</span><strong>{product.name}</strong><small>{product.promise}</small></button>)}
        </div>
      </div>
    </section>

    <section class="ap-section" id="kies-branche">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">{copy.step2}</div><h2>{copy.chooseBusiness}</h2><p>{copy.chooseBusinessText}</p></div>
        <label class="ap-order-search"><span>{copy.search}</span><input type="search" data-order-search placeholder={copy.placeholder} autocomplete="off" /></label>
        <p class="ap-order-empty" data-order-empty hidden>{copy.empty} <a href={`${localizedPath("page.appointment",locale)}?route=order`}>{copy.check}</a>.</p>
        <div class="ap-order-niches">
          {pageNiches.map((niche) => <a data-order-niche data-name={niche.name.toLocaleLowerCase(locale)} data-base={niche.href} href={`${niche.href}?product=${pageProducts[0].slug}#producten`}><span>{niche.name.slice(0, 2).toUpperCase()}</span><strong>{niche.name}</strong><b aria-hidden="true">→</b></a>)}
        </div>
      </div>
    </section>

    <section class="ap-section ap-dark-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">{copy.after}</div><h2>{copy.afterTitle}</h2></div>
        <ol class="ap-order-route">{copy.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong></li>)}</ol>
        <p class="ap-order-route-note">{copy.routeNote}</p>
      </div>
    </section>

    <section class="ap-section ap-soft-section">
      <div class="ap-container ap-faq-layout">
        <div class="ap-section-head"><div class="ap-kicker">{copy.before}</div><h2>{copy.faqTitle}</h2><p>{copy.faqLead}</p></div>
        <div class="ap-faq-list">
          {copy.faq.map(([question,answer],index)=><details open={index===0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}{index===2 && <> <a href={localizedPath("page.privacy",locale)}>{copy.privacy}</a> · <a href={localizedPath("page.terms",locale)}>{copy.terms}</a>.</>}</p></details>)}
        </div>
      </div>
    </section>

  </article>
  <script id="ap-order-data" type="application/json" set:html={clientData}></script>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-order-root]");
    const dataNode = document.getElementById("ap-order-data");
    if (!root || !dataNode) return;
    const data = JSON.parse(dataNode.textContent || "{}");
    const valid = new Set(data.products.map((item) => item.slug));
    const requested = new URLSearchParams(location.search).get("product");
    let selected = data.products.find((item) => item.slug === requested) || data.products[0];
    const render = () => {
      root.querySelector("[data-order-product]").textContent = selected.name;
      root.querySelector("[data-order-promise]").textContent = selected.promise;
      root.querySelectorAll("[data-order-product-choice]").forEach((button) => {
        const active = button.dataset.orderProductChoice === selected.slug;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-checked", String(active));
        button.tabIndex = active ? 0 : -1;
      });
      root.querySelectorAll("[data-order-niche]").forEach((link) => {
        link.href = `${link.dataset.base}?product=${selected.slug}#producten`;
      });
      const url = new URL(location.href);
      url.searchParams.set("product", selected.slug);
      history.replaceState({}, "", url);
      try { sessionStorage.setItem("ap-selected-product", selected.slug); } catch (_) {}
    };
    root.querySelectorAll("[data-order-product-choice]").forEach((button) => button.addEventListener("click", () => {
      const product = data.products.find((item) => item.slug === button.dataset.orderProductChoice);
      if (product) { selected = product; render(); }
    }));
    root.querySelectorAll("[data-order-product-choice]").forEach((button) => button.addEventListener("keydown", (event) => {
      if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const buttons = [...root.querySelectorAll("[data-order-product-choice]")]; const current = Number(button.dataset.orderIndex || 0); const last = buttons.length - 1;
      const next = event.key === "Home" ? 0 : event.key === "End" ? last : ["ArrowRight", "ArrowDown"].includes(event.key) ? (current + 1) % (last + 1) : (current - 1 + last + 1) % (last + 1);
      buttons[next].click(); buttons[next].focus({ preventScroll: true });
    }));
    const search = root.querySelector("[data-order-search]");
    search?.addEventListener("input", () => {
      const query = search.value.trim().toLocaleLowerCase(data.locale);
      let visible = 0;
      root.querySelectorAll("[data-order-niche]").forEach((link) => {
        const show = !query || link.dataset.name.includes(query);
        link.hidden = !show;
        if (show) visible += 1;
      });
      root.querySelector("[data-order-empty]").hidden = visible !== 0;
    });
    if (!valid.has(requested)) {
      try { const saved = sessionStorage.getItem("ap-selected-product"); if (valid.has(saved)) selected = data.products.find((item) => item.slug === saved); } catch (_) {}
    }
    render();
  })();
</script>

<style>
  .ap-order-summary{border:1px solid rgba(255,255,255,.12);border-radius:28px;background:radial-gradient(circle at 100% 100%,rgba(159,56,38,.3),transparent 38%),linear-gradient(145deg,#071d33,#0d3151);color:#fff;padding:28px;box-shadow:0 24px 70px rgba(8,35,60,.14)}.ap-order-summary>span{display:block;color:#efaa9c;font-family:"Syne",sans-serif;font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}.ap-order-summary>strong{display:block;margin-top:14px;font-size:30px;line-height:1.08}.ap-order-summary>p{margin:14px 0 24px;color:rgba(255,255,255,.68);font-size:14px;line-height:1.55}.ap-order-products{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));overflow:hidden;border:1px solid rgba(8,35,60,.13);border-radius:24px;background:#fff}.ap-order-products button{display:grid;grid-template-columns:36px 1fr;gap:10px;align-items:start;border:0;border-bottom:1px solid var(--ap-line);background:transparent;padding:18px 14px;color:#111;text-align:left;cursor:pointer}.ap-order-products button+button{border-left:1px solid var(--ap-line)}.ap-order-products button>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px}.ap-order-products button>strong{font-size:17px;line-height:1.2}.ap-order-products button>small{grid-column:2;color:var(--ap-muted);font-size:12px;line-height:1.45}.ap-order-products button:hover,.ap-order-products button:focus-visible,.ap-order-products button.is-active{background:#eef3f6;outline:2px solid transparent}.ap-order-products button.is-active{box-shadow:inset 0 -3px var(--ap-brown);color:#071d33}.ap-order-search{display:grid;gap:8px;max-width:520px;margin-bottom:22px;color:var(--ap-muted);font-size:13px;font-weight:850}.ap-order-search input{min-height:52px;border:1px solid var(--ap-line);border-radius:999px;background:#fff;padding:0 19px;color:#111;font:inherit}.ap-order-search input:focus{outline:3px solid rgba(159,56,38,.18);border-color:var(--ap-brown)}.ap-order-niches{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--ap-line)}.ap-order-niches>a{display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;border-bottom:1px solid var(--ap-line);padding:14px 8px}.ap-order-niches>a:nth-child(3n+2),.ap-order-niches>a:nth-child(3n+3){padding-left:20px}.ap-order-niches>a>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px}.ap-order-niches b{color:var(--ap-brown);font-size:16px}.ap-order-empty{margin:0 0 20px;border-left:3px solid var(--ap-brown);background:#f1f5f7;padding:14px 16px}.ap-order-empty a{color:var(--ap-brown);font-weight:850}.ap-order-route{display:grid;grid-template-columns:repeat(5,1fr);margin:34px 0 0;padding:0;border-top:1px solid rgba(255,255,255,.18);list-style:none}.ap-order-route li{display:grid;gap:12px;border-bottom:1px solid rgba(255,255,255,.18);padding:22px 10px}.ap-order-route span{color:#efaa9c;font-family:"Syne",sans-serif;font-size:10px}.ap-order-route strong{font-size:15px}.ap-order-route-note{max-width:820px;margin:24px 0 0;color:rgba(255,255,255,.68);line-height:1.6}@media(max-width:1024px){.ap-order-products{grid-template-columns:repeat(3,minmax(0,1fr))}.ap-order-products button:nth-child(4){border-left:0}.ap-order-niches{grid-template-columns:repeat(2,minmax(0,1fr))}.ap-order-niches>a:nth-child(n){padding-left:8px}.ap-order-niches>a:nth-child(even){padding-left:20px}.ap-order-route{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){.ap-order-products,.ap-order-niches,.ap-order-route{grid-template-columns:1fr}.ap-order-products button+button,.ap-order-products button:nth-child(4){border-left:0}.ap-order-niches>a:nth-child(n){padding-left:8px}.ap-order-summary{border-radius:24px;padding:23px}}
</style>
