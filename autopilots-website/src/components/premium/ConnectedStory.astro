---
import QuizCTA from './QuizCTA.astro';
import HomeLanguage from './HomeLanguage.astro';
import ScrollNarrative from './UnifiedStory.astro';
import ShowcasePicker from './ShowcasePicker.astro';
import '../../styles/connected-story.css';
import '../../styles/unified-story.css';
import '../../styles/showcase-scenes.css';
const chapters = [
 {id:'medewerkers', label:'AI-medewerkers', title:'Een gesprek.', accent:'En het werk gaat verder.', description:'Digitale medewerkers voor telefonie en chat. Ze beantwoorden vragen en voeren afgesproken acties uit in jouw systemen.', outcome:'Van klantvraag naar concrete actie.'},
 {id:'software', label:'Maatwerksoftware', title:'Jouw werkwijze.', accent:'Jouw software.', description:'Een planner, klantportaal of complete bedrijfsapplicatie. Gebouwd rondom jouw mensen en processen.', outcome:'Van losse informatie naar één werkplek.'},
 {id:'websites', label:'Websites & backends', title:'Een sterke voorkant.', accent:'Een slimme achterkant.', description:'Websites die meer doen dan er goed uitzien. Met een eigen backend, slimme intake en passende koppelingen.', outcome:'Van eerste indruk naar een goed geregelde aanvraag.'}
];
---
<div id="ap-connected">
 <ScrollNarrative/>
 <ShowcasePicker/>
 <header class="cs-header cs-wrap"><a class="cs-logo" href="/nl/" aria-label="Autopilots home">AUTOPILOTS</a><HomeLanguage/><QuizCTA label="Start de AI-scan" compact/></header>
 <div class="cs-content">
 <section class="cs-hero cs-wrap" id="vertrek"><div class="cs-eyebrow"><i></i> MAATWERK VOOR HET MKB</div><h1>Je bedrijf kan meer.<br/><em>Bouw wat daarvoor nodig is.</em></h1><p class="cs-intro">Wij bouwen AI-medewerkers, maatwerksoftware en websites voor het mkb. <span>Los inzetbaar. Sterker wanneer ze samenwerken.</span></p><a class="cs-discover" href="#medewerkers">Ontdek jouw mogelijkheden <span>↓</span></a>
 <div class="cs-overview" aria-label="Onze drie verbonden bouwgebieden"><div class="cs-overview-line"></div>{chapters.map((c,i)=><a href={`#${c.id}`}><small>0{i+1}</small><span class={`cs-symbol symbol-${i}`} aria-hidden="true">{i===0?'◉':i===1?'⊞':'↗'}</span><strong>{c.label}</strong><span class="cs-overview-note">{['Gesprekken worden acties','Software volgt jouw werkwijze','Meer dan een mooie website'][i]}</span></a>)}</div></section>
 {chapters.map((chapter,index)=><section class="cs-chapter" id={chapter.id} data-chapter={index}><div class="cs-scene cs-wrap"><div class="cs-copy"><p class="cs-eyebrow">0{index+1} / {chapter.label}</p><h2>{chapter.title}<br/><em>{chapter.accent}</em></h2><p>{chapter.description}</p><a class="cs-textlink" href="#aanvraag">Meer informatie <span>↗</span></a><div class="cs-chapter-progress" aria-hidden="true"><i></i></div></div><div class={`cs-visual visual-${index}`}><div class="cs-windowbar"><span><i></i> AUTOPILOTS / {['CONVERSATION','WORKSPACE','WEBSITE'][index]}</span><small>INTERACTIEF VOORBEELD</small></div>
 {index===0&&<div class="cs-agent-demo"><div class="cs-switch" role="group" aria-label="Kies gespreksvorm"><button type="button" data-channel="phone" aria-pressed="true">Telefonie</button><button type="button" data-channel="chat" aria-pressed="false">Chat</button></div><div class="cs-call"><div class="cs-call-orb" aria-hidden="true">a<span>i</span></div><div><strong data-channel-title>Een gesprek met jouw bedrijf</strong><span data-channel-sub>AI-medewerker · voorbeeldgesprek</span></div><div class="cs-wave" aria-hidden="true">{Array.from({length:19},(_,i)=><i style={`--bar:${(i*7%13)+4};--delay:${i*.07}s`}></i>)}</div></div><div class="cs-chat"><p><span>KLANT</span>“Kunnen we een kennismaking plannen?”</p><p><span>AI-MEDEWERKER</span>“Natuurlijk. Waar kunnen we je bij helpen?”</p></div><div class="cs-action cs-build"><span class="cs-tick">✓</span><div><small>VAN GESPREK NAAR ACTIE</small><strong>Afspraak voorbereid</strong><span>Context en klantvraag staan erbij.</span></div><b>↗</b></div><div class="cs-footnote">Jij bepaalt de bevoegdheden. Je team kan overnemen.</div></div>}
 {index===1&&<div class="cs-workspace"><div class="cs-work-head"><div><small>JOUW WERKOMGEVING</small><h3>Alles op zijn plek.</h3></div><span class="cs-avatar">JD</span></div><div class="cs-switch" role="group" aria-label="Kies softwarevoorbeeld"><button type="button" data-work="Planning" aria-pressed="true">Planning</button><button type="button" data-work="Klantportaal" aria-pressed="false">Klantportaal</button><button type="button" data-work="Projecten" aria-pressed="false">Projecten</button></div><div class="cs-work-grid"><div class="cs-work-sidebar"><span>Overzicht</span><strong data-work-title>Planning</strong><span>Klanten</span><span>Documenten</span></div><div class="cs-board"><div class="cs-board-head"><strong data-board-title>Deze week</strong><span>MA · DI · WO</span></div><div class="cs-task"><i></i><div><strong data-task-one>Kennismaking</strong><span>Klantvraag en context ontvangen</span></div><small>09:30</small></div><div class="cs-task cs-build"><i></i><div><strong data-task-two>Voorstel voorbereiden</strong><span>Toegewezen aan je team</span></div><small>11:00</small></div><div class="cs-task cs-build"><i></i><div><strong data-task-three>Klant op de hoogte</strong><span>Status en vervolgstap zichtbaar</span></div><small>✓</small></div><div class="cs-board-summary"><i></i> Eén gedeeld overzicht</div></div></div><div class="cs-footnote">Eigen schermen. Eigen rollen. Jouw manier van werken.</div></div>}
 {index===2&&<div class="cs-web-demo"><div class="cs-web-front"><div class="cs-web-nav"><strong>JOUW BEDRIJF</strong><span>Aanpak &nbsp; Contact</span></div><div class="cs-web-body"><small>GEMAAKT VOOR JOUW KLANT</small><h3>Een goed begin.<br/><em>Tot in detail.</em></h3><div class="cs-web-art" aria-hidden="true"><i></i><i></i><i></i></div><button type="button" data-website-demo>Bekijk een voorbeeldaanvraag <span>↗</span></button></div></div><div class="cs-backend cs-build"><span class="cs-eyebrow">ACHTER DE SCHERMEN</span><div><span>01</span><strong>Aanvraag ontvangen</strong><b>✓</b></div><div><span>02</span><strong>Gegevens opgeslagen</strong><b>✓</b></div><div><span>03</span><strong>Taak aangemaakt</strong><b>✓</b></div><p data-website-status aria-live="polite">De voorkant en achterkant werken samen.</p></div></div>}
 <div class="cs-outcome"><span>↳</span>{chapter.outcome}</div></div></div></section>)}
 <section class="cs-connected-section cs-wrap" id="verbonden"><p class="cs-eyebrow">04 / HIER KOMT HET SAMEN</p><h2>Niet drie losse oplossingen.<br/><em>Eén bedrijf dat samenwerkt.</em></h2><p>Wij verbinden wat we bouwen met elkaar én met de systemen die je al gebruikt.</p><div class="cs-network"><div class="cs-network-core"><span class="cs-logo">AUTOPILOTS</span><small>DE VERBINDING TUSSEN JOUW SYSTEMEN</small></div><div class="cs-network-nodes">{chapters.map((c,i)=><div class="cs-network-node" style={`--node:${i}`}><span>0{i+1}</span><h3>{c.label}</h3><p>{['Begrijpt de klantvraag','Organiseert het werk','Ontvangt de aanvraag'][i]}</p><i aria-hidden="true"></i></div>)}</div><div class="cs-flow" aria-label="Voorbeeld van een verbonden proces"><span>Aanvraag</span><b>→</b><span>Gesprek</span><b>→</b><span>Verwerking</span><b>→</b><span>Terugkoppeling</span></div></div><small class="cs-disclaimer">Voorbeeld van een mogelijke inrichting. Welke koppelingen mogelijk zijn, onderzoeken we vooraf.</small></section>
 <section class="cs-approach cs-wrap" id="aanpak"><div><p class="cs-eyebrow">05 / VAN IDEE NAAR PRAKTIJK</p><h2>Groot denken.<br/><em>Helder beginnen.</em></h2><p>Een maatwerktraject begint niet met software. Het begint met begrijpen wat jouw bedrijf nodig heeft.</p></div><ol>{[['Begrijpen','We onderzoeken je werkwijze, doelen en bestaande systemen.'],['Bouwen','We ontwerpen, ontwikkelen en testen. Jij kijkt en beslist mee.'],['Doorontwikkelen','We begeleiden de start en spreken beheer en verbeteringen af.']].map((p,i)=><li><span>0{i+1}</span><div><h3>{p[0]}</h3><p>{p[1]}</p></div></li>)}</ol></section>
 <section class="cs-cta cs-wrap" id="aanvraag"><span class="cs-eyebrow">JOUW BEDRIJF. JOUW VOLGENDE STAP.</span><h2>Wat kunnen we<br/><em>voor jou bouwen?</em></h2><p>Vertel ons waar je naartoe wilt. Ontdek waar AI-medewerkers, software of een betere website kunnen helpen.</p><QuizCTA label="Start de AI-scan"/><small>Een eerste richting op basis van jouw antwoorden.<br/>Geen definitief technisch advies of offerte.</small></section>
 </div><footer class="cs-footer cs-wrap"><a class="cs-logo" href="/nl/">AUTOPILOTS</a><span>Los inzetbaar. Sterker samen.</span><a href="/nl/voor-wie/">Branches</a><a href="/nl/producten/">Oplossingen</a><a href="/nl/privacy/">Privacy</a><a href="/nl/kennisbank/">Kennisbank</a><button type="button" data-cs-motion aria-pressed="false">Minder beweging</button></footer>
</div>
<script>
 const root=document.querySelector<HTMLElement>('#ap-connected');
 if(root){
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const chapters=[...root.querySelectorAll<HTMLElement>('[data-chapter]')];
 const network=root.querySelector<HTMLElement>('.cs-network')!;
 let manual=false, frame=0;
 function render(){frame=0;const quiet=manual||reduced.matches;root!.classList.toggle('cs-quiet',quiet);chapters.forEach(section=>{const rect=section.getBoundingClientRect();const progress=Math.max(0,Math.min(1,(innerHeight*.75-rect.top)/(rect.height*.75)));section.style.setProperty('--progress',String(quiet?1:progress));section.classList.toggle('cs-entered',quiet||rect.top<innerHeight*.65);});const box=network.getBoundingClientRect();network.style.setProperty('--join',String(quiet?1:Math.max(0,Math.min(1,(innerHeight-box.top)/(innerHeight*.6)))));}
 const schedule=()=>{if(!frame)frame=requestAnimationFrame(render);};
 addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);reduced.addEventListener('change',schedule);render();
 const observer=new IntersectionObserver(entries=>entries.forEach(entry=>entry.target.classList.toggle('cs-visible',entry.isIntersecting)),{threshold:.15});
 root.querySelectorAll('.cs-visual,.cs-network').forEach(el=>observer.observe(el));
 root.querySelectorAll<HTMLButtonElement>('[data-channel]').forEach(button=>button.addEventListener('click',()=>{const chat=button.dataset.channel==='chat';root.querySelectorAll('[data-channel]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));root.querySelector('[data-channel-title]')!.textContent=chat?'Een chat met jouw bedrijf':'Een gesprek met jouw bedrijf';root.querySelector('[data-channel-sub]')!.textContent=chat?'AI-medewerker · voorbeeldchat':'AI-medewerker · voorbeeldgesprek';root.querySelector('.cs-agent-demo')!.classList.toggle('is-chat',chat);}));
 const workCopy:Record<string,string[]>={Planning:['Deze week','Kennismaking','Voorstel voorbereiden','Klant op de hoogte'],Klantportaal:['Jouw klantomgeving','Aanvraag ontvangen','Documenten beschikbaar','Voortgang bekijken'],Projecten:['Projectoverzicht','Nieuw project','Taken verdeeld','Update voor de klant']};
 root.querySelectorAll<HTMLButtonElement>('[data-work]').forEach(button=>button.addEventListener('click',()=>{root.querySelectorAll('[data-work]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));root.querySelector('[data-work-title]')!.textContent=button.dataset.work!;const copy=workCopy[button.dataset.work!];['board-title','task-one','task-two','task-three'].forEach((key,i)=>{root.querySelector(`[data-${key}]`)!.textContent=copy[i];});}));
 root.querySelector('[data-website-demo]')?.addEventListener('click',()=>{root.querySelector('.cs-web-demo')!.classList.toggle('is-submitted');root.querySelector('[data-website-status]')!.textContent='Voorbeeld verwerkt: aanvraag → gegevens → taak. Er is niets verzonden.';});
 root.querySelector('[data-cs-motion]')?.addEventListener('click',event=>{manual=!manual;const button=event.currentTarget as HTMLButtonElement;button.setAttribute('aria-pressed',String(manual));button.textContent=manual?'Beweging uit':'Minder beweging';render();});
 }
</script>
