---
import { intakeBranches } from '../../data/intakeBranches';
import { showcaseProfiles } from './showcase-profiles';
import '../../styles/showcase-picker.css';
---
<section class="sp-picker cs-wrap" id="jouw-bedrijf" hidden aria-labelledby="sp-title">
 <div class="sp-intro"><h2 id="sp-title">Kies jullie branche<br/><em>en zie wat wij kunnen betekenen.</em></h2><p>Wij bouwen AI-medewerkers, software &amp; websites.</p></div>
 <form class="sp-form">
  <fieldset><legend>Kies jullie branche</legend><div class="sp-options">{showcaseProfiles.map(profile=><label class="sp-option"><input type="radio" name="showcase-branch" value={profile.branch}/><span class="sp-icon" aria-hidden="true">{profile.icon}</span><strong>{profile.label}</strong><span class="sp-check" aria-hidden="true">↗</span></label>)}</div></fieldset>
  <div class="sp-fields"><label>Een andere branche<select name="showcase-other"><option value="">Zoek jullie branche in de lijst</option>{intakeBranches.map(branch=><option value={branch}>{branch}</option>)}</select></label></div>
  <p class="sp-feedback" role="status" aria-live="polite">Drie voorbeelden. Afgestemd op jouw wereld.</p>
  <div class="sp-actions"><button class="sp-start" type="submit">Bekijk jouw mogelijkheden <span>↓</span></button><button class="sp-skip" type="button">Bekijk het algemene voorbeeld →</button></div>
  <small class="sp-privacy">Geen gegevens versturen. Geen account. Alleen een voorbeeld voor jouw branche.</small>
 </form>
</section>
