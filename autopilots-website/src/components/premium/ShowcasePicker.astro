---
import { showcaseProfiles } from './showcase-profiles';
import '../../styles/showcase-picker.css';
import { translator } from './showcase-i18n';
import type { SupportedLocale } from '../../i18n/languages';
const {locale='nl'}=Astro.props as {locale?:SupportedLocale};
const t=translator(locale);
---
<section class="sp-picker cs-wrap" id="jouw-bedrijf" hidden aria-labelledby="sp-title">
 <div class="sp-intro"><h2 id="sp-title">{t("Kies jullie branche")}<br/><em>{t("en zie wat wij kunnen betekenen.")}</em></h2><p>{t("Wij bouwen AI-medewerkers, software & websites.")}</p></div>
 <form class="sp-form">
  <fieldset><legend>{t("Kies jullie branche")}</legend><div class="sp-options">{showcaseProfiles.map(profile=><label class="sp-option"><input type="radio" name="showcase-branch" value={profile.branch}/><span class="sp-icon" aria-hidden="true">{profile.icon}</span><strong>{t(profile.label)}</strong><span class="sp-check" aria-hidden="true">↗</span></label>)}</div></fieldset>
  <div class="sp-actions"><button class="sp-start" type="submit">{t("Bekijk jouw mogelijkheden")} <span>↓</span></button><button class="sp-skip" type="button">{t('Bekijk het algemene voorbeeld')} →</button></div>
  <small class="sp-privacy">{t("Geen gegevens versturen. Geen account. Alleen een voorbeeld voor jouw branche.")}</small>
 </form>
</section>
