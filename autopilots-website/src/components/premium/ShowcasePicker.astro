---
import { showcaseProfiles } from './showcase-profiles';
import '../../styles/showcase-picker.css';
import { translator } from './showcase-i18n';
import type { SupportedLocale } from '../../i18n/languages';
const {locale='nl'}=Astro.props as {locale?:SupportedLocale};
const t=translator(locale);
const sortedProfiles = [...showcaseProfiles].sort((a, b) => t(a.label).localeCompare(t(b.label), locale));
---
<section class="sp-picker cs-wrap" id="jouw-bedrijf" hidden aria-labelledby="sp-title">
 <div class="sp-intro"><span class="sp-eyebrow">{locale==='nl'?'AFGESTEMD OP JULLIE BEDRIJF':t("Kies jullie branche")}</span><h2 id="sp-title">{locale==='nl'?'Wat bouwen we voor jullie?':t("en zie wat wij kunnen betekenen.")}</h2><p>{locale==='nl'?'Kies jullie branche. Bekijk hoe AI, software en een website jullie werk kunnen versterken.':''}</p></div>
 <form class="sp-form">
  <fieldset aria-labelledby="sp-title"><div class="sp-options">{sortedProfiles.map(profile=><label class="sp-option"><input type="radio" name="showcase-branch" value={profile.branch}/><span class="sp-icon" aria-hidden="true">{profile.id==='automotive'?<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 10 2-5h10l2 5M3 10h18v8H3zM6 18v2m12-2v2M6 14h2m8 0h2"/></svg>:<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={profile.id==='nonprofit'?'M12 20 4 12C-2 5 8 1 12 7c4-6 14-2 8 5l-8 8Z':profile.id==='healthcare'?'M9 3h6v6h6v6h-6v6H9v-6H3V9h6V3Z':profile.id==='construction'?'M3 11 12 3l9 8M5 10v11h14V10M10 21v-7h4v7':profile.id==='installation'?'m14 3-7 10h5l-2 8 7-11h-5l2-7':profile.id==='property'?'M3 21V8l9-5 9 5v13H3M8 10h2m4 0h2M8 14h2m4 0h2M10 21v-4h4v4':profile.id==='beauty'?'M12 3c0 6-3 9-9 9 6 0 9 3 9 9 0-6 3-9 9-9-6 0-9-3-9-9Z':'M4 7h16v14H4V7Zm4 0V3h8v4M4 12h16M10 12v3h4v-3'}/></svg>}</span><strong>{t(profile.label)}</strong></label>)}</div></fieldset>
 </form>
</section>
