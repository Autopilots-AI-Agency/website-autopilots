<script>
import { renderShowcase } from './showcase-scenes';
import { generalProfile, profileForBranch, escapeMarkup, type ShowcaseProfile } from './showcase-profiles';
import { createHouseScene } from './house-scene';
const root = document.querySelector<HTMLElement>('#ap-connected');
if(root){
 const originals = [...root.querySelectorAll<HTMLElement>('.cs-chapter')];
 const panels = originals.map(section=>section.querySelector<HTMLElement>('.cs-visual')!);
 const titles = ['Drie bouwgebieden. Eén partner.','Een extra collega. Voor jouw klanten.','Jouw werkwijze. In eigen software.','Een website die verder werkt.','Los inzetbaar. Sterker samen.'];
 const descriptions = ['Scroll en zie hoe het samenkomt.','Telefonie en chat, met afgesproken acties en jouw team aan het roer.','Van planning tot klantportaal. Gebouwd rondom jouw processen.','Een sterke voorkant, met een eigen backend en passende koppelingen.','Wij verbinden wat je nodig hebt. Ook met de systemen die je al gebruikt.'];
 const stage = document.createElement('section');
 stage.className='us-story';stage.setAttribute('aria-label','Wat Autopilots voor jouw bedrijf bouwt');
 stage.innerHTML=`<div class="us-sticky"><div class="us-caption"><span class="cs-eyebrow">AUTOPILOTS / VAN IDEE NAAR SAMENWERKING</span><h2>${titles[0]}</h2><p>${descriptions[0]}</p></div><div class="us-world"><svg class="us-connections" viewBox="0 0 1000 500" preserveAspectRatio="none" aria-hidden="true"><path d="M170 250 C300 250 300 160 500 160 S700 250 830 250"/><path class="us-signal" d="M170 250 C300 250 300 160 500 160 S700 250 830 250"/></svg><div class="us-orbit" aria-hidden="true"></div></div><div class="us-controls" aria-label="Ga naar een bouwgebied">${['Overzicht','AI-medewerkers','Software','Websites','Samen'].map((name,i)=>`<button type="button" data-us-step="${i}"><span>0${i+1}</span>${name}</button>`).join('')}</div></div>`;
 const picker=root.querySelector<HTMLElement>('.sp-picker')!;
 root.querySelector('.cs-hero')!.after(picker);picker.hidden=false;picker.after(stage);
 root.querySelector('.cs-discover')!.setAttribute('href','#jouw-bedrijf');
 const world=stage.querySelector<HTMLElement>('.us-world')!;
 const together=document.createElement('div');together.className='sx-together';together.innerHTML='<span>Websiteaanvraag</span>→<span>AI vraagt door</span>→<span>Project aangemaakt</span>';world.append(together);
 let selectedProfile:ShowcaseProfile=generalProfile;
 const statusText=[['Gesprek komt binnen','AI begrijpt de vraag','Je team kan verder'],['Modules komen samen','Project krijgt vorm','Team en klant verbonden'],['Het ontwerp ontstaat','Gevels en glas komen samen','Website en beheer op maat']];
 const overrides=new Map<number,number>();
 let flipOverride:number|null=null;
 let flipFront:HTMLElement,flipBack:HTMLElement,flipButton:HTMLButtonElement;
 let drawHouse:((progress:number)=>void)|undefined;
 function mountDemos(profile:ShowcaseProfile,company=''){
 selectedProfile=profile;
 statusText[0]=['Gesprek komt binnen','AI begrijpt de vraag',profile.action];
 statusText[1]=['Modules komen samen',profile.preparation,'Team en klant verbonden'];
 statusText[2]=profile.id==='general'?['Het ontwerp ontstaat','Gevels en glas komen samen','Website en beheer op maat']:[profile.phases[0],profile.phases[2],'Website en beheer op maat'];
 const examples=renderShowcase(profile,company);
 overrides.clear();flipOverride=null;
 panels.forEach((panel,i)=>{
  panel.querySelector('.dx-demo')?.remove();
  const demo=document.createElement('div');demo.className='dx-demo';
  demo.innerHTML=examples[i]+`<div class="dx-bottom"><span data-dx-status>${statusText[i][0]}</span><button type="button" data-dx-play>Volgende stap <span>→</span></button></div><div class="dx-track"><i></i></div><small class="dx-disclaimer">Voorbeeld · geen echte aanvraag of boeking</small>`;
  panel.append(demo);
  demo.querySelectorAll<HTMLButtonElement>('[data-dx-channel]').forEach(button=>button.addEventListener('click',()=>{
   const chat=button.dataset.dxChannel==='chat';
   demo.querySelector('[data-customer-line]')!.textContent=`“${chat?profile.chat:profile.question}”`;
   demo.querySelector('[data-agent-line]')!.textContent=`“${profile.reply}”`;
  }));
  if(i===2)drawHouse=createHouseScene(demo.querySelector<HTMLCanvasElement>('[data-house-canvas]')!,profile.visual);
  if(i===2){
   const site=demo.querySelector<HTMLElement>('.dx-atelier')!;
   const shell=document.createElement('div');shell.className='dx-flip';
   const rotor=document.createElement('div');rotor.className='dx-flip-rotor';
   site.before(shell);shell.append(rotor);rotor.append(site);site.classList.add('dx-flip-front');flipFront=site;
   flipBack=document.createElement('div');flipBack.className='dx-flip-back';
   flipBack.innerHTML=`<div class="dx-admin-top"><b>NOORD® / BEHEER</b><span>Interactieve demo</span></div><div class="dx-admin-body"><small>JOUW WEBSITE. JOUW CONTROLE.</small><h4>Zelf aanpassen.<br>Zonder omwegen.</h4><p>Een beheeromgeving op maat voor jouw team.</p><label for="demo-site-title">Titel op je website</label><input id="demo-site-title" maxlength="45" value="Bijzonder wonen." autocomplete="off"><fieldset><legend>Accentkleur</legend><button type="button" data-site-color="#314235" style="--swatch:#314235" aria-label="Bosgroen" aria-pressed="true"></button><button type="button" data-site-color="#875735" style="--swatch:#875735" aria-label="Warm brons" aria-pressed="false"></button><button type="button" data-site-color="#304c67" style="--swatch:#304c67" aria-label="Nachtblauw" aria-pressed="false"></button></fieldset><div class="dx-admin-project"><span>PROJECTEN</span><strong>Duinvilla <i>Gepubliceerd in demo</i></strong><small>Teksten, projecten en aanvragen op één plek.</small></div><div class="dx-admin-saved" role="status">✓ Probeer een titel of kleur. Bekijk daarna de voorkant.</div></div>`;
   rotor.append(flipBack);
   site.style.setProperty('--site-accent',profile.accent);
   site.dataset.profile=profile.id;
   flipBack.querySelector('.dx-admin-top b')!.textContent=`${company||profile.brand} / BEHEER`;
   flipBack.querySelector('input')!.value=profile.title;
   flipBack.querySelector('.dx-admin-project strong')!.firstChild!.textContent=profile.project+' ';
   flipBack.querySelectorAll('[data-site-color]').forEach(b=>b.setAttribute('aria-pressed',String((b as HTMLElement).dataset.siteColor===profile.accent)));
   flipButton=document.createElement('button');flipButton.type='button';flipButton.className='dx-flip-toggle';flipButton.textContent='Bekijk de achterkant ↻';
   shell.after(flipButton);
   flipButton.addEventListener('click',()=>{flipOverride=Number(panel.dataset.flip||0)>.5?0:1;schedule();});
   const title=site.querySelector('h4')!;
   const titleText=document.createElement('span');titleText.textContent=profile.title;title.firstChild!.replaceWith(titleText);
   const saved=flipBack.querySelector<HTMLElement>('.dx-admin-saved')!;
   flipBack.querySelector('input')!.addEventListener('input',event=>{titleText.textContent=(event.target as HTMLInputElement).value||profile.title;saved.textContent='✓ Aangepast in dit voorbeeld · niets wordt gepubliceerd';});
   flipBack.querySelectorAll<HTMLButtonElement>('[data-site-color]').forEach(button=>button.addEventListener('click',()=>{site.style.setProperty('--site-accent',button.dataset.siteColor!);flipBack.querySelectorAll('[data-site-color]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));saved.textContent='✓ Kleur aangepast · bekijk de voorkant';}));
  }
  demo.querySelector('[data-dx-play]')!.addEventListener('click',()=>{const now=Number(panel.dataset.demoProgress||0);overrides.set(i,now>.85?0:Math.min(1,now+.4));schedule();});
  demo.querySelectorAll<HTMLButtonElement>('[data-dx-channel]').forEach(button=>button.addEventListener('click',()=>{demo.querySelectorAll('[data-dx-channel]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));const chat=button.dataset.dxChannel==='chat';demo.querySelector('[data-dx-call]')!.textContent=chat?'Nieuw chatbericht':'Inkomend gesprek';demo.classList.toggle('dx-chat-mode',chat);}));
 });
 together.innerHTML=profile.flow.map(text=>`<span>${escapeMarkup(text)}</span>`).join('→');
 }
 mountDemos(generalProfile);
 panels.forEach((panel,i)=>{world.append(panel);panel.classList.add('us-panel');panel.dataset.panel=String(i);const label=document.createElement('h3');label.className='us-panel-label';label.textContent=['AI-medewerkers','Maatwerksoftware','Websites & backends'][i];panel.prepend(label);});
 originals.forEach((section,i)=>{const marker=document.createElement('span');marker.id=section.id;marker.className='us-marker';marker.style.top=`${(i+1)*20}%`;stage.append(marker);section.removeAttribute('id');});
 const connected=root.querySelector<HTMLElement>('.cs-connected-section')!;
 const end=document.createElement('span');end.id='verbonden';end.className='us-marker';end.style.top='80%';stage.append(end);connected.removeAttribute('id');
 const cta=root.querySelector<HTMLElement>('.cs-cta')!;stage.after(cta);
 cta.querySelector('h2')!.innerHTML='En hoe zou dit<br/><em>voor jouw bedrijf werken?</em>';
 root.classList.add('us-ready');
 let current=0,target=0,frame=0,last=0;
 const reduce=matchMedia('(prefers-reduced-motion: reduce)');
 const quiet=()=>reduce.matches||root.classList.contains('cs-quiet');
 const clamp=(v:number)=>Math.min(1,Math.max(0,v));
 // Each row describes the SAME three interfaces, not new copies.
 const desktop=[[[16,54,.36,-7],[50,45,.44,0],[84,54,.36,7]],[[50,50,1,0],[118,58,.4,7],[155,64,.3,10]],[[-48,62,.3,-9],[50,50,1,0],[130,58,.4,7]],[[-55,65,.3,-10],[-30,58,.4,-7],[50,50,1,0]],[[16,51,.36,0],[50,46,.4,0],[84,51,.36,0]]];
 const mobile=[[[45,37,.69,-5],[53,52,.69,0],[59,67,.69,5]],[[50,48,.97,0],[98,70,.65,5],[120,80,.55,8]],[[-26,76,.55,-8],[50,48,.97,0],[113,76,.6,5]],[[-45,85,.55,-8],[-10,72,.65,-5],[50,48,.97,0]],[[50,19,.66,0],[50,51,.66,0],[50,83,.66,0]]];
 const buttons=[...stage.querySelectorAll<HTMLButtonElement>('[data-us-step]')];
 function paint(time:number){
  frame=0;const dt=Math.min(40,time-(last||time));last=time;
  current+= (target-current)*(1-Math.exp(-dt/95));
  const staticMode=quiet();root!.classList.toggle('us-static',staticMode);
  const phase=current*4, index=Math.min(3,Math.floor(phase)), mix=phase-index;
  const motionMix=clamp((mix-.28)/.44);
  const eased=motionMix*motionMix*(3-2*motionMix), active=Math.round(phase);
  const states=innerWidth<701?mobile:desktop;
  panels.forEach((panel,i)=>{
   const from=states[index][i],to=states[index+1][i];const v=from.map((n,j)=>n+(to[j]-n)*eased);
   // Keep the demo inside its stage, clear of the heading and navigation.
   const radians=Math.abs(v[3])*Math.PI/180;
   const rotatedHeight=panel.offsetHeight*Math.cos(radians)+panel.offsetWidth*Math.sin(radians);
   const fitScale=Math.max(.1,(world.clientHeight-32)/Math.max(1,rotatedHeight));
   const scale=Math.min(v[2],1,fitScale);
   const halfHeight=rotatedHeight*scale/2;
   const centerY=Math.max(halfHeight+16,Math.min(world.clientHeight-halfHeight-16,world.clientHeight*v[1]/100));
   panel.style.left=`${v[0]}%`;panel.style.top=`${centerY}px`;panel.style.transform=`translate(-50%,-50%) scale(${scale}) rotate(${v[3]}deg)`;
   const focused=active===0||active===4||active===i+1;
   panel.style.opacity=focused?'1':(innerWidth<701?'.08':'.2');panel.style.zIndex=active===i+1?'5':String(i+1);
   panel.inert=!staticMode&&!focused;panel.classList.toggle('cs-visible',focused);
   const progress=staticMode?1:(overrides.get(i)??clamp((phase-i-.55)/.85));
   panel.dataset.demoProgress=String(progress);
   panel.style.setProperty('--demo',String(progress));
   if(i===2){
    const turn=flipOverride??(staticMode?0:clamp((phase-3.16)/.2));
    const houseProgress=staticMode?1:(overrides.get(2)??clamp((phase-2.55)/.55));
    drawHouse?.(houseProgress);
    const phaseLabel=panel.querySelector('[data-house-phase]');
    if(phaseLabel)phaseLabel.textContent=selectedProfile.phases[Math.min(4,Math.floor(houseProgress*5))];
    const smoothTurn=turn*turn*(3-2*turn);
    panel.style.setProperty('--flip',String(smoothTurn));panel.dataset.flip=String(turn);
    const back=turn>.5;
    flipFront.inert=back;flipBack.inert=!back;
    flipFront.setAttribute('aria-hidden',String(back));flipBack.setAttribute('aria-hidden',String(!back));
    flipButton.textContent=back?'Bekijk jouw aanpassingen ↻':'Bekijk de achterkant ↻';
   }
   panel.querySelectorAll<HTMLElement>('[data-dx-at]').forEach(el=>{const shown=progress>=Number(el.dataset.dxAt);el.classList.toggle('dx-shown',shown);el.setAttribute('aria-hidden',String(!shown));});
   panel.querySelector('[data-dx-status]')!.textContent=statusText[i][progress<.35?0:progress<.7?1:2];
   panel.querySelector('[data-dx-play]')!.firstChild!.textContent=progress>.85?'Opnieuw afspelen ':'Volgende stap ';
  });
  const heading=stage.querySelector('h2')!;
  if(heading.textContent!==titles[active]){heading.textContent=titles[active];stage.querySelector('.us-caption p')!.textContent=descriptions[active];}
  buttons.forEach((b,i)=>b.setAttribute('aria-current',String(i===active)));
  stage.style.setProperty('--together',String(clamp((phase-3)*1.6)));
  if(Math.abs(target-current)>.0001)frame=requestAnimationFrame(paint);else last=0;
 }
 function schedule(){const rect=stage.getBoundingClientRect();target=clamp(-rect.top/Math.max(1,stage.offsetHeight-innerHeight));if(!frame)frame=requestAnimationFrame(paint);}
 function resumeScroll(){overrides.clear();if(!quiet()&&!flipBack.contains(document.activeElement))flipOverride=null;}
 buttons.forEach((button,i)=>button.addEventListener('click',()=>{resumeScroll();if(quiet()){panels[Math.max(0,Math.min(2,i-1))].scrollIntoView({block:'center'});return;}scrollTo({top:scrollY+stage.getBoundingClientRect().top+(stage.offsetHeight-innerHeight)*i/4,behavior:'smooth'});}));
 // Focus changes and browser scroll anchoring must not cancel a manual demo action.
 addEventListener('wheel',resumeScroll,{passive:true});addEventListener('touchmove',resumeScroll,{passive:true});
 addEventListener('keydown',event=>{if(['PageDown','PageUp','ArrowDown','ArrowUp','Home','End',' '].includes(event.key)&&!(event.target instanceof HTMLInputElement)&&!(event.target instanceof HTMLTextAreaElement))resumeScroll();});
 addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);reduce.addEventListener('change',schedule);
 const change=document.createElement('button');change.type='button';change.className='sp-change';change.textContent='Algemeen voorbeeld · wijzigen';stage.querySelector('.us-sticky')!.prepend(change);
 const form=picker.querySelector('form')!;
 const companyInput=form.querySelector<HTMLInputElement>('[name="showcase-company"]')!;
 const other=form.querySelector<HTMLSelectElement>('[name="showcase-other"]')!;
 const radios=[...form.querySelectorAll<HTMLInputElement>('[name="showcase-branch"]')];
 const allowed=new Set([...other.options].map(o=>o.value).filter(Boolean));
 let branch='';
 function applySelection(value:string,company:string){
  branch=allowed.has(value)?value:'';
  const profile=profileForBranch(branch);
  const safeCompany=company.trim().slice(0,60);
  mountDemos(profile,safeCompany);
  stage.dataset.branch=branch;stage.dataset.profile=profile.id;
  titles[0]=safeCompany?`${safeCompany}. Drie bouwgebieden.`:'Drie bouwgebieden. Eén partner.';
  descriptions[0]=branch?(profile.id==='general'?`Voor ${branch}: bekijk een algemeen voorbeeld. Je exacte inrichting bepalen we samen.`:`Van klantvraag tot uitvoering. Een voorbeeld voor ${branch.toLocaleLowerCase('nl')}.`):'Scroll en zie hoe het samenkomt.';
  descriptions[1]=profile.id==='general'?'Telefonie en chat, met afgesproken acties en jouw team aan het roer.':profile.intent+'. Je team houdt de regie.';
  descriptions[2]=profile.id==='general'?'Van planning tot klantportaal. Gebouwd rondom jouw processen.':`${profile.module}, ${profile.document.toLocaleLowerCase('nl')} en klantportaal. In één werkplek.`;
  stage.querySelector('h2')!.textContent='';
  change.textContent=`${branch||'Algemeen voorbeeld'} · wijzigen`;
  picker.querySelector('.sp-feedback')!.textContent=branch?(profile.id==='general'?`Voor ${branch} tonen we nu het algemene voorbeeld. Jouw maatwerk werken we samen uit.`:`Jouw selectie: ${branch}. De AI-medewerker, software en website passen zich samen aan.`):'Drie voorbeelden. Afgestemd op jouw wereld.';
  radios.forEach(r=>r.checked=r.value===branch);other.value=radios.some(r=>r.checked)?'':branch;
  root!.querySelectorAll<HTMLAnchorElement>('[data-quiz-cta]').forEach(link=>{const url=new URL(link.href);if(branch)url.searchParams.set('branche',branch);else url.searchParams.delete('branche');link.href=url.pathname+url.search+url.hash;});
  // Only explicit choices are remembered in this tab. No provider call or lead creation.
  try{sessionStorage.setItem('ap-showcase-v1',JSON.stringify({branch,company:safeCompany}));}catch{/* Storage can be unavailable; the demo still works. */}
  schedule();
 }
 function enterStory(){stage.scrollIntoView({behavior:quiet()?'instant':'smooth',block:'start'});const heading=stage.querySelector<HTMLElement>('h2')!;heading.tabIndex=-1;heading.focus({preventScroll:true});}
 radios.forEach(r=>r.addEventListener('change',()=>applySelection(r.value,companyInput.value)));
 other.addEventListener('change',()=>applySelection(other.value,companyInput.value));
 companyInput.addEventListener('change',()=>applySelection(branch,companyInput.value));
 form.addEventListener('submit',event=>{event.preventDefault();applySelection(branch,companyInput.value);enterStory();});
 form.querySelector('.sp-skip')!.addEventListener('click',()=>{companyInput.value='';applySelection('','');enterStory();});
 change.addEventListener('click',()=>{picker.scrollIntoView({behavior:quiet()?'instant':'smooth',block:'start'});(radios.find(r=>r.checked)||other).focus({preventScroll:true});});
 try{const saved=JSON.parse(sessionStorage.getItem('ap-showcase-v1')||'null');if(saved&&typeof saved.branch==='string'&&typeof saved.company==='string'){companyInput.value=saved.company.slice(0,60);applySelection(saved.branch,companyInput.value);}}catch{/* Ignore corrupt or blocked session storage. */}
 root.querySelector('[data-cs-motion]')?.addEventListener('click',()=>requestAnimationFrame(schedule));schedule();
}
</script>
