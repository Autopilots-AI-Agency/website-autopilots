---
import '../../styles/home-cases.css';
---
<section id="ap-home-cases" aria-labelledby="hc-title">
 <header class="hc-heading"><p>ONS WERK</p><h2 id="hc-title">Voorbeeld cases per dienst</h2></header>
 <div class="hc-grid">
  <article class="hc-card">
   <header><img src="/samenwerkingen/animals-faith.png" alt="Animals Faith" loading="lazy"/></header>
   <div class="hc-art hc-call" role="img" aria-label="Illustratie van een AI-telefoongesprek"><div class="hc-call-disc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m8 3 3 5-2 2c1 3 2 4 5 5l2-2 5 3c-1 4-3 5-6 4C8 18 4 14 3 8c-1-3 1-5 5-5Z"/></svg></div><div class="hc-wave">{[10,20,32,18,40,26,34,18,28,14,8].map(h=><i style={`height:${h}px`}></i>)}</div></div>
   <div class="hc-copy"><p class="hc-type">AI Telefoniste</p><h3>Animals Faith</h3><p>Kwalificeert en plant afspraken.</p><div class="hc-result"><strong>300+</strong> afspraken in 2026</div></div>
   <footer><a href="/nl/cases/animals-faith/">Bekijk de case</a></footer>
  </article>
  <article class="hc-card">
   <header><img src="/samenwerkingen/dakcentrale-nederland.png" alt="Dakcentrale Nederland" loading="lazy"/></header>
   <div class="hc-art hc-software" role="img" aria-label="Conceptillustratie van CRM-software"><div class="hc-mini-app"><div class="hc-mini-nav"><i></i><i></i><i></i></div><div class="hc-mini-board">{[0,1,2].map(n=><div><span></span>{Array.from({length:n===1?2:3},()=> <i></i>)}</div>)}</div></div><small>Conceptvisual</small></div>
   <div class="hc-copy"><p class="hc-type">AI Software</p><h3>Dakcentrale Nederland</h3><p>Een eigen systeem voor jullie werk.</p><div class="hc-result">CRM op maat</div></div>
   <footer><span>Case binnenkort</span></footer>
  </article>
  <article class="hc-card">
   <header><img class="hc-h3a-logo" src="/samenwerkingen/h3a.png" alt="Heeren 3 Architecten" loading="lazy"/></header>
   <div class="hc-art hc-architecture" role="img" aria-label="Conceptillustratie van een architectuurwebsite"><div class="hc-mini-site"><div><b>HEEREN 3</b><i></i></div><svg viewBox="0 0 300 145" fill="none" aria-hidden="true"><path fill="#b6b19f" d="M48 55 192 25 260 51 115 83Z"/><path fill="#d6cfbf" d="M48 55 115 83 260 51V111L115 140 48 110Z"/><path fill="#344b48" d="M132 88 176 79V119L132 128ZM191 76 242 65V106L191 116ZM62 70 97 85V121L62 104Z"/><path stroke="#8f8774" d="m48 55 144-30 68 26-145 32Z"/></svg><span></span></div><small>Conceptvisual</small></div>
   <div class="hc-copy"><p class="hc-type">AI Website</p><h3>Heeren 3 Architecten</h3><p>Ontwerp en beheer, samen gebouwd.</p><div class="hc-result">Website met eigen backend</div></div>
   <footer><span>Case binnenkort</span></footer>
  </article>
 </div>
</section>
<script>
 const section=document.querySelector<HTMLElement>('#ap-home-cases');
 if(section){
  const cards=[...section.querySelectorAll<HTMLElement>('.hc-card')];
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  let frame=0;
  const activate=(index:number)=>cards.forEach((card,i)=>card.classList.toggle('hc-active',i===index));
  const draw=()=>{
   frame=0;
   if(reduced.matches||section.closest('.cs-quiet')){cards.forEach(card=>card.classList.remove('hc-active'));return;}
   const grid=section.querySelector<HTMLElement>('.hc-grid')!;
   const box=grid.getBoundingClientRect();
   if(innerWidth<=760){
    let nearest=0;let distance=Infinity;
    cards.forEach((card,i)=>{const r=card.getBoundingClientRect();const d=Math.abs(r.top+r.height/2-innerHeight/2);if(d<distance){distance=d;nearest=i;}});activate(nearest);
   }else{const progress=Math.max(0,Math.min(.999,(innerHeight*.75-box.top)/(innerHeight*.65+box.height*.25)));activate(Math.floor(progress*cards.length));}
  };
  const schedule=()=>{if(!frame)frame=requestAnimationFrame(draw);};
  addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);reduced.addEventListener('change',schedule);
  cards.forEach((card,i)=>{card.addEventListener('pointerenter',()=>{if(!reduced.matches&&!section.closest('.cs-quiet'))activate(i);});card.addEventListener('focusin',()=>activate(i));});
  section.addEventListener('pointerleave',schedule);
  const parent=section.closest('#ap-connected');if(parent)new MutationObserver(schedule).observe(parent,{attributes:true,attributeFilter:['class']});draw();
 }
</script>
