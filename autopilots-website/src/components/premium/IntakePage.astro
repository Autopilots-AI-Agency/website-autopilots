---
import '../../styles/exclusive-intake.css';
import '../../styles/premium-tokens.css';
import '../../styles/premium-intake.css';
import '../../styles/premium-warm.css';
import '../../styles/intake-bronze.css';
import Brand from '../../components/premium/Brand.astro';
import { intakeBranches } from '../../data/intakeBranches';
import { intakeTranslator } from '../../data/intake-i18n';
import { supportedLocales, getLocale, type SupportedLocale } from '../../i18n/languages';
import { localizedPath } from '../../i18n/routes';
const { locale = 'nl' } = Astro.props as { locale?: SupportedLocale };
const t = intakeTranslator(locale);
const branchNames = JSON.stringify(intakeBranches).replaceAll('<','\\u003c');
---
<!doctype html><html lang={getLocale(locale).tag}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{t("Jouw volgende digitale stap")} | Autopilots</title><meta name="description" content={t("Ontdek met een persoonlijke intake en websiteanalyse waar AI en software jouw bedrijf verder kunnen helpen.")}/><link rel="canonical" href={`https://auto-pilots.io${Astro.url.pathname}`}/><meta name="robots" content="noindex,nofollow"/><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Public+Sans:wght@400;500;600;700&family=Syne:wght@500;600&display=swap" rel="stylesheet"/></head><body style="margin:0"><main id="ap-intake" class="intake-bronze">
  <a class="intake-skip" href="#intake-questions">{t("Ga naar de vragen")}</a>
  <header><Brand href={`/${locale}/`}/><details class="scan-language"><summary aria-label={t("Taal")}>{locale.toUpperCase()} <span aria-hidden="true">⌄</span></summary><nav aria-label={t("Taal")}>{supportedLocales.map(language=><a href={`/${language.code}/ai-scan/`} lang={language.code} aria-current={language.code===locale?"page":undefined} title={t("De taal wijzigen begint een nieuwe scan.")} data-scan-language>{language.name}</a>)}</nav></details><span class="header-label">{t("Jouw bedrijf. Jouw volgende stap.")}</span><a class="home-link" href={`/${locale}/`}>{t("← Terug")}</a></header>
  <div class="intake-layout">
  <section id="intake-questions" class="intake-stage" aria-label={t("Persoonlijke intake")}><div class="step-meta"><span data-step-label>{t("Jouw vertrekpunt")}</span><span data-step-count>01 / 08</span></div><div class="progress-track" role="progressbar" aria-label={t("Voortgang van de vragen")} aria-valuemin="1" aria-valuemax="8" aria-valuenow="1"><i data-progress></i></div>
    <div class="question-view"><p class="eyebrow" data-eyebrow>{t("Een paar keuzes. Een helder vertrekpunt.")}</p><h1 data-question>{t("In welke branche werkt jouw bedrijf?")}</h1><p class="question-help" data-help>{t("Kies jouw branche. Zo maken we het advies passend bij jouw dagelijkse praktijk.")}</p><div class="branch-search"><label for="branch-query">{t("Zoek je branche")}</label><div><input id="branch-query" type="search" placeholder={t("Bijvoorbeeld dakdekkers of tandartsen")} autocomplete="off" aria-controls="branch-choices"/><span aria-hidden="true">⌕</span></div><p data-branch-count role="status" aria-live="polite"></p></div><div id="branch-choices" class="choices" data-choices></div>
    <form class="website-form" hidden><label for="website">{t("De website van je bedrijf")}</label><div class="url-input"><span>↗</span><input id="website" name="website" placeholder={t("jouwbedrijf.nl")} autocomplete="url" maxlength="300"/></div><label class="consent no-website"><input id="no-website" type="checkbox"/><span>{t("Ik heb nog geen website. Gebruik mijn antwoorden als vertrekpunt.")}</span></label><label class="consent"><input type="checkbox" name="consent"/><span>{t("Ik geef toestemming om mijn antwoorden en website-inhoud met OpenAI te verwerken voor dit advies. Ik voeg alleen informatie toe die hiervoor gebruikt mag worden.")}</span></label><p class="data-note">{t("Jouw gegevens blijven privé. We bewaren je intake pas bij Autopilots wanneer je zelf een gesprek aanvraagt.")}</p><button class="primary" type="submit">{t("Maak mijn persoonlijke analyse")}<span>↗</span></button></form>
    <p class="error" role="alert" hidden></p><div class="question-nav"><button type="button" class="back" hidden>{t("← Terug")}</button><button type="button" class="continue" hidden>{t("Verder")}<span>→</span></button></div></div>
    <div class="loading-view" hidden><div class="coffee-scene" aria-hidden="true"><svg viewBox="0 0 240 200" fill="none"><defs><linearGradient id="porcelain" x1="60" y1="75" x2="180" y2="150" gradientUnits="userSpaceOnUse"><stop stop-color="#fffdf7"/><stop offset="1" stop-color="#d9cbb6"/></linearGradient></defs><ellipse class="cup-shadow" cx="120" cy="168" rx="72" ry="9" fill="#705942" opacity=".08"/><ellipse cx="120" cy="156" rx="70" ry="13" fill="#f5efe5" stroke="#bca98a" stroke-width=".8"/><ellipse cx="120" cy="154" rx="49" ry="7" stroke="#d3c3ab" stroke-width=".7"/><path d="M164 91h15c23 0 23 39 0 39h-17" stroke="#c8b89e" stroke-width="8"/><path d="M164 91h15c23 0 23 39 0 39h-17" stroke="#f5efe4" stroke-width="5"/><path d="M69 82h101l-8 56c-2 23-82 23-85 0Z" fill="url(#porcelain)" stroke="#bba88b" stroke-width=".9"/><ellipse cx="119.5" cy="82" rx="50.5" ry="11" fill="#e9decc" stroke="#bba88b" stroke-width=".9"/><ellipse cx="119.5" cy="83" rx="44" ry="7" fill="#795b43"/><path d="M81 98l4 31" stroke="#fffdf8" stroke-width="2" stroke-linecap="round" opacity=".8"/><path class="steam steam-one" d="M102 60c-15-18 15-24 0-42" stroke="#a68c6b" stroke-width="1.2" stroke-linecap="round"/><path class="steam steam-two" d="M121 56c-15-18 15-24 0-42" stroke="#a68c6b" stroke-width="1.2" stroke-linecap="round"/><path class="steam steam-three" d="M140 60c-15-18 15-24 0-42" stroke="#a68c6b" stroke-width="1.2" stroke-linecap="round"/></svg><span class="coffee-orbit"></span></div><p class="eyebrow">{t("Een moment voor jouw volgende stap")}</p><h2 class="main-title">{t("Schenk gerust")}<br /><em>{t("een koffie in.")}</em></h2><p class="waiting-intro">{t("Wij kijken hoe software, een website of AI jouw bedrijf verder kan helpen. Met aandacht voor je website, je mensen en de keuzes die je net hebt gemaakt.")}</p><div class="waiting-note" role="status" aria-live="polite"><span class="waiting-dot" aria-hidden="true"></span><p data-waiting-message>{t("Je website en antwoorden vormen samen het vertrekpunt.")}</p></div><div class="waiting-line" aria-hidden="true"><i></i></div><small data-waiting-time>{t("Neem even de tijd. Je advies verschijnt hier vanzelf.")}</small></div>
    <section class="result-view" hidden aria-live="polite"><p class="eyebrow">{t("Jouw persoonlijke verkenning")}</p><h2 class="main-title" data-result-company></h2><p class="result-summary" data-result-summary></p><p class="assessment-note">{t("Een eerste persoonlijk advies op basis van wat je hebt gedeeld. De haalbaarheid en koppelingen bevestigen we samen.")}</p><div class="recommendations"></div><details class="evidence"><summary><span data-evidence-title>{t("Wat we op je website hebben gevonden")}</span> <span>+</span></summary><div data-observations></div></details><details class="evidence"><summary>{t("Dit willen we nog samen controleren")}<span>+</span></summary><ul data-unknowns></ul></details><div class="result-actions"><button class="primary" type="button" data-request-open>{t("Bespreek mijn analyse")}<span>↗</span></button><button class="download" type="button">{t("Download mijn advies ↓")}</button></div><form class="contact-form" hidden novalidate><h2>{t("Laten we de volgende stap bepalen.")}</h2><p>{t("We bewaren je antwoorden en advies bij je aanvraag, zodat het gesprek direct over jouw bedrijf gaat.")}</p><label>{t("Je naam")}<input name="name" autocomplete="name" maxlength="100" required/></label><label>{t("Zakelijk e-mailadres")}<input name="email" autocomplete="email" type="email" maxlength="160" required/></label><label class="consent"><input name="consent" type="checkbox" required/><span>{t("Autopilots mag mijn intake bewaren en contact opnemen over mijn aanvraag.")}</span></label><button class="primary" type="submit">{t("Verstuur mijn aanvraag")}<span>↗</span></button><p class="contact-status" role="status"></p></form><div class="saved-request" hidden><h2>{t("Je aanvraag is ontvangen.")}</h2><p>{t("Je intake en advies zijn bij je aanvraag opgeslagen. Kies hieronder een moment voor het gesprek.")}</p><a class="primary" data-booking target="_blank" rel="noopener">{t("Kies een gespreksmoment ↗")}</a></div><div class="report-footer"><span data-report-sources></span><button type="button" data-restart>{t("Opnieuw beginnen ↻")}</button></div></section>
  </section></div><footer><span>© {new Date().getFullYear()} Autopilots</span><span>{t("Strategie. AI-implementatie. Software.")}</span><a href={localizedPath("page.privacy",locale)}>{t("Privacy")}</a></footer>
</main><script type="application/json" id="intake-branches" set:html={branchNames}></script><script>
import { intakeTranslator } from '../../data/intake-i18n';
import { scanError } from '../../../netlify/functions/_shared/intake-i18n.mjs';
import { withCampaign } from '../../config/intake';
const locale=document.documentElement.lang.split("-")[0];
const t=intakeTranslator(locale);
import { intakeRoute, routeQuestions } from '../../data/intakeRoutes';
import { validIntakeBranch } from '../../data/intakeBranches';
const root=document.querySelector<HTMLElement>('#ap-intake')!;
const branches: string[]=JSON.parse(document.querySelector('#intake-branches')!.textContent!);
const steps=[
 {key:'sector',title:'In welke branche werkt jouw bedrijf?',help:'Kies jouw branche. Zo maken we het advies passend bij jouw dagelijkse praktijk.',options:[...branches,'Andere branche']},
 {key:'team',title:'Hoe groot is je team?',help:'Zo maken we het advies passend bij de mensen die ermee gaan werken.',options:['Ik werk zelfstandig','2–10 mensen','11–50 mensen','51–200 mensen','Meer dan 200 mensen']},
 {key:'goal',title:'Wat wil je voor jouw bedrijf realiseren?',help:'Kies maximaal drie ambities. We stemmen de vervolgvragen hierop af.',multi:true,options:['Software op maat laten bouwen','Een nieuwe of betere website','Werkprocessen automatiseren','Klantcontact met AI verbeteren','Planning en administratie vereenvoudigen','Meer uit aanvragen en leads halen']},
 {key:'channels',title:'Waar komen klanten bij je binnen?',help:'Kies alle kanalen die jullie gebruiken.',multi:true,options:['Telefoon','E-mail','WhatsApp','Website of contactformulier','Social media','Via mijn team of netwerk']},
 {key:'volume',title:'Hoeveel contactmomenten hebben jullie?',help:'Een schatting per week is genoeg. Zo voorkomen we een te grote of te kleine oplossing.',options:['Minder dan 25','25–100','100–500','Meer dan 500','Dat weet ik nog niet']},
 {key:'systems',title:'Hoe is het nu geregeld?',help:'Kies wat je herkent in jullie dagelijkse werk.',multi:true,options:['CRM of klantensysteem','Agenda of planningssoftware','Branche- of bedrijfssoftware','Spreadsheets en losse lijsten','Vooral handmatig','Dat wil ik samen uitzoeken']},
 {key:'timing',title:'Wanneer wil je de volgende stap zetten?',help:'We stemmen het vervolg af op jouw tempo.',options:['Zo snel mogelijk','Binnen 1–3 maanden','Later dit jaar','Ik verken eerst de mogelijkheden']},
 {key:'website',title:'Laat ons jouw vertrekpunt zien.',help:'Vul je websiteadres in of geef aan dat je nog geen website hebt. We verbinden dit met jouw ambities.'}
];
let current=0;const answers:Record<string,string|string[]>={};let report:any=null;let analysisId='';let requestId='';
const preselectedBranch=validIntakeBranch(new URLSearchParams(location.search).get('branche'));
if(preselectedBranch){answers.sector=preselectedBranch;current=1;}
const el=<T extends HTMLElement=HTMLElement>(s:string)=>root.querySelector<T>(s)!;
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
let submittingAnalysis=false;let navigating=false;let waitingTimer:ReturnType<typeof setInterval>|undefined;
function reveal(view:HTMLElement){if(!reducedMotion.matches){view.animate([{opacity:0,transform:'translateY(20px) scale(.985)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:550,easing:'cubic-bezier(.22,1,.36,1)'});view.querySelectorAll('.choice').forEach((choice,index)=>choice.animate([{opacity:0,transform:'translateY(14px)'},{opacity:1,transform:'translateY(0)'}],{duration:420,delay:Math.min(index,6)*35,easing:'cubic-bezier(.22,1,.36,1)',fill:'backwards'}));}}
async function navigate(next:number){if(navigating)return;navigating=true;const view=el('.question-view');root.setAttribute('aria-busy','true');if(!reducedMotion.matches)await view.animate([{opacity:1,transform:'translateY(0)'},{opacity:0,transform:'translateY(-7px)'}],{duration:170,easing:'ease-in',fill:'forwards'}).finished;current=next;render();view.getAnimations().forEach(a=>a.cancel());reveal(view);el('[data-question]').focus({preventScroll:true});if(window.innerWidth<681)el('.intake-stage').scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'start'});root.removeAttribute('aria-busy');navigating=false;}
function startWaiting(){root.classList.add('is-analyzing');el('[data-step-label]').textContent=t('Met aandacht voor jouw bedrijf');el('[data-step-count]').textContent=t('EVEN EEN MOMENT');el('[data-waiting-time]').textContent=t('Neem even de tijd. Je advies verschijnt hier vanzelf.');const messages=['Je website en antwoorden vormen samen het vertrekpunt.','Een goede oplossing begint bij begrijpen hoe je werkt.','We zoeken een passende eerste stap, met heldere voorwaarden.','Software, websites en AI. Gebouwd rondom jouw manier van werken.'].map(message=>t(message));let tick=0;el('[data-waiting-message]').textContent=messages[0];reveal(el('.loading-view'));if(window.innerWidth<681)el('.intake-stage').scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'start'});waitingTimer=setInterval(()=>{tick++;const text=el('[data-waiting-message]');text.textContent=messages[tick%messages.length];reveal(text);if(tick>=7)el('[data-waiting-time]').textContent=t('Het duurt iets langer. We zijn nog bezig met je advies.');},6500);}
function stopWaiting(){if(waitingTimer)clearInterval(waitingTimer);root.classList.remove('is-analyzing');}
function error(message=''){el('.error').textContent=message?scanError(message,locale):'';el('.error').hidden=!message;}
function normalizeBranch(value:string){return value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();}
function getStep(index:number){const step=steps[index];if(index>=3&&index<=5)return {...step,...routeQuestions[intakeRoute(answers.goal as string[]||[])][index-3]};return step;}
el<HTMLInputElement>('#branch-query').addEventListener('input',render);
el<HTMLInputElement>('#no-website').addEventListener('change',event=>{const checked=(event.target as HTMLInputElement).checked;el<HTMLInputElement>('#website').disabled=checked;});
function render(){error();el('.progress-track').setAttribute('aria-valuenow',String(current+1));const step=getStep(current);el('[data-question]').textContent=t(step.title);el('[data-help]').textContent=t(step.help);el('[data-step-count]').textContent=`0${current+1} / 08`;el('[data-step-label]').textContent=t(current===7?'Jouw website':'Jouw vertrekpunt');el('[data-progress]').style.width=`${(current+1)/8*100}%`;el('.back').hidden=current===0;el('.continue').hidden=!step.multi;el('.website-form').hidden=current!==7;el('[data-choices]').hidden=current===7;el('[data-eyebrow]').textContent=t(step.multi?'Een paar keuzes. Jouw prioriteiten.':'Een paar keuzes. Een helder vertrekpunt.');el('[data-choices]').replaceChildren();
 const isBranch=step.key==='sector';el('.branch-search').hidden=!isBranch;el('[data-choices]').classList.toggle('branch-list',isBranch);const query=normalizeBranch(el<HTMLInputElement>('#branch-query').value);const options=(step.options||[]).filter(label=>!isBranch||!query||label==='Andere branche'||normalizeBranch(t(label)).includes(query));const count=options.filter(label=>label!=='Andere branche').length;if(isBranch)el('[data-branch-count]').textContent=query?(count?`${count} ${t(count===1?'branche gevonden':'branches gevonden')}`:t('Je branche niet gevonden? Kies Andere branche.')):t('Alle {count} branches van Autopilots',{count:branches.length});
  options.forEach((label,index)=>{const button=document.createElement('button');button.type='button';button.className='choice';const n=document.createElement('span');n.className='choice-number';n.textContent=String(index+1).padStart(2,"0");const text=document.createElement('span');text.textContent=t(label);const arrow=document.createElement('b');arrow.textContent=step.multi?'+':'↗';button.append(n,text,arrow);const selected=step.multi?(answers[step.key] as string[]||[]).includes(label):answers[step.key]===label;button.setAttribute('aria-pressed',String(selected));button.addEventListener('click',()=>{if(navigating)return;if(step.multi){if(step.key==="goal"){delete answers.channels;delete answers.volume;delete answers.systems;}const picked=answers[step.key] as string[]||[];if(picked.includes(label))answers[step.key]=picked.filter(v=>v!==label);else if(step.key==='goal'&&picked.length>=3){error('Kies maximaal drie prioriteiten.');return;}else answers[step.key]=[...picked,label];render();el("[data-choices]").querySelectorAll<HTMLButtonElement>("button")[index]?.focus({preventScroll:true});}else{answers[step.key]=label;button.setAttribute("aria-pressed","true");void navigate(current+1);}});el('[data-choices]').append(button);});el('[data-question]').tabIndex=-1;
}
el('.back').addEventListener('click',()=>{if(current>0)void navigate(current-1);});el('.continue').addEventListener('click',()=>{if(!(answers[steps[current].key] as string[])?.length){error('Kies minstens één optie.');return;}void navigate(current+1);});
el<HTMLFormElement>('.website-form').addEventListener('submit',async event=>{event.preventDefault();if(submittingAnalysis)return;error();const website=el<HTMLInputElement>('#website').value.trim();if(!website&&!el<HTMLInputElement>("#no-website").checked){error('Vul je websiteadres in of kies ‘Ik heb nog geen website’.');return;}if(!el<HTMLInputElement>('[name="consent"]').checked){error('Bevestig de toestemming om je analyse te maken.');return;}answers.focusRoute=intakeRoute(answers.goal as string[]||[]);answers.detailQuestion=getStep(3).title;answers.scaleQuestion=getStep(4).title;answers.systemsQuestion=getStep(5).title;submittingAnalysis=true;el<HTMLButtonElement>('.website-form button[type="submit"]').disabled=true;analysisId=crypto.randomUUID();el('.question-view').hidden=true;el('.loading-view').hidden=false;startWaiting();try{const response=await fetch('/.netlify/functions/website-analysis',{method:'POST',headers:{'Content-Type':'application/json','X-Autopilots-Locale':locale,'Idempotency-Key':analysisId},body:JSON.stringify({locale,website,noWebsite:el<HTMLInputElement>("#no-website").checked,answers,consent:true})});const data=await response.json();if(!response.ok)throw new Error(data.message);report=data;showReport();}catch(e){el('.question-view').hidden=false;error((e as Error).message||'De analyse is niet beschikbaar. Probeer opnieuw.');}finally{submittingAnalysis=false;el<HTMLButtonElement>('.website-form button[type="submit"]').disabled=false;stopWaiting();el('.loading-view').hidden=true;if(!el('.question-view').hidden){el('[data-step-label]').textContent=t('Jouw website');el('[data-step-count]').textContent=t('08 / 08');reveal(el('.question-view'));}}});
function paragraph(text:string,tag='p'){const item=document.createElement(tag);item.textContent=t(text);return item;}
function showReport(){const r=report.report;el(".assessment-note").textContent=report.notice||t("Een eerste persoonlijk advies op basis van wat je hebt gedeeld. De haalbaarheid en koppelingen bevestigen we samen.");el("[data-observations]").closest<HTMLDetailsElement>("details")!.hidden=!r.observations.length;el("[data-evidence-title]").textContent=t(el<HTMLInputElement>("#no-website").checked?"Waar dit advies op is gebaseerd":"Wat we op je website hebben gevonden");el('.result-view').hidden=false;el('[data-step-label]').textContent=t('Jouw persoonlijke advies');el('[data-step-count]').textContent=t('COMPLEET');el('[data-progress]').style.width='100%';el('[data-result-company]').textContent=r.company;el('[data-result-summary]').textContent=r.summary;el('.recommendations').replaceChildren();r.recommendations.forEach((rec:any,index:number)=>{const article=document.createElement('article');article.className='recommendation';article.append(paragraph(`0${index+1} / ${t(rec.solution)}`,'small'),paragraph(rec.title,'h2'),paragraph(rec.why));const flow=document.createElement('ol');flow.className='workflow';rec.workflow.forEach((s:string)=>flow.append(paragraph(s,'li')));article.append(flow,paragraph(rec.benefit));const details=document.createElement('details');details.append(paragraph('Wat hiervoor nodig is','summary'));const list=document.createElement('ul');rec.conditions.forEach((c:string)=>list.append(paragraph(c,'li')));details.append(list);article.append(details);el('.recommendations').append(article);});el('[data-observations]').replaceChildren();r.observations.forEach((o:any)=>{const item=document.createElement('article');item.append(paragraph(o.finding),paragraph(`“${o.evidence}”`,'blockquote'),paragraph(o.source,'small'));el('[data-observations]').append(item);});el('[data-unknowns]').replaceChildren();r.unknowns.forEach((s:string)=>el('[data-unknowns]').append(paragraph(s,'li')));el('[data-report-sources]').textContent=`${report.sources.length?report.sources.length+" "+t("bron(nen)"):t("Op basis van jouw antwoorden")} · ${new Date(report.generatedAt).toLocaleDateString(locale)}`;el('[data-result-company]').tabIndex=-1;el('[data-result-company]').focus({preventScroll:true});reveal(el('.result-view'));el('.intake-stage').scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'start'});}
el('.download').addEventListener('click',()=>{const r=report.report;const text=[`AUTOPILOTS — ${r.company}`,r.summary,report.notice||"",t('Voorlopig persoonlijk advies. Haalbaarheid samen bevestigen.'),...r.recommendations.flatMap((rec:any)=>[rec.title,t(rec.solution),rec.why,...rec.workflow,rec.benefit,t('Voorwaarden:'),...rec.conditions]),t('Nog te controleren:'),...r.unknowns,t('Bronnen:'),...report.sources,t('Jouw antwoorden:'),...steps.filter(step=>step.key in answers).map(step=>`${t(getStep(steps.indexOf(step)).title)}: ${Array.isArray(answers[step.key])?(answers[step.key] as string[]).map(value=>t(value)).join(', '):t(String(answers[step.key]))}`)].join('\n\n');const url=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download=`autopilots-${locale}-advies.txt`;link.click();URL.revokeObjectURL(url);});
el('[data-request-open]').addEventListener('click',()=>{el('.contact-form').hidden=false;el<HTMLInputElement>('.contact-form [name="name"]').focus();});
el<HTMLFormElement>('.contact-form').addEventListener('submit',async event=>{event.preventDefault();const form=event.target as HTMLFormElement;const name=form.elements.namedItem('name') as HTMLInputElement;const email=form.elements.namedItem('email') as HTMLInputElement;const consent=form.elements.namedItem('consent') as HTMLInputElement;if(name.value.trim().length<2||!email.validity.valid||!email.value||!consent.checked){el('.contact-status').textContent=t('Controleer je naam, e-mailadres en toestemming.');return;}const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;button.disabled=true;requestId ||= crypto.randomUUID();el('.contact-status').textContent=t('Je aanvraag wordt opgeslagen…');try{const response=await fetch('/.netlify/functions/analysis-request',{method:'POST',headers:{'Content-Type':'application/json','X-Autopilots-Locale':locale,'Idempotency-Key':requestId},body:JSON.stringify({analysisId,token:report.token,name:(form.elements.namedItem('name') as HTMLInputElement).value,email:(form.elements.namedItem('email') as HTMLInputElement).value,consent:(form.elements.namedItem('consent') as HTMLInputElement).checked})});const data=await response.json();if(!response.ok)throw new Error(data.message);el('.contact-form').hidden=true;el('.result-actions').hidden=true;el('.saved-request').hidden=false;el<HTMLAnchorElement>('[data-booking]').href=data.bookingUrl;}catch(e){el('.contact-status').textContent=scanError((e as Error).message,locale,'Je aanvraag kon niet worden opgeslagen. Probeer opnieuw.');}finally{button.disabled=false;}});
document.querySelectorAll<HTMLAnchorElement>('[data-scan-language]').forEach(link=>{link.href=withCampaign(link.getAttribute('href')!,location.search);if(preselectedBranch){const url=new URL(link.href);url.searchParams.set('branche',preselectedBranch);link.href=url.href;}});
el('[data-restart]').addEventListener('click',()=>location.reload());render();reveal(el('.question-view'));window.addEventListener('pagehide',stopWaiting);
</script></body></html>
