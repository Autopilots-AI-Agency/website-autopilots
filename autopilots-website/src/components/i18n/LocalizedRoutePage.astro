const name = product ? ui.products[product.slug] : nicheContent ? nicheContent.name : ({
  "page.products":ui.navigation.products,"page.niches":ui.navigation.niches,"page.crew":ui.navigation.crew,"page.knowledge":ui.navigation.knowledge,"page.appointment":ui.navigation.appointment
} as Record<string,string>)[family.id] ?? pageNames[locale][family.id] ?? (family.type === "article" ? articleTitles[locale][family.id] ?? segmentLabel : "Autopilots");
const eyebrow = product ? ui.navigation.products : niche ? ui.navigation.niches : family.type === "article" ? ui.navigation.knowledge : "Autopilots";
const lead = product ? localizedProductPromise(locale, product.slug, strings.productText) : nicheContent ? nicheContent.lead : family.type === "article" ? articleLead[locale] : pageLeads[locale][family.id] ?? strings.overview;
const parentId = product ? "page.products" : niche ? "page.niches" : family.type === "article" ? "page.knowledge" : "page.home";
---

{family.id === "landing.autobedrijven-ai-medewerker" ? <CampaignEntryPage locale={locale} /> : family.id === "landing.autobedrijven-ai-medewerker-ervaring" ? <CampaignExperiencePage locale={locale} /> : family.id === "landing.autobedrijven-voorstel" ? <ProposalPage locale={locale} /> : family.id === "page.crew" ? <CrewPage locale={locale} /> : family.id === "page.products" ? <ProductsPage locale={locale} /> : family.id === "page.appointment" ? <AppointmentPage locale={locale} /> : family.id === "page.privacy" ? <PrivacyPage locale={locale} /> : family.id === "page.terms" ? <TermsPage locale={locale} /> : family.id === "page.knowledge" ? <KnowledgePage locale={locale} /> : family.id === "page.knowledge.ai" ? <AiKnowledgePage locale={locale} /> : family.id === "page.knowledge.autopilots" ? <AutopilotsKnowledgePage locale={locale} /> : family.id === "page.niches" ? <NichesPage locale={locale} /> : product ? <ProductPage product={product} locale={locale} /> : niche ? <NichePage niche={niche} locale={locale} /> : article ? <KnowledgeArticlePage article={article} locale={locale}/> : <BaseLayout title={`${name} | Autopilots ${locale.toUpperCase()}`} description={lead} canonical={localizedPath(family.id,locale)} locale={locale} contentId={family.id} noindex={locale !== "nl"}>
  <section class="ap-route-hero"><div class="ap-container"><div class="ap-route-icon">{product && <VisualIcon type="product" name={product.slug}/>} {niche && <VisualIcon type="niche" name={niche.slug}/>}</div><div class="ap-kicker">{eyebrow}</div><h1>{name}</h1><p>{product ? strings.product : niche ? strings.niche : strings.overview}</p><div class="ap-actions"><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{ui.navigation.appointment}</a><a class="ap-button ap-button-secondary" href={localizedPath(parentId,locale)}>{strings.back}</a></div></div></section>
  <section class="ap-section"><div class="ap-container"><div class="ap-route-story"><div><div class="ap-kicker">{strings.how}</div><h2>{lead}</h2></div><ol>{strings.steps.map((step,index)=><li><span>{String(index+1).padStart(2,"0")}</span><strong>{step}</strong></li>)}</ol></div></div></section>
  <section class="ap-section"><div class="ap-container"><div class="ap-route-fit"><div><div class="ap-kicker">Autopilots</div><h2>{strings.fit}</h2><p>{strings.fitText}</p></div><aside><strong>{strings.ready}</strong><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{ui.navigation.appointment}</a></aside></div></div></section>
</BaseLayout>}

