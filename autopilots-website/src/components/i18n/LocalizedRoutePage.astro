---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VisualIcon from "../ui/VisualIcon.astro";
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import { knowledgeArticles } from "../../content/knowledgeArticles";
import type { SupportedLocale } from "../../i18n/languages";
import type { RouteFamily } from "../../i18n/routes";
import { localizedPath } from "../../i18n/routes";
import { uiCopy } from "../../i18n/ui";
import { localizedNiche, localizedProductPromise } from "../../i18n/catalog";
import CrewPage from "../../pages/crew/index.astro";
import NichesPage from "../../pages/voor-wie/index.astro";
import NichePage from "../ecosystem/NichePage.astro";
import ProductPage from "../ecosystem/ProductPage.astro";
import ProductsPage from "../../pages/producten/index.astro";
import AppointmentPage from "../../pages/afspraak/index.astro";
import PrivacyPage from "../../pages/privacy/index.astro";
import TermsPage from "../../pages/voorwaarden/index.astro";
import KnowledgePage from "../../pages/kennisbank/index.astro";
import AiKnowledgePage from "../../pages/kennisbank/ai/index.astro";
import AutopilotsKnowledgePage from "../../pages/kennisbank/autopilots/index.astro";
import KnowledgeArticlePage from "../../pages/kennisbank/[slug]/index.astro";
import CampaignEntryPage from "../../pages/lp/autobedrijven/ai-medewerker/index.astro";
import CampaignExperiencePage from "../../pages/lp/autobedrijven/ai-medewerker/ervaring/index.astro";
import ProposalPage from "../../pages/voorstel/autobedrijven/index.astro";

interface Props { locale: SupportedLocale; family: RouteFamily }
const { locale, family } = Astro.props;
const ui = uiCopy[locale];
const strings = {
  nl:{product:"Een concrete AI-rol voor klantcontact",productText:"Ingericht op jullie vragen, systemen, uitzonderingen en menselijke overdracht. De AI handelt af wat kan en legt iedere uitkomst vast.",niche:"AI voor de dagelijkse praktijk",nicheText:"Een branchespecifieke klantreis die vragen begrijpt, gericht doorvraagt en direct de juiste vervolgactie uitvoert.",how:"Van klantvraag naar systeemactie",steps:["Contact komt binnen","AI begrijpt en vraagt door","Afspraak, taak of overdracht wordt uitgevoerd"],fit:"Wat we samen inrichten",fitText:"Kennis, tone of voice, koppelingen, privacygrenzen, uitzonderingen en de momenten waarop een collega het overneemt.",ready:"Klaar om de juiste route te bepalen?",overview:"Bekijk hoe Autopilots klantcontact omzet naar concrete acties.",back:"Terug naar overzicht"},
  en:{product:"A focused AI role for customer contact",productText:"Configured around your questions, systems, exceptions and human handover. The AI handles what it can and records every outcome.",niche:"AI for day-to-day operations",nicheText:"An industry-specific customer journey that understands questions, asks for the right details and carries out the next action.",how:"From customer question to system action",steps:["Contact arrives","AI understands and asks","Appointment, task or handover is completed"],fit:"What we configure together",fitText:"Knowledge, tone of voice, integrations, privacy boundaries, exceptions and the moments when a colleague takes over.",ready:"Ready to define the right route?",overview:"See how Autopilots turns customer contact into concrete actions.",back:"Back to overview"},
  es:{product:"Una función de IA concreta para la atención al cliente",productText:"Configurada según tus preguntas, sistemas, excepciones y transferencia humana. La IA gestiona lo que puede y registra cada resultado.",niche:"IA para la operativa diaria",nicheText:"Un recorrido específico para el sector que entiende preguntas, solicita los datos correctos y ejecuta la siguiente acción.",how:"De la consulta a la acción en el sistema",steps:["Llega el contacto","La IA entiende y pregunta","Se completa la cita, tarea o transferencia"],fit:"Lo que configuramos juntos",fitText:"Conocimiento, tono de voz, integraciones, límites de privacidad, excepciones y los momentos en que interviene una persona.",ready:"¿Definimos la ruta adecuada?",overview:"Descubre cómo Autopilots convierte el contacto en acciones concretas.",back:"Volver al resumen"},
  de:{product:"Eine klare KI-Rolle für den Kundenkontakt",productText:"Abgestimmt auf Fragen, Systeme, Ausnahmen und menschliche Übergabe. Die KI erledigt, was möglich ist, und dokumentiert jedes Ergebnis.",niche:"KI für den Arbeitsalltag",nicheText:"Eine branchenspezifische Customer Journey, die Fragen versteht, gezielt nachfragt und direkt die nächste Aktion ausführt.",how:"Von der Kundenfrage zur Systemaktion",steps:["Kontakt geht ein","KI versteht und fragt nach","Termin, Aufgabe oder Übergabe wird ausgeführt"],fit:"Was wir gemeinsam einrichten",fitText:"Wissen, Tonalität, Integrationen, Datenschutzgrenzen, Ausnahmen und die Zeitpunkte der menschlichen Übernahme.",ready:"Bereit für die passende Route?",overview:"Erfahren Sie, wie Autopilots Kundenkontakte in konkrete Aktionen verwandelt.",back:"Zurück zur Übersicht"},
  it:{product:"Un ruolo AI concreto per il contatto clienti",productText:"Configurato su domande, sistemi, eccezioni e passaggio umano. L'AI gestisce ciò che può e registra ogni risultato.",niche:"AI per il lavoro quotidiano",nicheText:"Un customer journey specifico per il settore che comprende le richieste, pone le domande corrette ed esegue l'azione successiva.",how:"Dalla domanda all'azione nel sistema",steps:["Arriva il contatto","L'AI comprende e approfondisce","Appuntamento, attività o passaggio vengono completati"],fit:"Cosa configuriamo insieme",fitText:"Conoscenza, tone of voice, integrazioni, limiti di privacy, eccezioni e momenti in cui interviene una persona.",ready:"Pronti a definire il percorso giusto?",overview:"Scopri come Autopilots trasforma il contatto clienti in azioni concrete.",back:"Torna alla panoramica"},
  fr:{product:"Un rôle IA précis pour la relation client",productText:"Configuré selon vos questions, systèmes, exceptions et transferts humains. L'IA traite ce qu'elle peut et enregistre chaque résultat.",niche:"L'IA au service des opérations quotidiennes",nicheText:"Un parcours propre au secteur qui comprend les demandes, pose les bonnes questions et exécute l'action suivante.",how:"De la demande à l'action dans le système",steps:["Le contact arrive","L'IA comprend et questionne","Le rendez-vous, la tâche ou le transfert est effectué"],fit:"Ce que nous configurons ensemble",fitText:"Connaissances, ton, intégrations, limites de confidentialité, exceptions et moments où un collaborateur prend le relais.",ready:"Prêt à définir le bon parcours ?",overview:"Découvrez comment Autopilots transforme la relation client en actions concrètes.",back:"Retour à la vue d'ensemble"}
}[locale];

const productSlug = family.type === "product" ? family.id.replace("product.","") : "";
const product = products.find(item=>item.slug===productSlug);
const nicheSlug = family.type === "niche" ? family.id.replace("niche.","") : "";
const niche = niches.find(item=>item.slug===nicheSlug);
const article = family.type === "article" ? knowledgeArticles.find(item=>`article.${item.slug}`===family.id) : undefined;
const segmentLabel = family.segments[locale].split("/").at(-1)!.replaceAll("-"," ").replace(/(^|\s)\p{L}/gu,l=>l.toUpperCase());
const nicheContent = niche ? localizedNiche(locale, niche.slug, locale === "nl" ? niche.name : segmentLabel) : undefined;
const pageNames: Record<SupportedLocale, Record<string,string>> = {
  nl: {"page.knowledge.ai":"AI kennis","page.knowledge.autopilots":"Autopilots kennis","page.privacy":"Privacy","page.terms":"Voorwaarden"},
  en: {"page.knowledge.ai":"AI knowledge","page.knowledge.autopilots":"Autopilots knowledge","page.privacy":"Privacy","page.terms":"Terms and conditions"},
  es: {"page.knowledge.ai":"Conocimientos sobre IA","page.knowledge.autopilots":"Conocimientos de Autopilots","page.privacy":"Privacidad","page.terms":"Términos y condiciones"},
  de: {"page.knowledge.ai":"KI-Wissen","page.knowledge.autopilots":"Autopilots Wissen","page.privacy":"Datenschutz","page.terms":"Allgemeine Bedingungen"},
  it: {"page.knowledge.ai":"Conoscenza sull'AI","page.knowledge.autopilots":"Conoscenza Autopilots","page.privacy":"Privacy","page.terms":"Termini e condizioni"},
  fr: {"page.knowledge.ai":"Connaissances sur l'IA","page.knowledge.autopilots":"Connaissances Autopilots","page.privacy":"Confidentialité","page.terms":"Conditions générales"},
};
const pageLeads: Record<SupportedLocale, Record<string,string>> = {
