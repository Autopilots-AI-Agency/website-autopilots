---
import type { RouteFamily } from "../../i18n/routes";
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import { knowledgeArticles } from "../../content/knowledgeArticles";
import ProductsPage from "../../pages/producten/index.astro";
import ProductPage from "../ecosystem/ProductPage.astro";
import NichesPage from "../../pages/voor-wie/index.astro";
import NichePage from "../ecosystem/NichePage.astro";
import CrewPage from "../../pages/crew/index.astro";
import KnowledgePage from "../../pages/kennisbank/index.astro";
import AiKnowledgePage from "../../pages/kennisbank/ai/index.astro";
import AutopilotsKnowledgePage from "../../pages/kennisbank/autopilots/index.astro";
import KnowledgeArticlePage from "../../pages/kennisbank/[slug]/index.astro";
import AppointmentPage from "../../pages/afspraak/index.astro";
import PrivacyPage from "../../pages/privacy/index.astro";
import TermsPage from "../../pages/voorwaarden/index.astro";
import CampaignEntryPage from "../../pages/lp/autobedrijven/ai-medewerker/index.astro";
import CampaignExperiencePage from "../../pages/lp/autobedrijven/ai-medewerker/ervaring/index.astro";
import ProposalPage from "../../pages/voorstel/autobedrijven/index.astro";

interface Props { family: RouteFamily }
const { family } = Astro.props;
const product = family.type === "product" ? products.find((item) => `product.${item.slug}` === family.id) : undefined;
const niche = family.type === "niche" ? niches.find((item) => `niche.${item.slug}` === family.id) : undefined;
const article = family.type === "article" ? knowledgeArticles.find((item) => `article.${item.slug}` === family.id) : undefined;
---

{family.id === "page.products" && <ProductsPage />}
{product && <ProductPage product={product} />}
{family.id === "page.niches" && <NichesPage />}
{niche && <NichePage niche={niche} />}
{family.id === "page.crew" && <CrewPage />}
{family.id === "page.knowledge" && <KnowledgePage />}
{family.id === "page.knowledge.ai" && <AiKnowledgePage />}
{family.id === "page.knowledge.autopilots" && <AutopilotsKnowledgePage />}
{article && <KnowledgeArticlePage article={article} />}
{family.id === "page.appointment" && <AppointmentPage />}
{family.id === "page.privacy" && <PrivacyPage />}
{family.id === "page.terms" && <TermsPage />}
{family.id === "landing.autobedrijven-ai-medewerker" && <CampaignEntryPage locale="nl" />}
{family.id === "landing.autobedrijven-ai-medewerker-ervaring" && <CampaignExperiencePage locale="nl" />}
{family.id === "landing.autobedrijven-voorstel" && <ProposalPage locale="nl" />}
