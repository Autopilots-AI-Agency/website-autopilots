---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import VisualIcon from "../ui/VisualIcon.astro";
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { uiCopy } from "../../i18n/ui";
import { localizedNiche } from "../../i18n/catalog";

interface Props { locale: SupportedLocale }
const { locale } = Astro.props;
const ui = uiCopy[locale];
const text = {
  nl: { panelLabel:"Autopilots proces", heroFlow:[["Lead komt binnen","Website, advertenties of telefoon"],["AI kwalificeert","Context, behoefte en timing"],["Afspraak gepland","Direct in agenda en CRM"],["Opvolging loopt","Geen kans blijft liggen"]], productsLead:"Onze concrete rollen die samenwerken binnen één klantreis.", view:"Bekijk", flow:"Zo werkt het samen", flowTitle:"Van eerste vraag naar afspraak, taak of klant.", steps:[["Contact komt binnen","E-mail, WhatsApp, formulier of telefoon."],["AI begrijpt de context","De juiste vragen, kennis en afspraken worden gebruikt."],["Systeem voert de actie uit","CRM, agenda en team krijgen de complete uitkomst."]], industries:"Gebouwd voor uw dagelijkse praktijk", industriesLead:"Iedere branche krijgt eigen vragen, uitzonderingen, systemen en overdrachtsregels.", route:"Bekijk de route", allNiches:"Bekijk alle branches", delivery:"Van intake naar live in 2–4 weken", deliveryText:"Na complete aanlevering ontwerpen, koppelen, testen en lanceren we gecontroleerd. Privacy by design en menselijke overdracht zijn onderdeel van iedere stap.", cta:"Bekijk het proces" },
  en: { panelLabel:"Autopilots process", heroFlow:[["Lead arrives","Website, ads or phone"],["AI qualifies","Context, need and timing"],["Appointment scheduled","Directly in calendar and CRM"],["Follow-up continues","No opportunity is left behind"]], productsLead:"Our focused roles working together across one customer journey.", view:"View", flow:"How it works together", flowTitle:"From first question to appointment, task or customer.", steps:[["Contact arrives","Email, WhatsApp, form or phone."],["AI understands context","It uses the right questions, knowledge and rules."],["The system takes action","CRM, calendar and team receive the complete outcome."]], industries:"Built around daily operations", industriesLead:"Every industry gets its own questions, exceptions, systems and handover rules.", route:"View the journey", allNiches:"View all industries", delivery:"From intake to live in 2–4 weeks", deliveryText:"Once inputs are complete, we design, connect, test and launch in a controlled way. Privacy by design and human handover are built into every step.", cta:"View the process" },
  es: { panelLabel:"Proceso Autopilots", heroFlow:[["Llega el lead","Web, anuncios o teléfono"],["La IA cualifica","Contexto, necesidad y momento"],["Cita programada","Directamente en agenda y CRM"],["El seguimiento continúa","Ninguna oportunidad se pierde"]], productsLead:"Nuestras funciones concretas que colaboran en un mismo recorrido de cliente.", view:"Ver", flow:"Cómo colaboran", flowTitle:"De la primera consulta a una cita, tarea o cliente.", steps:[["Llega el contacto","Email, WhatsApp, formulario o teléfono."],["La IA entiende el contexto","Utiliza las preguntas, el conocimiento y las reglas correctas."],["El sistema actúa","El CRM, la agenda y el equipo reciben el resultado completo."]], industries:"Diseñado para la operativa diaria", industriesLead:"Cada sector tiene sus propias preguntas, excepciones, sistemas y reglas de transferencia.", route:"Ver el recorrido", allNiches:"Ver todos los sectores", delivery:"De la toma de datos a producción en 2–4 semanas", deliveryText:"Con toda la información disponible, diseñamos, conectamos, probamos y lanzamos de forma controlada. La privacidad y la transferencia humana forman parte de cada paso.", cta:"Ver el proceso" },
  de: { panelLabel:"Autopilots Prozess", heroFlow:[["Lead geht ein","Website, Anzeigen oder Telefon"],["KI qualifiziert","Kontext, Bedarf und Zeitpunkt"],["Termin geplant","Direkt in Kalender und CRM"],["Nachverfolgung läuft","Keine Chance bleibt liegen"]], productsLead:"Unsere klaren Rollen, die in einer Customer Journey zusammenarbeiten.", view:"Ansehen", flow:"So arbeitet alles zusammen", flowTitle:"Von der ersten Frage zum Termin, zur Aufgabe oder zum Kunden.", steps:[["Kontakt geht ein","E-Mail, WhatsApp, Formular oder Telefon."],["KI versteht den Kontext","Sie nutzt die richtigen Fragen, Kenntnisse und Regeln."],["Das System handelt","CRM, Kalender und Team erhalten das vollständige Ergebnis."]], industries:"Für den Arbeitsalltag entwickelt", industriesLead:"Jede Branche erhält eigene Fragen, Ausnahmen, Systeme und Übergaberegeln.", route:"Journey ansehen", allNiches:"Alle Branchen ansehen", delivery:"Von der Aufnahme bis live in 2–4 Wochen", deliveryText:"Nach vollständiger Bereitstellung entwickeln, verbinden, testen und starten wir kontrolliert. Privacy by Design und menschliche Übergabe gehören zu jedem Schritt.", cta:"Prozess ansehen" },
  it: { panelLabel:"Processo Autopilots", heroFlow:[["Arriva il lead","Sito, annunci o telefono"],["L'AI qualifica","Contesto, esigenza e tempi"],["Appuntamento fissato","Direttamente in agenda e CRM"],["Il follow-up continua","Nessuna opportunità viene persa"]], productsLead:"I nostri ruoli concreti che collaborano in un unico customer journey.", view:"Scopri", flow:"Come collaborano", flowTitle:"Dal primo contatto a un appuntamento, un'attività o un cliente.", steps:[["Arriva il contatto","Email, WhatsApp, modulo o telefono."],["L'AI comprende il contesto","Usa domande, conoscenze e regole corrette."],["Il sistema agisce","CRM, agenda e team ricevono il risultato completo."]], industries:"Progettato per il lavoro quotidiano", industriesLead:"Ogni settore ha domande, eccezioni, sistemi e regole di passaggio specifiche.", route:"Scopri il percorso", allNiches:"Vedi tutti i settori", delivery:"Dall'analisi al go-live in 2–4 settimane", deliveryText:"Con tutti gli elementi disponibili, progettiamo, colleghiamo, testiamo e lanciamo in modo controllato. Privacy by design e passaggio umano sono inclusi in ogni fase.", cta:"Scopri il processo" },
  fr: { panelLabel:"Processus Autopilots", heroFlow:[["Le lead arrive","Site web, publicité ou téléphone"],["L'IA qualifie","Contexte, besoin et calendrier"],["Rendez-vous planifié","Directement dans l'agenda et le CRM"],["Le suivi continue","Aucune opportunité n'est oubliée"]], productsLead:"Nos rôles précis qui collaborent dans un même parcours client.", view:"Découvrir", flow:"Comment tout fonctionne ensemble", flowTitle:"Du premier contact au rendez-vous, à la tâche ou au client.", steps:[["Le contact arrive","E-mail, WhatsApp, formulaire ou téléphone."],["L'IA comprend le contexte","Elle applique les bonnes questions, connaissances et règles."],["Le système agit","Le CRM, l'agenda et l'équipe reçoivent le résultat complet."]], industries:"Conçu pour les opérations quotidiennes", industriesLead:"Chaque secteur bénéficie de questions, exceptions, systèmes et règles de transfert adaptés.", route:"Voir le parcours", allNiches:"Voir tous les secteurs", delivery:"Du cadrage à la mise en ligne en 2–4 semaines", deliveryText:"Une fois les éléments fournis, nous concevons, connectons, testons et lançons de manière contrôlée. La confidentialité dès la conception et le transfert humain font partie de chaque étape.", cta:"Voir le processus" }
}[locale];
const nichePath = (slug:string) => localizedPath(`niche.${slug}`, locale);
const routeLabel = (slug:string, fallback:string) => locale === "nl" ? fallback : nichePath(slug).split("/").filter(Boolean).at(-1)!.replaceAll("-"," ").replace(/(^|\s)\p{L}/gu, l => l.toUpperCase());
const label = (slug:string, fallback:string) => localizedNiche(locale, slug, routeLabel(slug, fallback)).name;
const visibleNiches = niches.slice(0, 8);
---

<BaseLayout title={ui.home.title} description={ui.home.description} canonical={localizedPath("page.home", locale)} locale={locale} contentId="page.home">
  <Hero eyebrow={ui.home.eyebrow} title={ui.home.heading} accent={ui.home.accent} text={ui.home.lead} primaryLabel={ui.navigation.appointment} primaryHref={localizedPath("page.appointment",locale)} secondaryLabel="" secondaryHref="" chips={products.map(p=>ui.products[p.slug])} panelLabel={text.panelLabel} flowRows={text.heroFlow} />

  <section class="ap-section"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{ui.navigation.products}</div><h2 class="ap-section-title">{text.productsLead}</h2></div><div class="ap-locale-products">{products.map((product,index)=><a href={localizedPath(`product.${product.slug}`,locale)}><div><VisualIcon type="product" name={product.slug} size="small"/><span>{String(index+1).padStart(2,"0")}</span></div><h3>{ui.products[product.slug]}</h3><strong>{text.view} <span>→</span></strong></a>)}</div></div></section>

  <section class="ap-section"><div class="ap-container"><div class="ap-locale-flow"><div class="ap-kicker">{text.flow}</div><h2>{text.flowTitle}</h2><ol>{text.steps.map((step,index)=><li><span>{String(index+1).padStart(2,"0")}</span><div><strong>{step[0]}</strong><p>{step[1]}</p></div></li>)}</ol></div></div></section>

  <section class="ap-section"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{ui.navigation.niches}</div><h2 class="ap-section-title">{text.industries}</h2><p class="ap-text">{text.industriesLead}</p></div><div class="ap-locale-niches">{visibleNiches.map(niche=><a href={nichePath(niche.slug)}><span>{label(niche.slug,niche.name)}</span><strong aria-hidden="true">→</strong></a>)}</div><a class="ap-text-link ap-all-niches-link" href={localizedPath("page.niches",locale)}>{text.allNiches} →</a></div></section>

  <section class="ap-section"><div class="ap-container"><div class="ap-locale-delivery"><div><div class="ap-kicker">{ui.navigation.process}</div><h2>{text.delivery}</h2><p>{text.deliveryText}</p></div><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{text.cta}</a></div></div></section>
</BaseLayout>

<style>
  .ap-locale-products{border-block:1px solid var(--ap-line)}.ap-locale-products>a{display:grid;grid-template-columns:72px minmax(0,1fr) auto;gap:18px;align-items:center;border-bottom:1px solid var(--ap-line);padding:20px 4px;transition:padding .18s ease,color .18s ease}.ap-locale-products>a:last-child{border-bottom:0}.ap-locale-products>a:hover,.ap-locale-products>a:focus-visible{padding-left:12px;color:var(--ap-brown);outline:none}.ap-locale-products>a>div{display:flex;align-items:center;gap:10px}.ap-locale-products>a>div>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:9px;font-weight:800}.ap-locale-products h3{margin:0;font-size:22px;line-height:1.12}.ap-locale-products strong{display:flex;gap:14px;font-size:12px}.ap-locale-products strong span{color:var(--ap-brown)}.ap-locale-flow{overflow:hidden;border-radius:32px;background:#111;padding:44px;color:#fff}.ap-locale-flow .ap-kicker{color:#e4a092}.ap-locale-flow h2{max-width:900px;margin-top:18px;font-size:clamp(34px,5vw,60px);line-height:1}.ap-locale-flow ol{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:42px 0 0;padding:0;list-style:none}.ap-locale-flow li{display:grid;grid-template-columns:34px 1fr;gap:14px;border-top:1px solid rgba(255,255,255,.16);padding:22px 28px 0 0}.ap-locale-flow li>span{color:#e4a092;font:800 10px "Syne",sans-serif}.ap-locale-flow li strong{font-size:17px}.ap-locale-flow li p{margin:8px 0 0;color:rgba(255,255,255,.6);font-size:13px;line-height:1.5}.ap-locale-niches{display:grid;grid-template-columns:repeat(2,1fr);border-block:1px solid var(--ap-line)}.ap-locale-niches a{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--ap-line);padding:17px 4px}.ap-locale-niches a:nth-last-child(-n+2){border-bottom:0}.ap-locale-niches a:nth-child(odd){padding-right:22px}.ap-locale-niches a:nth-child(even){border-left:1px solid var(--ap-line);padding-left:22px}.ap-locale-niches a>span{font-size:16px;font-weight:850}.ap-locale-niches strong{color:var(--ap-brown)}.ap-all-niches-link{display:inline-flex;margin-top:24px}.ap-locale-delivery{display:flex;align-items:end;justify-content:space-between;gap:36px;border-top:1px solid var(--ap-line);padding:42px 0 0}.ap-locale-delivery h2{max-width:800px;margin-top:16px;font-size:clamp(32px,4vw,52px);line-height:1.02}.ap-locale-delivery p{max-width:800px;margin:20px 0 0;color:var(--ap-muted);line-height:1.65}@media(max-width:720px){.ap-locale-products>a{grid-template-columns:60px minmax(0,1fr)}.ap-locale-products>a>strong{grid-column:2}.ap-locale-flow ol,.ap-locale-niches{grid-template-columns:1fr}.ap-locale-flow{padding:28px}.ap-locale-flow li{padding-right:0}.ap-locale-niches a:nth-child(n){border-left:0;border-bottom:1px solid var(--ap-line);padding:16px 4px}.ap-locale-niches a:last-child{border-bottom:0}.ap-locale-delivery{align-items:flex-start;flex-direction:column;padding-top:32px}}
</style>
