---
import type { MarketingFunnelConfig } from "../../data/marketingFunnels";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
interface Props { config: MarketingFunnelConfig; experiencePath: string; locale?: SupportedLocale }
const { config, experiencePath, locale = "nl" } = Astro.props;
const french: Record<string, string> = {
  "Voortgang": "Progression",
  "Vraag 1 van 5": "Question 1 sur 5",
  "Eerst een snelle inschatting": "Une première estimation",
  "Hoeveel klantvragen komen er ongeveer per maand binnen ?": "Combien de demandes clients recevez-vous environ par mois ?",
  "Hoeveel klantvragen komen er ongeveer per maand binnen?": "Combien de demandes clients recevez-vous environ par mois ?",
  "Denk aan telefoontjes, WhatsApp, e-mail en platformleads samen.": "Incluez les appels, WhatsApp, les e-mails et les demandes issues des plateformes.",
  "Minder dan 100": "Moins de 100",
  "Rustig contactvolume": "Volume de demandes modéré",
  "Dagelijks nieuwe vragen": "De nouvelles demandes chaque jour",
  "Meerdere kanalen actief": "Plusieurs canaux actifs",
  "Meer dan 500": "Plus de 500",
  "Hoog contactvolume": "Volume de demandes élevé",
  "Jullie klantcontact": "Vos échanges clients",
  "Waar komen de meeste vragen binnen?": "Par quel canal recevez-vous le plus de demandes ?",
  "Dit bepaalt welke AI-medewerker je als eerste te zien krijgt.": "Cela détermine le collaborateur IA présenté en premier.",
  "Vooral telefonisch": "Surtout par téléphone",
  "Werkplaats, voorraad en afspraken": "Atelier, stock et rendez-vous",
  "Vooral berichten": "Surtout par messages",
  "E-mail, WhatsApp en portals": "E-mails, WhatsApp et portails",
  "Vooral advertentieleads": "Surtout via les annonces",
  "Website en voertuigplatforms": "Site web et plateformes automobiles",
  "Een mix van alles": "Un mélange de canaux",
  "Telefonie, berichten en leads": "Téléphone, messages et prospects",
  "Opvolging": "Suivi",
  "Hoeveel contacten worden nu te laat of niet opgevolgd?": "Quelle part des demandes reçoit une réponse tardive ou aucune réponse ?",
  "Een eerlijke schatting is voldoende.": "Une estimation réaliste suffit.",
  "Minder dan 10%": "Moins de 10 %",
  "Vrijwel alles wordt opgepakt": "Presque toutes les demandes sont traitées",
  "Ongeveer 10–25%": "Environ 10 à 25 %",
  "Soms blijft contact liggen": "Certaines demandes restent sans suite",
  "Ongeveer 25–50%": "Environ 25 à 50 %",
  "Drukte kost aantoonbaar kansen": "La charge de travail fait perdre des occasions",
  "Meer dan de helft": "Plus de la moitié",
  "Veel contact krijgt geen vervolg": "De nombreuses demandes restent sans suite",
  "Reactiesnelheid": "Délai de réponse",
  "Hoe snel krijgt een nieuwe vraag gemiddeld antwoord?": "Quel est le délai moyen de réponse à une nouvelle demande ?",
  "Ook buiten openingstijden en tijdens piekmomenten.": "Incluez les périodes de forte activité et les heures de fermeture.",
  "Binnen 5 minuten": "En moins de 5 minutes",
  "Bijna altijd direct": "Presque toujours immédiatement",
  "Binnen één uur": "En moins d’une heure",
  "Meestal dezelfde werkperiode": "Généralement pendant la même période de travail",
  "Later op dezelfde dag": "Plus tard dans la journée",
  "Afhankelijk van de drukte": "Selon la charge de travail",
  "Vaak pas de volgende dag": "Souvent le lendemain",
  "Opvolging loopt regelmatig achter": "Le suivi prend régulièrement du retard",
  "Gewenste resultaat": "Résultat souhaité",
  "Waar moet een AI-medewerker vooral ruimte maken?": "Où un collaborateur IA devrait-il surtout vous faire gagner du temps ?",
  "Je krijgt straks een test die hierbij aansluit.": "Vous accéderez ensuite à un test adapté.",
  "Meer afspraken": "Plus de rendez-vous",
  "Van vraag naar proefrit of werkplaats": "De la demande à l’essai ou au rendez-vous atelier",
  "Snellere opvolging": "Un suivi plus rapide",
  "Iedere lead direct een volgende stap": "Une prochaine étape pour chaque prospect",
  "Minder druk op het team": "Moins de pression sur l’équipe",
  "Herhaalwerk en intake overnemen": "Déléguer les tâches répétitives et le premier accueil",
  "Alles combineren": "Combiner tous ces objectifs",
  "Eén route voor het hele klantcontact": "Un parcours pour tous vos échanges clients",
  "Jouw eerste indicatie": "Votre première estimation",
  "contacten per maand": "demandes par mois",
  "kunnen mogelijk sneller of consistenter worden opgevolgd. Vul hieronder je gegevens in om de AI-medewerker zelf te testen.": "pourraient recevoir un suivi plus rapide ou plus régulier. Saisissez vos coordonnées ci-dessous pour tester le collaborateur IA.",
  "Laatste stap": "Dernière étape",
  "Vul je gegevens in en test direct de AI-medewerker voor autobedrijven.": "Saisissez vos coordonnées et testez le collaborateur IA pour concessions automobiles.",
  "Daarna krijg je meteen toegang tot drie live AI-tests en jouw persoonlijke impactberekening. Zonder aankoopverplichting.": "Accédez ensuite à trois tests IA en direct et à votre estimation personnalisée. Sans obligation d’achat.",
  "Naam": "Nom",
  "Voor- en achternaam": "Prénom et nom",
  "Autobedrijf": "Concession automobile",
  "Bedrijfsnaam": "Nom de l’entreprise",
  "Zakelijk e-mailadres": "Adresse e-mail professionnelle",
  "Telefoonnummer": "Numéro de téléphone",
  "naam@autobedrijf.nl": "nom@entreprise.fr",
  "06 12 34 56 78": "+33 6 12 34 56 78",
  "Stuur mij de AI-test, mijn berekening en praktische opvolging over AI voor autobedrijven. Afmelden kan altijd. Bekijk de": "Je souhaite recevoir le test IA, mon estimation et un suivi pratique sur l’IA pour concessions automobiles. Je peux me désinscrire à tout moment. Consultez les",
  "privacyinformatie": "informations de confidentialité",
  "Bekijk mijn resultaat & test de AI": "Voir mon résultat et tester l’IA",
  "Direct toegang · Geen aankoopverplichting · Geen generieke mailing": "Accès immédiat · Sans obligation d’achat · Aucun envoi générique",
  "← Vorige": "← Précédent",
  "± 60 seconden": "Environ 60 secondes"
};
const t = (value: string) => locale === "fr" ? (french[value] ?? value) : value;
---

<form class="ap-funnel" data-campaign-lead-form data-locale={locale} data-campaign-attribution data-experience-path={experiencePath} novalidate>
  <input type="hidden" name="intent" value="demo" />
  <input type="hidden" name="campaignName" value={config.campaignName} />
  <input type="hidden" name="niche" value={config.niche} />
  <input type="hidden" name="funnelAnswers" value="" />
  <div class="ap-funnel-progress" aria-label={t("Voortgang")}><div><span data-progress-fill></span></div><p><b data-progress-label>{t("Vraag 1 van 5")}</b><span data-progress-percent>17%</span></p></div>

  <div class="ap-funnel-stage is-active" data-stage="0">
    <p class="ap-funnel-kicker">{t("Eerst een snelle inschatting")}</p><h2>{t("Hoeveel klantvragen komen er ongeveer per maand binnen?")}</h2><p class="ap-funnel-help">{t("Denk aan telefoontjes, WhatsApp, e-mail en platformleads samen.")}</p>
    <div class="ap-answer-grid">
      <label><input type="radio" name="volume" value="75" data-label={t("Minder dan 100")} /><span><b>{t("Minder dan 100")}</b><small>{t("Rustig contactvolume")}</small></span></label>
      <label><input type="radio" name="volume" value="175" data-label="100–250" /><span><b>100–250</b><small>{t("Dagelijks nieuwe vragen")}</small></span></label>
      <label><input type="radio" name="volume" value="375" data-label="250–500" /><span><b>250–500</b><small>{t("Meerdere kanalen actief")}</small></span></label>
      <label><input type="radio" name="volume" value="650" data-label={t("Meer dan 500")} /><span><b>{t("Meer dan 500")}</b><small>{t("Hoog contactvolume")}</small></span></label>
    </div>
  </div>
  <div class="ap-funnel-stage" data-stage="1" hidden>
    <p class="ap-funnel-kicker">{t("Jullie klantcontact")}</p><h2>{t("Waar komen de meeste vragen binnen?")}</h2><p class="ap-funnel-help">{t("Dit bepaalt welke AI-medewerker je als eerste te zien krijgt.")}</p>
    <div class="ap-answer-grid">
      <label><input type="radio" name="channel" value="phone" data-label={t("Vooral telefonisch")} /><span><b>{t("Vooral telefonisch")}</b><small>{t("Werkplaats, voorraad en afspraken")}</small></span></label>
      <label><input type="radio" name="channel" value="messages" data-label={t("Vooral berichten")} /><span><b>{t("Vooral berichten")}</b><small>{t("E-mail, WhatsApp en portals")}</small></span></label>
      <label><input type="radio" name="channel" value="leads" data-label={t("Vooral advertentieleads")} /><span><b>{t("Vooral advertentieleads")}</b><small>{t("Website en voertuigplatforms")}</small></span></label>
      <label><input type="radio" name="channel" value="mixed" data-label={t("Een mix van alles")} /><span><b>{t("Een mix van alles")}</b><small>{t("Telefonie, berichten en leads")}</small></span></label>
    </div>
  </div>
  <div class="ap-funnel-stage" data-stage="2" hidden>
    <p class="ap-funnel-kicker">{t("Opvolging")}</p><h2>{t("Hoeveel contacten worden nu te laat of niet opgevolgd?")}</h2><p class="ap-funnel-help">{t("Een eerlijke schatting is voldoende.")}</p>
    <div class="ap-answer-grid">
      <label><input type="radio" name="missed" value="10" data-label={t("Minder dan 10%")} /><span><b>{t("Minder dan 10%")}</b><small>{t("Vrijwel alles wordt opgepakt")}</small></span></label>
      <label><input type="radio" name="missed" value="20" data-label={t("Ongeveer 10–25%")} /><span><b>{t("Ongeveer 10–25%")}</b><small>{t("Soms blijft contact liggen")}</small></span></label>
      <label><input type="radio" name="missed" value="38" data-label={t("Ongeveer 25–50%")} /><span><b>{t("Ongeveer 25–50%")}</b><small>{t("Drukte kost aantoonbaar kansen")}</small></span></label>
      <label><input type="radio" name="missed" value="60" data-label={t("Meer dan de helft")} /><span><b>{t("Meer dan de helft")}</b><small>{t("Veel contact krijgt geen vervolg")}</small></span></label>
    </div>
  </div>
  <div class="ap-funnel-stage" data-stage="3" hidden>
    <p class="ap-funnel-kicker">{t("Reactiesnelheid")}</p><h2>{t("Hoe snel krijgt een nieuwe vraag gemiddeld antwoord?")}</h2><p class="ap-funnel-help">{t("Ook buiten openingstijden en tijdens piekmomenten.")}</p>
    <div class="ap-answer-grid">
      <label><input type="radio" name="responseTime" value="under-5" data-label={t("Binnen 5 minuten")} /><span><b>{t("Binnen 5 minuten")}</b><small>{t("Bijna altijd direct")}</small></span></label>
      <label><input type="radio" name="responseTime" value="under-60" data-label={t("Binnen één uur")} /><span><b>{t("Binnen één uur")}</b><small>{t("Meestal dezelfde werkperiode")}</small></span></label>
      <label><input type="radio" name="responseTime" value="same-day" data-label={t("Later op dezelfde dag")} /><span><b>{t("Later op dezelfde dag")}</b><small>{t("Afhankelijk van de drukte")}</small></span></label>
      <label><input type="radio" name="responseTime" value="next-day" data-label={t("Vaak pas de volgende dag")} /><span><b>{t("Vaak pas de volgende dag")}</b><small>{t("Opvolging loopt regelmatig achter")}</small></span></label>
    </div>
  </div>
  <div class="ap-funnel-stage" data-stage="4" hidden>
    <p class="ap-funnel-kicker">{t("Gewenste resultaat")}</p><h2>{t("Waar moet een AI-medewerker vooral ruimte maken?")}</h2><p class="ap-funnel-help">{t("Je krijgt straks een test die hierbij aansluit.")}</p>
    <div class="ap-answer-grid">
      <label><input type="radio" name="goal" value="appointments" data-label={t("Meer afspraken")} /><span><b>{t("Meer afspraken")}</b><small>{t("Van vraag naar proefrit of werkplaats")}</small></span></label>
      <label><input type="radio" name="goal" value="speed" data-label={t("Snellere opvolging")} /><span><b>{t("Snellere opvolging")}</b><small>{t("Iedere lead direct een volgende stap")}</small></span></label>
      <label><input type="radio" name="goal" value="workload" data-label={t("Minder druk op het team")} /><span><b>{t("Minder druk op het team")}</b><small>{t("Herhaalwerk en intake overnemen")}</small></span></label>
      <label><input type="radio" name="goal" value="all" data-label={t("Alles combineren")} /><span><b>{t("Alles combineren")}</b><small>{t("Eén route voor het hele klantcontact")}</small></span></label>
    </div>
  </div>
  <div class="ap-funnel-stage ap-contact-stage" data-stage="5" hidden>
    <div class="ap-result-preview"><span>{t("Jouw eerste indicatie")}</span><strong><b data-opportunity>0</b> {t("contacten per maand")}</strong><p>{t("kunnen mogelijk sneller of consistenter worden opgevolgd. Vul hieronder je gegevens in om de AI-medewerker zelf te testen.")}</p></div>
    <p class="ap-funnel-kicker">{t("Laatste stap")}</p><h2>{t("Vul je gegevens in en test direct de AI-medewerker voor autobedrijven.")}</h2>
    <p class="ap-funnel-help">{t("Daarna krijg je meteen toegang tot drie live AI-tests en jouw persoonlijke impactberekening. Zonder aankoopverplichting.")}</p>
    <div class="ap-entry-fields">
      <label><span>{t("Naam")}</span><input name="name" autocomplete="name" required maxlength="100" placeholder={t("Voor- en achternaam")} /></label>
      <label><span>{t("Autobedrijf")}</span><input name="company" autocomplete="organization" required maxlength="120" placeholder={t("Bedrijfsnaam")} /></label>
      <label><span>{t("Zakelijk e-mailadres")}</span><input name="email" type="email" autocomplete="email" inputmode="email" required maxlength="160" placeholder={t("naam@autobedrijf.nl")} /></label>
      <label><span>{t("Telefoonnummer")}</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="40" placeholder={t("06 12 34 56 78")} /></label>
    </div>
    <label class="ap-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
    <label class="ap-entry-consent"><input name="consent" type="checkbox" required /><span>{t("Stuur mij de AI-test, mijn berekening en praktische opvolging over AI voor autobedrijven. Afmelden kan altijd. Bekijk de")} <a href={locale === "fr" ? localizedPath("page.privacy", locale) : "/privacy/"} target="_blank" rel="noopener noreferrer">{t("privacyinformatie")}</a>.</span></label>
    <button class="ap-entry-submit" type="submit" data-submit-label>{t("Bekijk mijn resultaat & test de AI")} <span aria-hidden="true">→</span></button>
    <p class="ap-entry-note">{t("Direct toegang · Geen aankoopverplichting · Geen generieke mailing")}</p><p class="ap-entry-status" data-form-status aria-live="polite"></p>
  </div>
  <div class="ap-funnel-controls"><button type="button" class="ap-funnel-back" data-back hidden>{t("← Vorige")}</button><span>{t("± 60 seconden")}</span></div>
</form>

<script>
  document.querySelectorAll("[data-campaign-lead-form]").forEach((form) => {
    const isFrench = form.dataset.locale === "fr";
    const stages=[...form.querySelectorAll("[data-stage]")],back=form.querySelector("[data-back]"),fill=form.querySelector("[data-progress-fill]"),progressLabel=form.querySelector("[data-progress-label]"),progressPercent=form.querySelector("[data-progress-percent]"),submit=form.querySelector("[data-submit-label]"),status=form.querySelector("[data-form-status]");let active=0;const answers={};
    window.apCampaign?.emit?.("funnel_started",{step:1});
    const show=(index)=>{active=Math.max(0,Math.min(index,stages.length-1));stages.forEach((stage,i)=>{stage.hidden=i!==active;stage.classList.toggle("is-active",i===active)});const percent=Math.round(((active+1)/stages.length)*100);fill.style.width=`${percent}%`;progressPercent.textContent=`${percent}%`;progressLabel.textContent=active<5?(isFrench?`Question ${active+1} sur 5`:`Vraag ${active+1} van 5`):(isFrench?"Votre résultat est prêt":"Je resultaat is klaar");back.hidden=active===0;if(active===5){const opportunity=Math.round(Number(answers.volume?.value||0)*Number(answers.missed?.value||0)/100);form.querySelector("[data-opportunity]").textContent=new Intl.NumberFormat(isFrench ? "fr-FR" : "nl-NL").format(opportunity);form.elements.funnelAnswers.value=JSON.stringify(answers);window.apCampaign?.emit?.("funnel_diagnosis_completed",{volume:answers.volume?.value,missed:answers.missed?.value,channel:answers.channel?.value,goal:answers.goal?.value})}stages[active].querySelector("h2")?.focus?.({preventScroll:true})};
    form.querySelectorAll('.ap-answer-grid input[type="radio"]').forEach(input=>input.addEventListener("change",()=>{const questionLabel=input.closest("[data-stage]")?.querySelector("h2")?.textContent?.trim()||input.name;answers[input.name]={value:input.value,label:input.dataset.label,question:questionLabel};window.apCampaign?.emit?.("funnel_question_answered",{question:input.name,questionLabel,answer:input.value,answerLabel:input.dataset.label,step:active+1});setTimeout(()=>show(active+1),180)}));back.addEventListener("click",()=>show(active-1));show(0);
    form.addEventListener("submit",async(event)=>{event.preventDefault();status.textContent="";if(!form.reportValidity())return;submit.disabled=true;submit.setAttribute("aria-busy","true");const payload=Object.fromEntries(new FormData(form).entries());payload.consent=form.elements.consent.checked;payload.sessionId=window.apCampaign?.sessionId||"";const target=new URL(form.dataset.experiencePath,location.origin);target.searchParams.set("volume",String(answers.volume?.value||180));target.searchParams.set("issue",String(answers.missed?.value||32));target.searchParams.set("channel",String(answers.channel?.value||"mixed"));const attribution=window.apCampaign?.attribution||{};["utm_source","utm_medium","utm_campaign","utm_term","utm_content","gclid","fbclid","msclkid"].forEach(key=>{if(attribution[key])target.searchParams.set(key,attribution[key])});try{window.apCampaign?.emit?.("lead_form_submitted",{intent:"combined"});const response=await fetch((import.meta.env.VITE_AUTOPILOTS_SCAN_URL||"").replace(/\/$/,"")+"/api/funnel-lead",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify(payload)});const result=await response.json().catch(()=>({}));if(!response.ok||!result.ok)throw new Error(result.message||"Versturen is nu niet gelukt.");window.apCampaign?.emit?.("lead_form_succeeded",{intent:"combined"});location.assign(`${target.pathname}${target.search}`)}catch(error){if(["localhost","127.0.0.1"].includes(location.hostname)){status.textContent=isFrench ? "Aperçu local : ouverture du test sans enregistrement dans le CRM." : "Lokale preview: de ervaring wordt geopend zonder CRM-opslag.";setTimeout(()=>location.assign(`${target.pathname}${target.search}`),500);return}window.apCampaign?.emit?.("lead_form_failed",{intent:"combined"});status.textContent=isFrench ? "L’envoi a échoué. Veuillez réessayer." : error.message||"Versturen is nu niet gelukt. Probeer het opnieuw.";submit.disabled=false;submit.removeAttribute("aria-busy")}});
  });
</script>

<style>
  .ap-funnel{min-height:540px}.ap-funnel-progress{margin-bottom:34px}.ap-funnel-progress>div{overflow:hidden;height:5px;border-radius:999px;background:#ecece8}.ap-funnel-progress>div span{display:block;width:17%;height:100%;border-radius:inherit;background:#9f3826;transition:width .35s ease}.ap-funnel-progress p{display:flex;justify-content:space-between;margin-top:10px!important;color:#777;font:700 9px/1 "Syne",sans-serif;letter-spacing:.5px}.ap-funnel-stage{animation:stage-in .28s ease}.ap-funnel-stage h2{max-width:670px!important;font-size:clamp(27px,3vw,39px)!important;line-height:1.1!important;letter-spacing:-.04em!important}.ap-funnel-kicker{margin-bottom:15px!important;color:#9f3826;font:700 9px/1 "Syne",sans-serif;letter-spacing:1.5px;text-transform:uppercase}.ap-funnel-help{margin:15px 0 0!important;color:#6a6a6a;font-size:13px;line-height:1.55}.ap-answer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:28px}.ap-answer-grid label{position:relative;cursor:pointer}.ap-answer-grid input{position:absolute;opacity:0;pointer-events:none}.ap-answer-grid label>span{display:flex;min-height:84px;flex-direction:column;justify-content:center;border:1px solid rgba(17,17,17,.1);border-radius:20px;background:#f8f8f5;padding:17px 18px;transition:.18s}.ap-answer-grid label:hover>span,.ap-answer-grid input:focus-visible+span{border-color:rgba(159,56,38,.45);background:#fff7f4;transform:translateY(-1px);box-shadow:0 12px 25px rgba(17,17,17,.05)}.ap-answer-grid b{font-size:14px}.ap-answer-grid small{margin-top:6px;color:#777;font-size:10px;line-height:1.35}.ap-funnel-controls{display:flex;align-items:center;justify-content:space-between;margin-top:25px;color:#8a8a8a;font-size:9px}.ap-funnel-back{border:0;background:transparent;padding:6px 0;color:#555;font-size:10px;font-weight:800;cursor:pointer}.ap-result-preview{margin-bottom:27px;border-radius:23px;background:radial-gradient(circle at 100% 100%,rgba(159,56,38,.5),transparent 46%),#111;pad