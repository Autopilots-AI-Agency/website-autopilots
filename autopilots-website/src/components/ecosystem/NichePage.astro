---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Niche } from '../../data/niches';
import type { SupportedLocale } from '../../i18n/languages';
import { localizedNicheData } from '../../i18n/catalog';
import { localizedPath } from '../../i18n/routes';
import { nichePageCopy } from '../../i18n/nichePage';
import { solutionCopy, solutionItems } from '../../data/solutions';
import { intakePath } from '../../config/intake';
interface Props { niche: Niche; locale?: SupportedLocale }
const { niche: source, locale = 'nl' } = Astro.props;
const niche = localizedNicheData(locale, source);
const c = nichePageCopy[locale];
const s = solutionCopy(locale);
const solutions = solutionItems(locale);
const labels = {
 nl: ['In de praktijk', 'Eén klantvraag.', 'Een helder vervolg.', 'Voorbeeld voor jullie branche', 'Wat bouwen we voor', 'Aansluiten op jullie werkwijze.', 'Afstemming en technische mogelijkheden bepalen welke koppelingen passen.', 'Van plan naar praktijk.', 'Eenmalige implementatie. Maandelijks beheer.', 'Waar kan jullie bedrijf tijd winnen?', 'Menselijk wanneer het nodig is.', 'Aanvraag', 'Klantdossier', 'Website', 'Relevante toepassingen', 'Jullie dagelijkse praktijk'],
 en: ['In practice', 'One customer question.', 'A clear next step.', 'Example for your industry', 'What we build for', 'Built around your workflow.', 'Scope and technical capabilities determine suitable integrations.', 'From plan to practice.', 'One-time implementation. Monthly management.', 'Where could your business save time?', 'Human support when needed.', 'Enquiry', 'Customer record', 'Website', 'Relevant applications', 'Your daily work'],
 de: ['In der Praxis', 'Eine Kundenfrage.', 'Ein klarer nächster Schritt.', 'Beispiel für Ihre Branche', 'Was wir bauen für', 'Passend zu Ihren Abläufen.', 'Umfang und technische Möglichkeiten bestimmen passende Schnittstellen.', 'Vom Plan zur Praxis.', 'Einmalige Implementierung. Monatliche Betreuung.', 'Wo kann Ihr Unternehmen Zeit sparen?', 'Menschen, wenn es darauf ankommt.', 'Anfrage', 'Kundendossier', 'Website', 'Passende Anwendungen', 'Ihr Arbeitsalltag'],
 fr: ['En pratique', 'Une question client.', 'Une suite claire.', 'Exemple pour votre secteur', 'Ce que nous créons pour', 'Adapté à votre façon de travailler.', 'Le périmètre et les possibilités techniques déterminent les intégrations adaptées.', 'Du projet à la pratique.', 'Mise en place initiale. Gestion mensuelle.', 'Où votre entreprise peut-elle gagner du temps ?', 'Un relais humain si nécessaire.', 'Demande', 'Dossier client', 'Site web', 'Applications pertinentes', 'Votre quotidien'],
 es: ['En la práctica', 'Una consulta.', 'Un siguiente paso claro.', 'Ejemplo para tu sector', 'Lo que creamos para', 'Adaptado a vuestra forma de trabajar.', 'El alcance y las posibilidades técnicas determinan las integraciones adecuadas.', 'Del plan a la práctica.', 'Implementación inicial. Gestión mensual.', '¿Dónde puede ahorrar tiempo tu empresa?', 'Personas cuando hacen falta.', 'Solicitud', 'Ficha de cliente', 'Sitio web', 'Aplicaciones relevantes', 'Tu trabajo diario'],
 it: ['In pratica', 'Una domanda.', 'Un prossimo passo chiaro.', 'Esempio per il tuo settore', 'Cosa creiamo per', 'Adatto al vostro lavoro.', 'Ambito e possibilità tecniche determinano le integrazioni adatte.', 'Dal progetto alla pratica.', 'Implementazione iniziale. Gestione mensile.', 'Dove può risparmiare tempo la tua azienda?', 'Persone quando serve.', 'Richiesta', 'Scheda cliente', 'Sito web', 'Applicazioni pertinenti', 'Il tuo lavoro quotidiano']
}[locale];
const canonical = localizedPath(`niche.${source.slug}`, locale);
const steps = niche.workflow.slice(0,4);
const faq = [...niche.faq, ...c.extraFaq.map(([question, answer]) => ({question, answer}))];
const schema = [{ '@context':'https://schema.org', '@type':'Service', name: `${s.title}: ${niche.name}`, description:niche.metaDescription, provider:{'@type':'Organization',name:'Autopilots',url:'https://auto-pilots.io'} }, {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))}];
---
<BaseLayout title={niche.seoTitle} description={niche.metaDescription} canonical={canonical} locale={locale} contentId={`niche.${source.slug}`} schema={schema}>
 <article id="ap-niche-premium">
  <header class="np-hero np-wrap">
   <a class="np-back" href={localizedPath('page.niches',locale)}>{s.title} / {niche.name}</a>
   <h1>{locale === 'nl' && source.slug === 'installatietechniek' ? 'Meer tijd voor het vak.' : niche.hero}<em>{locale === 'nl' && source.slug === 'installatietechniek' ? 'AI doet het voorwerk.' : niche.accent}</em></h1>
   <p class="np-lead">{niche.lead}</p>
   <a class="np-cta" href={intakePath(locale)}>{s.scan}</a>
   <div class="np-capabilities">{s.names.map(name=><span>{name}</span>)}</div>
  </header>
  <section class="np-section np-wrap" id="praktijkdemo">
   <div class="np-heading"><p class="np-kicker">{labels[0]}</p><h2>{labels[1]}<em>{labels[2]}</em></h2></div>
   <div class="np-journey" style="--active-step:0">
    <div class="np-question"><span>{c.customer}</span><p>“{niche.conversation.customer}”</p></div>
    <div class="np-step-list" aria-label={labels[0]}>{steps.map((step,i)=><button type="button" data-step={i} aria-pressed={i===0}><b>{String(i+1).padStart(2,'0')}</b><span>{step.title}</span></button>)}</div>
    <div class="np-dossier"><div class="np-window"><span>{niche.name}</span><small>{labels[3]}</small></div>
     {steps.map((step,i)=><div class="np-step-panel" data-step-panel={i} hidden={i!==0}><span class="np-kicker">{String(i+1).padStart(2,'0')} / {labels[11]}</span><h3>{step.title}</h3><p>{step.text}</p><div class="np-fields">{niche.intake.slice(i, i+3).map(field=><span><i></i>{field}</span>)}</div></div>)}
     <div class="np-handoff"><span class="np-dot"></span>{c.teamOutput}</div>
    </div>
   </div>
   <details class="np-detail"><summary>{labels[15]}</summary><div class="np-pains">{niche.painPoints.map(item=><div><h3>{item.title}</h3><p>{item.text}</p></div>)}</div></details>
  </section>
  <section class="np-section np-wrap" id="producten">
   <div class="np-heading"><p class="np-kicker">{s.title}</p><h2>{labels[4]}<em>{niche.name.toLowerCase()}.</em></h2></div>
   <div class="np-solutions"><div class="np-tabs">{solutions.map((item,i)=><button type="button" data-solution={i} aria-pressed={i===0}>{item.name}</button>)}</div>
    {solutions.map((item,i)=><div class="np-solution-panel" data-solution-panel={i} hidden={i!==0}><div class="np-solution-copy"><span class="np-kicker">0{i+1}</span><h3>{item.name}</h3><p>{item.description}</p><a href={item.href}>{s.detail}</a></div><div class="np-preview"><div class="np-window"><span>{niche.name}</span><small>{labels[3]}</small></div>{i===0 ? <div class="np-chat"><span>{c.customer}</span><p>{niche.conversation.customer}</p><span>{c.ai}</span><p>{niche.conversation.ai}</p></div> : i===1 ? <div class="np-record"><h4>{labels[12]}</h4>{niche.intake.slice(0,4).map(field=><div><span>{field}</span><i></i></div>)}</div> : <div class="np-site"><span>{niche.name}</span><h4>{niche.hero}</h4><p>{niche.accent}</p><div class="np-site-lines"><i></i><i></i></div><b>{labels[11]}</b></div>}</div></div>)}
   </div>
   <div class="np-integrations"><h3>{labels[5]}</h3><div>{niche.systems.map(system=><span>{system}</span>)}</div><p>{labels[6]}</p></div>
  </section>
  <section class="np-section np-wrap" id="implementatie"><div class="np-heading"><p class="np-kicker">{c.implementation}</p><h2>{labels[7]}</h2></div><div class="np-phases">{c.phases.map((phase,i)=><details><summary><span>0{i+1}</span>{phase.title}</summary><p>{phase.text}</p></details>)}</div><div class="np-human"><h3>{labels[10]}</h3><p>{c.boundaryItems[1][1]}</p></div></section>
  <section class="np-section np-wrap" id="tarieven"><div class="np-heading"><p class="np-kicker">{c.pricing}</p><h2>{labels[8]}</h2><p>{s.cost}</p></div></section>
  <section class="np-section np-wrap"><div class="np-heading"><p class="np-kicker">{c.faq}</p><h2>{c.faqTitle} {niche.name.toLowerCase()}.</h2></div><div class="np-faq">{faq.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>
  <section class="np-section np-wrap"><div class="np-final"><p class="np-kicker">{niche.name}</p><h2>{labels[9]}</h2><p>{s.intro}</p><a class="np-cta" href={intakePath(locale)}>{s.scan}</a></div></section>
 </article>
</BaseLayout>
<style>
 #ap-niche-premium{color:#f5f2e9;background:radial-gradient(ellipse at 12% 15%,#ffffff06,transparent 38%),radial-gradient(ellipse at 90% 65%,#ffffff05,transparent 40%);--line:#aec4c324;--bronze:#c18c5b;--muted:#aabdc2}
 #ap-niche-premium .np-wrap{width:calc(100% - 40px);max-width:1060px;margin-inline:auto}
 #ap-niche-premium .np-hero{text-align:center;padding:56px 0 20px;max-width:900px}
 #ap-niche-premium .np-back{color:var(--muted);font-size:13px;text-decoration:none}
 #ap-niche-premium h1{font-size:clamp(34px,4.6vw,54px);line-height:1.12;letter-spacing:-.045em;margin:38px auto 24px;max-width:850px;font-weight:800}
 #ap-niche-premium em{display:block;color:var(--bronze)}
 #ap-niche-premium p{color:var(--muted);line-height:1.8;margin:16px 0;font-size:16px}
 #ap-niche-premium .np-lead{max-width:680px;margin:0 auto 28px;font-size:18px}
 #ap-niche-premium .np-cta{display:inline-flex;justify-content:center;align-items:center;max-width:100%;padding:17px 26px;background:linear-gradient(110deg,#78492f,#a57043,#77482f);border:1px solid #c69b72;border-radius:9px;color:#fff8ef;font-size:15px;font-weight:750;text-decoration:none;box-shadow:inset 0 1px #ffffff24;transition:transform .25s}
 #ap-niche-premium .np-cta:hover{transform:translateY(-2px)}
 #ap-niche-premium .np-capabilities{display:flex;justify-content:center;gap:26px;flex-wrap:wrap;margin-top:40px;color:var(--muted);font-size:12px;letter-spacing:.06em}
 #ap-niche-premium .np-section{padding-block:64px}
 #ap-niche-premium .np-heading{text-align:center;max-width:800px;margin:0 auto 36px}
 #ap-niche-premium .np-kicker{font-family:Syne,sans-serif;font-size:12px;letter-spacing:.17em;text-transform:uppercase;color:#d4ad87;margin:0 0 18px}
 #ap-niche-premium h2{font-size:clamp(28px,3.5vw,44px);line-height:1.15;letter-spacing:-.04em;font-weight:800;margin:0}
 #ap-niche-premium h3{font-size:24px;line-height:1.25;letter-spacing:-.025em;margin:12px 0}
 #ap-niche-premium h4{font-size:22px;line-height:1.35;margin:16px 0}
 #ap-niche-premium .np-journey{max-width:850px;margin:auto}
 #ap-niche-premium .np-question{max-width:620px;text-align:center;margin:0 auto 32px}
 #ap-niche-premium .np-question>span,#ap-niche-premium .np-chat>span{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:#d4ad87}
 #ap-niche-premium .np-question p{font-size:18px;color:#f5f2e9}
 #ap-niche-premium button{font:inherit;cursor:pointer}
 #ap-niche-premium .np-step-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0 0 26px;gap:10px}
 #ap-niche-premium .np-step-list button{border:0;border-bottom:1px solid var(--line);background:none;color:var(--muted);padding:12px 5px 16px;display:flex;flex-direction:column;align-items:center;gap:12px;font-size:12px;line-height:1.4;transition:color .3s,border-color .3s}
 #ap-niche-premium .np-step-list b{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--line);border-radius:50%;font-family:Syne,sans-serif;font-size:12px}
 #ap-niche-premium .np-step-list [aria-pressed=true]{color:#fff5e9;border-color:var(--bronze)}
 #ap-niche-premium .np-step-list [aria-pressed=true] b{background:linear-gradient(120deg,#825136,#ac784e);border-color:#d4ad87}
 #ap-niche-premium .np-dossier,#ap-niche-premium .np-preview{border:1px solid var(--line);border-radius:22px;background:linear-gradient(125deg,#20353f,#14272e);overflow:hidden}
 #ap-niche-premium .np-dossier{max-width:660px;margin:auto}
 #ap-niche-premium .np-window{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 24px;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted)}
 #ap-niche-premium .np-window small{font-size:10px;text-align:right}
 #ap-niche-premium .np-step-panel{padding:32px;min-height:240px}
 #ap-niche-premium .np-fields{display:flex;flex-wrap:wrap;gap:10px 20px;margin-top:22px;font-size:12px;color:var(--muted)}
 #ap-niche-premium .np-fields span{display:flex;align-items:center;gap:8px}
 #ap-niche-premium .np-fields i,#ap-niche-premium .np-dot{width:5px;height:5px;background:#c2d1b5;border-radius:50%;display:inline-block;flex-shrink:0}
 #ap-niche-premium .np-handoff{display:flex;align-items:center;gap:10px;padding:16px 32px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}
 #ap-niche-premium .np-detail{max-width:850px;margin:26px auto 0;border-bottom:1px solid var(--line)}
 #ap-niche-premium summary{cursor:pointer;padding:20px 0;line-height:1.5;font-size:15px}
 #ap-niche-premium .np-pains{display:grid;grid-template-columns:1fr 1fr;gap:16px 36px;padding:12px 0 24px}
 #ap-niche-premium .np-pains h3{font-size:17px}
 #ap-niche-premium .np-pains p{font-size:14px}
 #ap-niche-premium .np-tabs{display:flex;justify-content:center;gap:8px;margin-bottom:30px}
 #ap-niche-premium .np-tabs button{background:none;border:1px solid var(--line);border-radius:9px;color:var(--muted);padding:12px 20px;font-size:14px}
 #ap-niche-premium .np-tabs [aria-pressed=true]{background:#b7835321;border-color:#ba8e62;color:#eed3b8}
 #ap-niche-premium .np-solution-panel{display:grid;grid-template-columns:1fr 1.15fr;gap:50px;align-items:center;max-width:900px;margin:auto}
 #ap-niche-premium .np-solution-copy a{color:#dfb78f;font-size:14px;text-underline-offset:5px}
 #ap-niche-premium .np-chat,#ap-niche-premium .np-record,#ap-niche-premium .np-site{padding:24px;min-height:265px}
 #ap-niche-premium .np-chat p{font-size:14px;line-height:1.65;margin:8px 0 20px}
 #ap-niche-premium .np-record>div{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted)}
 #ap-niche-premium .np-record i{width:46px;height:5px;background:#a9bdc130;border-radius:9px}
 #ap-niche-premium .np-site{background:#e9e4d8;color:#183038}
 #ap-niche-premium .np-site h4{color:#183038}
 #ap-niche-premium .np-site>span{font-size:12px;letter-spacing:.1em}
 #ap-niche-premium .np-site p{color:#516665;font-size:15px}
 #ap-niche-premium .np-site b{font-size:12px;display:inline-block;background:#29453f;color:white;padding:9px 15px;border-radius:5px}
 #ap-niche-premium .np-site-lines{margin:20px 0;display:grid;gap:8px}
 #ap-niche-premium .np-site-lines i{height:5px;background:#29453f20;width:85%}
 #ap-niche-premium .np-site-lines i+ i{width:65%}
 #ap-niche-premium .np-integrations{text-align:center;margin:48px auto 0;max-width:800px}
 #ap-niche-premium .np-integrations h3{font-size:18px}
 #ap-niche-premium .np-integrations>div{display:flex;flex-wrap:wrap;justify-content:center;gap:12px 24px;margin:20px 0;color:#cfdbdb;font-size:13px}
 #ap-niche-premium .np-integrations p{font-size:12px}
 #ap-niche-premium .np-phases,#ap-niche-premium .np-faq{max-width:780px;margin:auto}
 #ap-niche-premium .np-phases details,#ap-niche-premium .np-faq details{border-bottom:1px solid var(--line)}
 #ap-niche-premium .np-phases summary span{color:var(--bronze);margin-right:20px;font-family:Syne,sans-serif}
 #ap-niche-premium .np-phases p,#ap-niche-premium .np-faq p{font-size:15px;margin:0 0 22px}
 #ap-niche-premium .np-human{max-width:680px;margin:32px auto 0;text-align:center}
 #ap-niche-premium .np-human h3{font-size:18px}
 #ap-niche-premium .np-human p{font-size:14px}
 #ap-niche-premium #tarieven{padding-block:28px}
 #ap-niche-premium #tarieven h2{font-size:28px}
 #ap-niche-premium .np-final{text-align:center;padding:56px 32px;border:1px solid #c9a07840;border-radius:26px;background:radial-gradient(ellipse at top,#ffffff08,transparent 75%),#182d34}
 #ap-niche-premium .np-final p:not(.np-kicker){max-width:600px;margin:22px auto}
 #ap-niche-premium [hidden]{display:none!important}
 #ap-niche-premium button:focus-visible,#ap-niche-premium a:focus-visible,#ap-niche-premium summary:focus-visible{outline:2px solid #d9b18b;outline-offset:5px}
 #ap-niche-premium .np-step-panel:not([hidden]),#ap-niche-premium .np-solution-panel:not([hidden]){animation:np-enter .45s ease both}
 @keyframes np-enter{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
 /* One cohesive workspace: input, route and outcome. */
 #ap-niche-premium .np-journey{display:grid;grid-template-columns:260px minmax(0,1fr);gap:0 36px;max-width:940px;margin:auto;padding:32px;border:1px solid #cfdfdc24;border-radius:28px;background:radial-gradient(ellipse at 10% 0%,#ffffff09,transparent 65%),linear-gradient(125deg,#1a3038,#12242c);box-shadow:0 24px 70px #00000018,inset 0 1px #ffffff08}
 #ap-niche-premium .np-question{grid-column:1/-1;text-align:left;margin:0 0 28px;padding:0 0 26px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:110px 1fr;align-items:center;gap:20px}
 #ap-niche-premium .np-question>span{font-size:10px;letter-spacing:.16em;color:#d9b18b;display:flex;align-items:center;gap:12px}
 #ap-niche-premium .np-question>span:before{content:'';width:28px;height:28px;border:1px solid #d9b18b60;border-radius:50%;background:radial-gradient(circle,#d9b18b 2px,transparent 3px)}
 #ap-niche-premium .np-question p{font-size:19px;line-height:1.55;margin:0;color:#f4f0e6;letter-spacing:-.02em}
 #ap-niche-premium .np-step-list{display:flex;flex-direction:column;gap:8px;margin:0;align-self:center;position:relative}
 #ap-niche-premium .np-step-list button{position:relative;display:flex;flex-direction:row;align-items:center;gap:15px;text-align:left;border:1px solid transparent;border-radius:12px;padding:16px 12px;background:transparent;transition:background .3s,border-color .3s,color .3s;min-width:0;font-size:13px;line-height:1.5}
 #ap-niche-premium .np-step-list button b{width:32px;height:32px;display:grid;place-items:center;flex-shrink:0;border-radius:10px;font-size:11px;background:#ffffff04;border:1px solid #ffffff14;color:#9bb0b6}
 #ap-niche-premium .np-step-list button[aria-pressed=true]{background:#c18c5b10;border-color:#c18c5b45;color:#f8f0e5}
 #ap-niche-premium .np-step-list button[aria-pressed=true] b{background:linear-gradient(135deg,#b9875d,#795038);border-color:#dcaf8566;color:#fff4e7;box-shadow:0 3px 14px #0002}
 #ap-niche-premium .np-step-list button:hover{background:#ffffff06}
 #ap-niche-premium .np-dossier{width:100%;max-width:none;margin:0;border-radius:18px;background:linear-gradient(145deg,#20353e,#192d35);box-shadow:0 12px 32px #0002;align-self:stretch;display:flex;flex-direction:column}
 #ap-niche-premium .np-dossier .np-window{padding:15px 22px;font-size:11px}
 #ap-niche-premium .np-dossier .np-window small{max-width:140px;line-height:1.5;font-size:10px}
 #ap-niche-premium .np-step-panel{padding:28px 24px;min-height:235px;flex:1}
 #ap-niche-premium .np-step-panel h3{font-size:25px;line-height:1.2;letter-spacing:-.035em;margin:15px 0}
 #ap-niche-premium .np-step-panel p{font-size:14px;line-height:1.7;margin:14px 0}
 #ap-niche-premium .np-fields{gap:8px;margin-top:22px}
 #ap-niche-premium .np-fields span{font-size:10px;padding:7px 9px;background:#ffffff04;border:1px solid #ffffff0b;border-radius:6px;line-height:1.4}
 #ap-niche-premium .np-handoff{padding:15px 24px;font-size:11px;background:#ffffff02;line-height:1.6}
 #ap-niche-premium .np-detail{max-width:940px}
 @media(max-width:700px){#ap-niche-premium .np-section{padding-block:42px}#ap-niche-premium .np-hero{padding-top:30px}#ap-niche-premium .np-lead{font-size:16px}#ap-niche-premium .np-capabilities{gap:16px;font-size:10px}#ap-niche-premium .np-solution-panel{grid-template-columns:1fr;gap:24px}#ap-niche-premium .np-solution-copy{text-align:center}#ap-niche-premium .np-tabs{gap:6px}#ap-niche-premium .np-tabs button{padding:11px 9px;font-size:12px;flex:1}#ap-niche-premium .np-step-list{grid-template-columns:1fr 1fr;gap:8px}#ap-niche-premium .np-step-list button{flex-direction:row;text-align:left;font-size:12px}#ap-niche-premium .np-step-list b{flex-shrink:0}#ap-niche-premium .np-step-panel{padding:24px;min-height:250px}#ap-niche-premium .np-window{padding:14px 20px}#ap-niche-premium .np-handoff{padding:16px 24px}#ap-niche-premium .np-pains{grid-template-columns:1fr}#ap-niche-premium .np-final{padding:36px 20px}#ap-niche-premium .np-question p{font-size:16px}}
 @media(prefers-reduced-motion:reduce){#ap-niche-premium *{animation:none!important;transition:none!important}}
 @media(max-width:700px){#ap-niche-premium .np-journey{grid-template-columns:minmax(0,1fr);padding:18px;gap:18px;border-radius:22px}#ap-niche-premium .np-question{grid-template-columns:1fr;gap:12px;margin:0;padding-bottom:20px}#ap-niche-premium .np-question p{font-size:17px}#ap-niche-premium .np-step-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}#ap-niche-premium .np-step-list button{font-size:11px;padding:10px 7px;gap:8px}#ap-niche-premium .np-step-list button b{width:25px;height:25px;font-size:10px}#ap-niche-premium .np-step-panel{padding:22px 18px;min-height:230px}#ap-niche-premium .np-step-panel h3{font-size:23px}#ap-niche-premium .np-dossier .np-window{padding:12px 18px}#ap-niche-premium .np-handoff{padding:14px 18px}#ap-niche-premium .np-dossier{border-radius:14px}}
</style>
<script>
 const root = document.querySelector<HTMLElement>('#ap-niche-premium');
 if(root){
  for(const kind of ['step','solution']){
   const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>(`[data-${kind}]`));
   const panels=Array.from(root.querySelectorAll<HTMLElement>(`[data-${kind}-panel]`));
   buttons.forEach((button,index)=>button.addEventListener('click',()=>{
    buttons.forEach((item,i)=>item.setAttribute('aria-pressed',String(i===index)));
    panels.forEach((panel,i)=>panel.hidden=i!==index);
   }));
  }
 }
</script>
