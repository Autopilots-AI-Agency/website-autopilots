---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { intakePath } from '../../config/intake';
import { solutionItems } from '../../data/solutions';
import type { Product } from "../../data/products";
import { niches } from "../../data/niches";
import VisualIcon from "../ui/VisualIcon.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { localizedNicheData } from "../../i18n/catalog";
import { localizedProductData, productPageCopy } from "../../i18n/productPage";

interface Props { product: Product; locale?: SupportedLocale }
const { product: sourceProduct, locale = "nl" } = Astro.props;
const product = localizedProductData(locale, sourceProduct);
const localizedNiches = niches.map((niche) => localizedNicheData(locale, niche));
const selectedNiche = localizedNiches[0];
const copy = productPageCopy[locale];
const scopeLabels = {
  nl:{scope:"Productspecificatie",included:"Dit zit in de inrichting",result:"Resultaat in de werkdag",rules:"Kennis, regels en overdracht"},
  en:{scope:"Product specification",included:"Included in the setup",result:"Result in the working day",rules:"Knowledge, rules and handoff"},
  de:{scope:"Produktspezifikation",included:"In der Einrichtung enthalten",result:"Ergebnis im Arbeitsalltag",rules:"Wissen, Regeln und Übergabe"},
  es:{scope:"Especificación del producto",included:"Incluido en la configuración",result:"Resultado en la jornada",rules:"Conocimiento, reglas y transferencia"},
  it:{scope:"Specifiche del prodotto",included:"Incluso nella configurazione",result:"Risultato nella giornata",rules:"Conoscenza, regole e passaggio"},
  fr:{scope:"Spécification du produit",included:"Inclus dans la configuration",result:"Résultat au quotidien",rules:"Connaissances, règles et transfert"}
}[locale];
const productPath = localizedPath(`product.${sourceProduct.slug}`, locale);
const pillar = solutionItems(locale)[sourceProduct.slug === 'autopilots-crm' ? 1 : 0];
const productsPath = pillar.href;
const appointmentPath = intakePath(locale);
const nicheRoutes = Object.fromEntries(niches.map((niche) => [niche.slug, localizedPath(`niche.${niche.slug}`, locale)]));
const clientData = JSON.stringify({ product, niches: localizedNiches, locale, copy, nicheRoutes }).replaceAll("<", "\\u003c");
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.name,
    description: product.metaDescription,
    url: new URL(productPath, Astro.site ?? Astro.url.origin).toString(),
    brand: { "@type": "Brand", name: "Autopilots" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: copy.home, item: new URL(localizedPath("page.home", locale), Astro.site ?? Astro.url.origin).toString() },
      { "@type": "ListItem", position: 2, name: pillar.name, item: new URL(productsPath, Astro.site ?? Astro.url.origin).toString() },
      { "@type": "ListItem", position: 3, name: product.name, item: new URL(productPath, Astro.site ?? Astro.url.origin).toString() }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: product.faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } }))
  }
];
---

<BaseLayout title={product.seoTitle} description={product.metaDescription} canonical={productPath} schema={schema} locale={locale} contentId={`product.${sourceProduct.slug}`}>
  <article class:list={["ap-ecosystem", "ap-product-page", `is-${product.slug}`]} data-product-root data-product={product.slug}>
    <nav class="ap-breadcrumb" aria-label="Broodkruimel">
      <div class="ap-container"><a href={localizedPath("page.home", locale)}>{copy.home}</a><span aria-hidden="true">/</span><a href={productsPath}>{pillar.name}</a><span aria-hidden="true">/</span><span aria-current="page">{product.name}</span></div>
    </nav>

    <section class="ap-eco-hero">
      <div class="ap-container ap-eco-hero-grid">
        <div class="ap-eco-copy">
          <VisualIcon type="product" name={product.slug} size="large" label={`${product.name} icoon`} />
          <div class="ap-kicker ap-icon-kicker">{product.name}</div>
          <h1>{product.hero} <span class="ap-title-accent">{product.accent}</span></h1>
          <p class="ap-lead">{product.intro}</p>
          <div class="ap-actions">
            <a class="ap-button ap-button-primary" data-ap-event="appointment_cta_clicked" data-ap-product={product.slug} href={`${appointmentPath}?product=${product.slug}`}>{copy.appointment}</a>
            
          </div>
          <a class="ap-text-link" href="#interactieve-demo">{copy.demoFirst} →</a>
          <p class="ap-inline-proof"><span class="ap-proof-dot" aria-hidden="true"></span><span>{product.promise}</span></p>
        </div>
        <aside class="ap-product-visual" aria-label={`${product.name} workflow`}>
          <div class="ap-visual-head"><span>{product.eyebrow}</span><strong>{copy.liveFlow}</strong></div>
          <div class="ap-visual-route">
            {product.workflow.map((step, index) => (
              <div class="ap-visual-node"><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{step.label}</strong><small>{step.title}</small></div></div>
            ))}
          </div>
          <div class="ap-visual-status"><span></span>{copy.ready}</div>
        </aside>
      </div>
    </section>

    <section class="ap-section ap-soft-section ap-product-scope-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">{scopeLabels.scope}</div><h2>{product.problemTitle}</h2><p>{copy.problemIntro}</p></div>
        <div class="ap-product-scope-shell">
          <div class="ap-product-scope-top"><div><span>{scopeLabels.result}</span><strong>{product.workflow.at(-1)?.output}</strong></div><div><span>{scopeLabels.rules}</span><strong>{product.promise}</strong></div></div>
          <div class="ap-clarity-columns">
            <div><h3>{copy.stuck}</h3><ol>{product.problems.map((problem, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{problem.title}</strong><p>{problem.text}</p></div></li>)}</ol></div>
            <div><h3>{scopeLabels.included}</h3><ol>{product.core.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{item.title}</strong><p>{item.text}</p></div></li>)}</ol></div>
          </div>
        </div>
      </div>
    </section>

    <section class="ap-section" id="branche-inrichting">
      <div class="ap-container">
        <div class="ap-section-head">
          <div class="ap-kicker">{copy.branch}</div>
          <h2>{copy.branchTitle}</h2>
          <p>{copy.branchIntro}</p>
        </div>
        <div class="ap-niche-selector">
          <div class="ap-niche-options" role="list" aria-label={copy.chooseBranch}>
            {localizedNiches.map((niche, index) => (
              <button type="button" class:list={[{ "is-active": index === 0 }]} data-niche={niche.slug} aria-pressed={index === 0 ? "true" : "false"}>
                <span>{String(index + 1).padStart(2, "0")}</span>{niche.name}
              </button>
            ))}
          </div>
          <article class="ap-niche-result" aria-live="polite">
            <div class="ap-kicker">{product.name} — <span data-selected-name>{selectedNiche.name}</span></div>
            <h3><span data-selected-heading>{product.name} — {selectedNiche.name}.</span></h3>
            <p data-selected-copy>{copy.configured} {selectedNiche.intake.slice(0, 4).join(", ")} {copy.connected} {selectedNiche.systems.slice(0, 3).join(", ")}.</p>
            <div class="ap-niche-detail-grid">
              <div><small>{copy.example}</small><strong data-selected-question>{selectedNiche.conversation.customer}</strong></div>
              <div><small>{copy.intake}</small><strong data-selected-intake>{selectedNiche.intake.slice(0, 3).join(" · ")}</strong></div>
              <div><small>{copy.systems}</small><strong data-selected-systems>{selectedNiche.systems.slice(0, 3).join(" · ")}</strong></div>
            </div>
            <div class="ap-actions">
              <a class="ap-button ap-button-primary" data-selected-link href={`${nicheRoutes[selectedNiche.slug]}?product=${product.slug}#producten`}>{copy.viewAI} {selectedNiche.name.toLowerCase()}</a>
              <a class="ap-text-link ap-on-dark" href="#interactieve-demo">{copy.testDemo} →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="ap-section ap-dark-section" id="interactieve-demo">
      <div class="ap-container">
        <div class="ap-section-head">
          <div class="ap-kicker">{copy.interactive}</div>
          <h2>{copy.demoTitle}</h2>
          <p>{copy.demoIntro}</p>
        </div>
        <div class="ap-demo-shell">
          <div class="ap-demo-tabs" role="tablist" aria-label={`${product.name} demostappen`}>
            {product.workflow.map((step, index) => (
              <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} class:list={[{ "is-active": index === 0 }]} data-demo-step={index}>
                <span>{String(index + 1).padStart(2, "0")}</span><strong>{step.label}</strong>
              </button>
            ))}
          </div>
          <article class="ap-demo-panel" role="tabpanel" aria-live="polite">
            <div class="ap-kicker" data-demo-label>{product.workflow[0].label}</div>
            <h3 data-demo-title>{product.workflow[0].title}</h3>
            <p data-demo-text>{product.workflow[0].text}</p>
            <div class="ap-demo-output"><small>{copy.output}</small><strong data-demo-output>{product.workflow[0].output}</strong></div>
            <div class="ap-demo-context"><span>{copy.selected}</span><strong data-demo-niche>{selectedNiche.name}</strong></div>
            <div class="ap-demo-controls"><button type="button" data-demo-previous>{copy.previous}</button><button type="button" data-demo-reset>{copy.again}</button></div>
          </article>
        </div>
      </div>
    </section>

    <section class="ap-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">{copy.impact}</div><h2>{copy.impactTitle}</h2><p>{copy.impactIntro}</p></div>
        <div class="ap-calculator">
          <div class="ap-calculator-inputs">
            <label><span>{product.calculator.volumeLabel}</span><strong data-volume-value>{selectedNiche.metric.volume}</strong><input data-volume type="range" min="20" max="1000" step="10" value={selectedNiche.metric.volume} /></label>
            <label><span>{product.calculator.minutesLabel}</span><strong data-minutes-value>{selectedNiche.metric.minutes}</strong><input data-minutes type="range" min="2" max="30" step="1" value={selectedNiche.metric.minutes} /></label>
            <label><span>{product.calculator.automationLabel}</span><strong><span data-automation-value>{selectedNiche.metric.automation}</span>%</strong><input data-automation type="range" min="10" max="90" step="1" value={selectedNiche.metric.automation} /></label>
          </div>
          <div class="ap-calculator-output">
            <span>{product.calculator.outputLabel}</span>
            <strong><span data-hours>0</span> uur</strong>
            <p><span data-actions>0</span> {copy.contacts}</p>
            <small>{copy.disclaimer}</small>
          </div>
        </div>
      </div>
    </section>

    <section class="ap-section ap-dark-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">{copy.boundaries}</div><h2>{copy.boundariesTitle}</h2><p>{copy.boundariesIntro}</p></div>
        <div class="ap-boundary-columns"><div><h3>{copy.agreements}</h3>{product.boundaries.map((item) => <article><strong>{item.title}</strong><p>{item.text}</p></article>)}</div><div><h3>{copy.fit}</h3>{product.fit.map((item) => <article><strong>{item.title}</strong><p>{item.text}</p></article>)}</div></div>
        <details class="ap-integration-details"><summary>{copy.integrations} <span aria-hidden="true">+</span></summary><div>{product.integrations.map((item) => <span>{item}</span>)}</div><p>{copy.integrationNote}</p></details>
      </div>
    </section>

    <section class="ap-section ap-soft-section">
      <div class="ap-container ap-faq-layout">
        <div class="ap-section-head"><div class="ap-kicker">{copy.faq}</div><h2>{copy.faqTitle}</h2></div>
        <div class="ap-faq-list">{product.faq.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="ap-section ap-final-section">
      <div class="ap-container ap-final-card">
        <div><div class="ap-kicker">{copy.next}</div><h2>{copy.nextTitle}</h2><p>{copy.nextText}</p></div>
        <div class="ap-actions"><a class="ap-button ap-button-primary" data-ap-event="appointment_cta_clicked" data-ap-product={product.slug} href={`${appointmentPath}?product=${product.slug}`}>{copy.appointment}</a></div>
      </div>
    </section>
  </article>

  <script id="ap-product-data" type="application/json" set:html={clientData}></script>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-product-root]");
    const dataNode = document.getElementById("ap-product-data");
    if (!root || !dataNode) return;
    const data = JSON.parse(dataNode.textContent || "{}");
    let selected = data.niches[0];

    const setText = (selector, value) => { const node = root.querySelector(selector); if (node) node.textContent = value; };
    const setNiche = (slug, updateUrl = true) => {
      selected = data.niches.find((item) => item.slug === slug) || data.niches[0];
      root.querySelectorAll("[data-niche]").forEach((button) => {
        const active = button.dataset.niche === selected.slug;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      setText("[data-selected-name]", selected.name);
      setText("[data-selected-heading]", `${data.product.name} — ${selected.name}.`);
      setText("[data-selected-copy]", `${data.copy.configured} ${selected.intake.slice(0, 4).join(", ")} ${data.copy.connected} ${selected.systems.slice(0, 3).join(", ")}.`);
      setText("[data-selected-question]", selected.conversation.customer);
      setText("[data-selected-intake]", selected.intake.slice(0, 3).join(" · "));
      setText("[data-selected-systems]", selected.systems.slice(0, 3).join(" · "));
      setText("[data-demo-niche]", selected.name);
      const link = root.querySelector("[data-selected-link]");
      if (link) { link.href = `${data.nicheRoutes[selected.slug]}?product=${data.product.slug}#producten`; link.textContent = `${data.copy.viewAI} ${selected.name}`; }
      const finalLink = root.querySelector("[data-final-niche]");
      if (finalLink) { finalLink.href = `${data.nicheRoutes[selected.slug]}?product=${data.product.slug}#producten`; finalLink.textContent = `${data.copy.viewAI} ${selected.name}`; }
      const values = [["[data-volume]", selected.metric.volume], ["[data-minutes]", selected.metric.minutes], ["[data-automation]", selected.metric.automation]];
      values.forEach(([selector, value]) => { const input = root.querySelector(selector); if (input) input.value = value; });
      updateCalculator();
      try { sessionStorage.setItem("ap-selected-niche", selected.slug); } catch (_) {}
      if (updateUrl) {
        const url = new URL(location.href); url.searchParams.set("branche", selected.slug); history.replaceState({}, "", url);
      }
    };

    const updateCalculator = () => {
      const volume = Number(root.querySelector("[data-volume]")?.value || 0);
      const minutes = Number(root.querySelector("[data-minutes]")?.value || 0);
      const automation = Number(root.querySelector("[data-automation]")?.value || 0);
      const localeTag = {nl:"nl-NL",en:"en-US",de:"de-DE",es:"es-ES",it:"it-IT",fr:"fr-FR"}[data.locale] || data.locale;
      setText("[data-volume-value]", volume.toLocaleString(localeTag));
      setText("[data-minutes-value]", minutes);
      setText("[data-automation-value]", automation);
      setText("[data-hours]", Math.round((volume * minutes * automation / 100) / 60).toLocaleString(localeTag));
      setText("[data-actions]", Math.round(volume * automation / 100).toLocaleString(localeTag));
    };

    root.querySelectorAll("[data-niche]").forEach((button) => button.addEventListener("click", () => setNiche(button.dataset.niche)));
    root.querySelectorAll("[data-volume],[data-minutes],[data-automation]").forEach((input) => input.addEventListener("input", updateCalculator));
    const showDemoStep = (requestedIndex) => {
      const buttons = [...root.querySelectorAll("[data-demo-step]")];
      const button = buttons[Math.max(0, Math.min(requestedIndex, buttons.length - 1))];
      if (!button) return;
      const stepIndex = Number(button.dataset.demoStep || 0);
      const step = data.product.workflow[stepIndex] || data.product.workflow[0];
      root.querySelectorAll("[data-demo-step]").forEach((item) => { const active = item === button; item.classList.toggle("is-active", active); item.setAttribute("aria-selected", String(active)); item.tabIndex = active ? 0 : -1; });
      setText("[data-demo-label]", step.label); setText("[data-demo-title]", step.title); setText("[data-demo-text]", step.text); setText("[data-demo-output]", step.output);
      button.focus({ preventScroll: true });
    };
    root.querySelectorAll("[data-demo-step]").forEach((button) => button.addEventListener("click", () => showDemoStep(Number(button.dataset.demoStep || 0))));
    root.querySelectorAll("[data-demo-step]").forEach((button) => button.addEventListener("keydown", (event) => {
      if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const current = Number(button.dataset.demoStep || 0);
      const last = data.product.workflow.length - 1;
      const next = event.key === "Home" ? 0 : event.key === "End" ? last : ["ArrowRight", "ArrowDown"].includes(event.key) ? (current + 1) % (last + 1) : (current - 1 + last + 1) % (last + 1);
      showDemoStep(next);
    }));
    root.querySelector("[data-demo-previous]")?.addEventListener("click", () => {
      const current = Number(root.querySelector("[data-demo-step][aria-selected='true']")?.dataset.demoStep || 0);
      showDemoStep(Math.max(0, current - 1));
    });
    root.querySelector("[data-demo-reset]")?.addEventListener("click", () => showDemoStep(0));

    const params = new URLSearchParams(location.search);
    let initial = params.get("branche");
    if (!initial) { try { initial = sessionStorage.getItem("ap-selected-niche"); } catch (_) {} }
    setNiche(initial || data.niches[0].slug, false);
  })();
</script>

<style>
  .ap-icon-kicker{display:block;margin-top:24px}.ap-on-dark{color:#fff}.ap-product-page :global(.ap-product-visual),.ap-product-page :global(.ap-dark-section){background-color:#071d33;background-image:radial-gradient(circle at 100% 100%,rgba(159,56,38,.3),transparent 34%),linear-gradient(145deg,#071d33,#0d3151)}.ap-product-scope-section{background:#f2f5f7}.ap-product-scope-shell{overflow:hidden;border:1px solid rgba(8,35,60,.14);border-radius:30px;background:#fff;box-shadow:0 28px 70px rgba(8,35,60,.08)}.ap-product-scope-top{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(255,255,255,.12);color:#fff}.ap-product-scope-top>div{min-height:130px;background:linear-gradient(145deg,#071d33,#0d3151);padding:25px}.ap-product-scope-top>div:last-child{background:radial-gradient(circle at 100% 100%,rgba(159,56,38,.3),transparent 45%),linear-gradient(145deg,#0b2945,#123958)}.ap-product-scope-top span{color:#efaa9c;font:700 9px/1.2 "Syne",sans-serif;letter-spacing:1.2px;text-transform:uppercase}.ap-product-scope-top strong{display:block;max-width:470px;margin-top:12px;font-size:15px;line-height:1.48}.ap-clarity-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(30px,6vw,80px);padding:8px 28px}.ap-clarity-columns>div{padding:26px 0}.ap-clarity-columns>div+div{border-left:1px solid var(--ap-line);padding-left:clamp(24px,5vw,56px)}.ap-clarity-columns h3{margin:0 0 14px;color:#315068;font:700 11px/1.2 "Syne",sans-serif;letter-spacing:1px;text-transform:uppercase}.ap-clarity-columns ol{margin:0;padding:0;list-style:none}.ap-clarity-columns li{display:grid;grid-template-columns:34px minmax(0,1fr);gap:12px;border-top:1px solid var(--ap-line);padding:17px 0}.ap-clarity-columns li>span{color:var(--ap-brown);font:700 9px "Syne",sans-serif}.ap-clarity-columns strong{font-size:14px}.ap-clarity-columns p{margin:7px 0 0;color:var(--ap-muted);font-size:12px;line-height:1.55}.ap-boundary-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(32px,7vw,92px);border-block:1px solid rgba(255,255,255,.15);padding:26px 0}.ap-boundary-columns>div+div{border-left:1px solid rgba(255,255,255,.14);padding-left:clamp(24px,5vw,56px)}.ap-boundary-columns h3{margin:0 0 10px;color:#e7a295;font-size:14px;text-transform:uppercase;letter-spacing:1px}.ap-boundary-columns article{border-top:1px solid rgba(255,255,255,.13);padding:17px 0}.ap-boundary-columns strong{font-size:15px}.ap-boundary-columns p{margin:7px 0 0;color:rgba(255,255,255,.62);font-size:12px;line-height:1.55}.ap-integration-details{margin-top:26px;border-top:1px solid rgba(255,255,255,.15);border-bottom:1px solid rgba(255,255,255,.15)}.ap-integration-details summary{display:flex;justify-content:space-between;padding:18px 0;cursor:pointer;font-weight:850;list-style:none}.ap-integration-details summary::-webkit-details-marker{display:none}.ap-integration-details>div{display:flex;flex-wrap:wrap;gap:8px;padding-bottom:15px}.ap-integration-details>div>span{border-left:1px solid #e7a295;padding-left:10px;color:rgba(255,255,255,.75);font-size:12px}.ap-integration-details>p{padding-bottom:18px;color:rgba(255,255,255,.55);font-size:11px}@media(max-width:720px){.ap-product-scope-top,.ap-clarity-columns,.ap-boundary-columns{grid-template-columns:1fr}.ap-clarity-columns{padding:6px 22px}.ap-clarity-columns>div+div,.ap-boundary-columns>div+div{border-top:1px solid var(--ap-line);border-left:0;padding-left:0}.ap-boundary-columns>div+div{border-color:rgba(255,255,255,.14)}}
</style>
