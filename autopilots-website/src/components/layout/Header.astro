---
import { solutionItems } from "../../data/solutions";
import { niches } from "../../data/niches";
import VisualIcon from "../ui/VisualIcon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { defaultLocale, type SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { uiCopy } from "../../i18n/ui";
import { localizedNiche, localizedProductPromise } from "../../i18n/catalog";

interface Props { locale?: SupportedLocale; contentId?: string }
const { locale = defaultLocale, contentId = "page.home" } = Astro.props;
const copy = uiCopy[locale];
const popularNiches = niches.slice(0, 8);
const productPath = (slug: string) => localizedPath(`product.${slug}`, locale);
const nichePath = (slug: string) => localizedPath(`niche.${slug}`, locale);
const routeNicheName = (slug: string, fallback: string) => locale === "nl" ? fallback : nichePath(slug).split("/").filter(Boolean).at(-1)!.replaceAll("-", " ").replace(/(^|\s)\p{L}/gu, (letter) => letter.toUpperCase());
const nicheCopy = (slug: string, fallback: string) => localizedNiche(locale, slug, routeNicheName(slug, fallback));
---

<header class="ap-header">
  <div class="ap-container ap-header-inner">
    <a class="ap-logo" href={localizedPath("page.home", locale)} aria-label="Autopilots home">AUTOPILOTS</a>
    <button class="ap-mobile-toggle" type="button" aria-expanded="false" aria-controls="ap-main-nav" data-mobile-toggle><span></span><span></span><span></span><strong>{copy.navigation.menu}</strong></button>
    <nav class="ap-nav" id="ap-main-nav" aria-label={copy.navigation.menu} data-main-nav>
      <div class="ap-menu-shell">
        <a class="ap-menu-trigger" href={localizedPath("page.products", locale)} aria-haspopup="true">{copy.navigation.products}</a>
        <div class="ap-mega" aria-label={copy.navigation.products}>
          <div class="ap-mega-feature">
            <div><div class="ap-menu-label">{copy.header.productsLabel}</div><h3>{copy.header.productsTitle}</h3><p>{copy.header.productsText}</p></div>
            <a class="ap-text-link" href={localizedPath("page.products", locale)}>{copy.header.productsCta} →</a>
          </div>
          <div class="ap-mega-grid">
            {solutionItems(locale).map((solution) => <a class="ap-mega-link" href={solution.href}><div><strong>{solution.name}</strong><span>{solution.description}</span></div></a>)}
          </div>
        </div>
      </div>
      <div class="ap-menu-shell">
        <a class="ap-menu-trigger" href={localizedPath("page.niches", locale)} aria-haspopup="true">{copy.navigation.niches}</a>
        <div class="ap-mega" aria-label={copy.navigation.niches}>
          <div class="ap-mega-feature">
            <div><div class="ap-menu-label">{copy.header.nichesLabel}</div><h3>{copy.header.nichesTitle}</h3><p>{copy.header.nichesText}</p></div>
            <a class="ap-text-link" href={localizedPath("page.niches", locale)}>{copy.header.nichesCta} →</a>
          </div>
          <div class="ap-mega-grid">
            {popularNiches.map((niche) => { const item = nicheCopy(niche.slug, niche.name); return <a class="ap-mega-link" href={nichePath(niche.slug)}><VisualIcon type="niche" name={niche.slug} size="small" /><div><strong>{item.name}</strong><span>{item.lead}</span></div></a> })}
          </div>
        </div>
      </div>
      <a href={localizedPath("page.knowledge", locale)}>{copy.navigation.knowledge}</a><a href={localizedPath("page.crew", locale)}>{copy.navigation.crew}</a><a class="ap-nav-mobile-only" href={localizedPath("page.appointment", locale)}>{copy.navigation.appointment}</a>
    </nav>
    <div class="ap-header-actions"><a class="ap-button ap-button-primary ap-header-cta" href={localizedPath("page.appointment", locale)}>{copy.navigation.appointment}</a><LanguageSwitcher locale={locale} contentId={contentId} /></div>
  </div>
</header>

<style>
  .ap-header{position:sticky;top:0;z-index:40;border-bottom:1px solid rgba(0,0,0,.08);background:rgba(245,245,242,.9);backdrop-filter:blur(16px)}
  .ap-header-inner{position:relative;display:flex;min-height:74px;align-items:center;justify-content:space-between;gap:18px}.ap-logo{font-family:"Syne",sans-serif;font-size:13px;font-weight:700;letter-spacing:2px}
  .ap-nav{display:flex;align-items:center;gap:8px;border:1px solid var(--ap-line);border-radius:999px;background:rgba(255,255,255,.76);padding:6px}.ap-nav>a,.ap-menu-trigger{display:inline-flex;align-items:center;border:0;border-radius:999px;padding:10px 12px;color:var(--ap-muted);font-size:13px;font-weight:850;transition:background .18s ease,color .18s ease}.ap-nav>a:hover,.ap-nav>a:focus-visible,.ap-menu-shell:hover .ap-menu-trigger,.ap-menu-trigger:focus-visible{background:var(--ap-soft-2);color:var(--ap-text);outline:none}.ap-nav>a[aria-current="page"],.ap-menu-trigger[aria-current="page"]{background:#e7e7e2;color:var(--ap-text);box-shadow:inset 0 0 0 1px rgba(17,17,17,.035)}.ap-nav .ap-nav-mobile-only{display:none}
  .ap-menu-shell{position:relative}.ap-menu-shell:after{content:"";position:absolute;z-index:1;top:100%;left:-8px;right:-8px;height:46px}.ap-mega{position:fixed;top:88px;left:50vw;width:min(1120px,calc(100vw - 36px));display:grid;grid-template-columns:minmax(360px,.8fr) minmax(0,1.2fr);gap:16px;transform:translateX(-50%) translateY(8px);border:1px solid var(--ap-line);border-radius:30px;background:rgba(255,255,255,.98);box-shadow:0 24px 70px rgba(17,17,17,.14);padding:16px;opacity:0;pointer-events:none;transition:opacity .16s ease,transform .16s ease}.ap-menu-shell:hover .ap-mega,.ap-menu-shell:focus-within .ap-mega{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
  .ap-mega-feature{min-height:230px;display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--ap-line);padding:24px 28px 24px 16px}.ap-menu-label{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase}.ap-mega-feature h3{margin:12px 0 0;font-size:28px;line-height:1.06}.ap-mega-feature p{max-width:330px;margin:12px 0 0;color:var(--ap-muted);font-size:13px;line-height:1.5}.ap-mega-feature .ap-text-link{align-self:flex-start}
  .ap-mega-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.ap-mega-link{display:grid;grid-template-columns:40px minmax(0,1fr);gap:10px;align-items:center;border:1px solid transparent;border-radius:17px;padding:10px;transition:background .16s ease,border-color .16s ease}.ap-mega-link:hover,.ap-mega-link:focus-visible{border-color:var(--ap-line);background:var(--ap-soft-2);outline:none}.ap-mega-icon{display:grid;width:40px;height:40px;place-items:center;border-radius:14px;background:#111;color:#fff;font-family:"Syne",sans-serif;font-size:10px;font-weight:700}.ap-mega-link strong,.ap-mega-link span{display:block}.ap-mega-link strong{font-size:13px;line-height:1.1}.ap-mega-link div>span{display:-webkit-box;overflow:hidden;margin-top:4px;color:var(--ap-muted);font-size:10px;line-height:1.25;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .ap-header-actions{display:flex;align-items:center;gap:12px;white-space:nowrap}.ap-header-order{color:var(--ap-muted);font-size:12px;font-weight:850}.ap-header-order:hover,.ap-header-order:focus-visible{color:var(--ap-brown)}.ap-header-cta{min-height:42px;padding:12px 16px;font-size:12px}.ap-mobile-toggle{display:none;border:0;background:transparent;color:#111;cursor:pointer}.ap-mobile-toggle span{display:block;width:21px;height:2px;border-radius:2px;background:currentColor}.ap-mobile-toggle strong{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  @media(max-width:920px){.ap-mega,.ap-menu-shell:after{display:none}}
  @media(max-width:1080px){.ap-header-order{display:none}}
  @media(max-width:820px){.ap-header-inner{padding:11px 0}.ap-mobile-toggle{display:inline-flex;min-width:44px;min-height:44px;flex-direction:column;align-items:center;justify-content:center;gap:4px;margin-left:auto;border-radius:14px}.ap-mobile-toggle:hover,.ap-mobile-toggle:focus-visible{background:#fff;outline:2px solid rgba(159,56,38,.28);outline-offset:2px}.ap-nav{position:absolute;inset:calc(100% + 1px) 0 auto;display:none;flex-direction:column;align-items:stretch;border-radius:22px;background:#fff;box-shadow:0 24px 70px rgba(17,17,17,.15);padding:9px}.ap-nav.is-open{display:flex}.ap-nav>a,.ap-menu-trigger{width:100%;justify-content:flex-start;padding:13px 14px}.ap-nav .ap-nav-mobile-only{display:inline-flex}.ap-nav .ap-nav-mobile-only:first-of-type{background:var(--ap-brown);color:#fff}.ap-header-actions{display:flex}.ap-header-actions .ap-header-cta{display:none}}
</style>

<script is:inline>
  (()=>{const toggle=document.querySelector("[data-mobile-toggle]");const nav=document.querySelector("[data-main-nav]");if(!toggle||!nav)return;const close=()=>{nav.classList.remove("is-open");toggle.setAttribute("aria-expanded","false");document.body.classList.remove("ap-menu-open")};const setOpen=open=>{nav.classList.toggle("is-open",open);toggle.setAttribute("aria-expanded",String(open));document.body.classList.toggle("ap-menu-open",open&&innerWidth<=820)};toggle.addEventListener("click",()=>setOpen(!nav.classList.contains("is-open")));nav.addEventListener("click",event=>{if(event.target.closest("a")&&innerWidth<=820)close()});document.addEventListener("keydown",event=>{if(event.key==="Escape"&&nav.classList.contains("is-open")){close();toggle.focus()}});document.addEventListener("click",event=>{if(innerWidth<=820&&nav.classList.contains("is-open")&&!event.target.closest(".ap-header"))close()});addEventListener("resize",()=>{if(innerWidth>820)close()});const path=location.pathname;nav.querySelectorAll("a[href]").forEach(link=>{const href=new URL(link.href).pathname;if(href!=="/"&&path.startsWith(href))link.setAttribute("aria-current","page")})})();
</script>
