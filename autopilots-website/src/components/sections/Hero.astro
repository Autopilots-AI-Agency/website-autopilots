---
import type { SupportedLocale } from "../../i18n/languages";
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  text: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  chips?: string[];
  panelLabel?: string;
  flowRows?: Array<[string, string]>;
  locale?: SupportedLocale;
}

const {
  eyebrow,
  title,
  accent,
  text,
  primaryLabel = "Plan een afspraak",
  primaryHref = "/nl/afspraak/",
  secondaryLabel = "Bekijk hoe het werkt",
  secondaryHref = "#systeem",
  chips = [],
  panelLabel,
  flowRows,
  locale="nl"
} = Astro.props;
const flowCopy={
 nl:{label:"Autopilots proces",rows:[["Lead komt binnen","Website, ads of telefoon"],["AI kwalificeert","Context, behoefte en timing"],["Afspraak gepland","Direct in agenda en CRM"],["Opvolging loopt","Geen kans blijft liggen"]]},
 en:{label:"Autopilots process",rows:[["Lead arrives","Website, ads or phone"],["AI qualifies","Context, need and timing"],["Appointment booked","Directly in calendar and CRM"],["Follow-up continues","No opportunity is left behind"]]},
 es:{label:"Proceso Autopilots",rows:[["Llega el lead","Web, anuncios o teléfono"],["La IA cualifica","Contexto, necesidad y momento"],["Cita programada","Directamente en agenda y CRM"],["Seguimiento activo","Ninguna oportunidad se pierde"]]},
 de:{label:"Autopilots Prozess",rows:[["Lead geht ein","Website, Anzeigen oder Telefon"],["KI qualifiziert","Kontext, Bedarf und Zeitpunkt"],["Termin geplant","Direkt in Kalender und CRM"],["Nachverfolgung läuft","Keine Chance bleibt liegen"]]},
 it:{label:"Processo Autopilots",rows:[["Arriva il lead","Sito, annunci o telefono"],["L'AI qualifica","Contesto, esigenza e tempistica"],["Appuntamento fissato","Direttamente in agenda e CRM"],["Follow-up attivo","Nessuna opportunità viene persa"]]},
 fr:{label:"Processus Autopilots",rows:[["Le lead arrive","Site, publicités ou téléphone"],["L'IA qualifie","Contexte, besoin et calendrier"],["Rendez-vous planifié","Directement dans l'agenda et le CRM"],["Le suivi continue","Aucune opportunité n'est perdue"]]}
}[locale];
const resolvedPanelLabel=panelLabel??flowCopy.label;
const resolvedFlowRows=flowRows??flowCopy.rows;
---

<section class="ap-hero">
  <div class="ap-container">
    <div class="ap-hero-grid">
      <div class="ap-hero-copy">
        <div class="ap-eyebrow">{eyebrow}</div>
        <h1 class="ap-page-title">
          {title}
          {accent && <span class="ap-accent"> {accent}</span>}
        </h1>
        <p class="ap-lead">{text}</p>
        <div class="ap-actions">
          <a class="ap-button ap-button-primary" data-ap-event={primaryHref.startsWith("/afspraak") || primaryHref.startsWith("/contact") ? "appointment_cta_clicked" : undefined} href={primaryHref}>{primaryLabel}</a>
          {secondaryHref && secondaryLabel && <a class="ap-text-link ap-hero-secondary" href={secondaryHref}>{secondaryLabel} →</a>}
        </div>
        {chips.length > 0 && <p class="ap-hero-products">{chips.join(" · ")}</p>}
      </div>
      <div class="ap-hero-panel" aria-label={resolvedPanelLabel}>
        <div class="ap-mini-flow">
          {resolvedFlowRows.map((row, index) => <div class="ap-flow-row"><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{row[0]}</strong><em>{row[1]}</em></div></div>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ap-hero {
    padding: 66px 0 54px;
  }

  .ap-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 24px;
    align-items: stretch;
  }

  .ap-hero-copy {
    padding-top: 28px;
  }

  .ap-hero-secondary { align-self: center; }
  .ap-hero-products { max-width: 720px; margin: 26px 0 0; color: var(--ap-muted); font-size: 12px; font-weight: 750; line-height: 1.6; }

  .ap-hero-panel {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    border: 1px solid var(--ap-line);
    border-radius: 34px;
    background: var(--ap-black);
    color: var(--ap-white);
    padding: 28px;
    box-shadow: 0 16px 50px rgba(17, 17, 17, 0.09);
  }

  .ap-hero-panel::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -100px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: rgba(159, 56, 38, 0.28);
    filter: blur(26px);
  }

  .ap-mini-flow {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 12px;
  }

  .ap-flow-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 14px;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    padding: 16px;
  }

  .ap-flow-row span {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 17px;
    background: var(--ap-white);
    color: var(--ap-brown);
    font-family: "Syne", "Public Sans", Arial, sans-serif;
    font-weight: 700;
  }

  .ap-flow-row strong,
  .ap-flow-row em {
    display: block;
    font-style: normal;
  }

  .ap-flow-row strong {
    font-size: 16px;
    line-height: 1.2;
    font-weight: 900;
  }

  .ap-flow-row em {
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 13px;
    line-height: 1.35;
    font-weight: 650;
  }

  @media (max-width: 920px) {
    .ap-hero-grid {
      grid-template-columns: 1fr;
    }

    .ap-hero-panel {
      min-height: auto;
    }
  }
</style>
