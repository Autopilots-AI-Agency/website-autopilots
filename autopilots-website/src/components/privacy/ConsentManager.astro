---
import { defaultLocale, type SupportedLocale } from "../../i18n/languages";
import { uiCopy } from "../../i18n/ui";
import { publicRuntime } from "../../config/publicRuntime";

interface Props { locale?: SupportedLocale }
const { locale = defaultLocale } = Astro.props;
const copy = uiCopy[locale].system;
---

<div id="ap-cookie-consent" class="ap-consent" data-consent-banner hidden role="dialog" aria-modal="false" aria-labelledby="ap-consent-title">
  <div>
    <strong id="ap-consent-title">{copy.consentTitle}</strong>
    <p>{copy.consentText}</p>
  </div>
  <div class="ap-consent-actions">
    <button type="button" data-consent-reject>{copy.consentReject}</button>
    <button type="button" class="is-primary" data-consent-accept>{copy.consentAccept}</button>
  </div>
</div>

<script define:vars={{ provider: publicRuntime.analyticsProvider, siteId: publicRuntime.analyticsSiteId }} is:inline>
  (() => {
    const storageKey = "autopilots_consent_v1";
    const banner = document.querySelector("[data-consent-banner]");
    let state = { necessary: true, analytics: false, decided: false };
    try {
      const stored = JSON.parse(localStorage.getItem(storageKey) || "null");
      if (stored && typeof stored.analytics === "boolean") state = { necessary: true, analytics: stored.analytics, decided: true };
    } catch (_) {}

    const publish = () => {
      window.autopilotsConsent = { ...state };
      window.dispatchEvent(new CustomEvent("autopilots:consent", { detail: { ...state } }));
      if (state.analytics && provider !== "none" && siteId) {
        // Providerconfiguratie is bewust losgekoppeld van toestemming. Een
        // provideradapter mag hier pas na expliciete toestemming laden.
        document.documentElement.dataset.analyticsProvider = provider;
      }
    };
    const save = (analytics) => {
      state = { necessary: true, analytics, decided: true };
      try { localStorage.setItem(storageKey, JSON.stringify({ analytics, updatedAt: new Date().toISOString() })); } catch (_) {}
      banner?.setAttribute("hidden", "");
      publish();
    };
    banner?.querySelector("[data-consent-accept]")?.addEventListener("click", () => save(true));
    banner?.querySelector("[data-consent-reject]")?.addEventListener("click", () => save(false));
    if (!state.decided) banner?.removeAttribute("hidden");
    publish();
  })();
</script>

<style>
  #ap-cookie-consent {
    position:fixed;right:24px;bottom:24px;z-index:1000;
    display:grid;grid-template-columns:1fr;gap:20px;
    width:min(440px,calc(100% - 32px));box-sizing:border-box;
    padding:24px;border:1px solid #bd875d55;border-radius:12px;
    background:#1a2d36;color:#f6f1e9;
    box-shadow:0 16px 48px #0005;
    font-family:'Public Sans',sans-serif;text-align:left;
    max-height:calc(100svh - 32px);overflow:auto;
  }
  #ap-cookie-consent[hidden]{display:none}
  #ap-cookie-consent strong{display:block;font-size:17px;line-height:1.35;font-weight:700;letter-spacing:-.025em}
  #ap-cookie-consent p{margin:10px 0 0;color:#aabcc2;font-size:13px;line-height:1.65}
  #ap-cookie-consent .ap-consent-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  #ap-cookie-consent button{min-width:0;min-height:48px;border:1px solid #bd875d66;border-radius:5px;background:#101e25;padding:12px;color:#f6f1e9;font:600 12px/1.4 'Public Sans',sans-serif;cursor:pointer;transition:background .2s,border-color .2s}
  #ap-cookie-consent button.is-primary{border-color:#bd875d;background:#875638}
  #ap-cookie-consent button:hover{background:#263d46;border-color:#bd875d}
  #ap-cookie-consent button.is-primary:hover{background:#996342}
  #ap-cookie-consent button:focus-visible{outline:2px solid #d8b394;outline-offset:3px}
  @media(max-width:680px){#ap-cookie-consent{right:16px;bottom:max(16px,env(safe-area-inset-bottom));padding:20px;gap:18px}#ap-cookie-consent strong{font-size:16px}}
  @media(prefers-reduced-motion:reduce){#ap-cookie-consent button{transition:none}}
</style>
