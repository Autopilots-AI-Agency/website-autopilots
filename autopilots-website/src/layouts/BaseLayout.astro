---
import "../styles/global.css";
import "../styles/ecosystem.css";
import "../styles/autoreviews-clean.css";
import "../styles/editorial-site.css";
import EditorialHeader from "../components/premium/EditorialHeader.astro";
import EditorialMotion from "../components/premium/EditorialMotion.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { contentIdFromPath, localizedAlternates } from "../i18n/routes";
import { defaultLocale, getLocale, getLocaleFromPath, type SupportedLocale } from "../i18n/languages";
import ConsentManager from "../components/privacy/ConsentManager.astro";
import { uiCopy } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: string;
  noindex?: boolean;
  schema?: object | object[];
  locale?: SupportedLocale;
  contentId?: string;
  customChrome?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = "/og/autopilots-og.svg",
  lang,
  noindex = false,
  schema,
  customChrome = false,
  locale = getLocaleFromPath(Astro.url.pathname) ?? defaultLocale,
  contentId = contentIdFromPath(Astro.url.pathname)
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url.origin).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).toString();
const siteUrl = new URL("/", Astro.site ?? Astro.url.origin).toString();
const localeConfig = getLocale(locale);
const ui = uiCopy[locale];
const editorial = !customChrome && !contentId?.startsWith('landing.') && !Astro.url.pathname.startsWith('/ontwerpen/');
const legacyDutchRoute = locale === "nl" && Astro.url.pathname !== "/" && !Astro.url.pathname.startsWith("/nl/") && !Astro.url.pathname.startsWith("/lp/") && !Astro.url.pathname.startsWith("/voorstel/");
const effectiveNoindex = noindex || legacyDutchRoute;
// Route-family parity is explicit: every localized sibling is emitted so crawlers and
// visitors can move between the same content family. Incomplete routes remain noindex
// at page level until their full template is connected.
const alternates = contentId ? localizedAlternates(contentId) : [];
const globalSchema = [
  { "@context": "https://schema.org", "@type": "Organization", name: "Autopilots", url: siteUrl, logo: ogImageUrl },
  { "@context": "https://schema.org", "@type": "WebSite", name: "Autopilots", url: siteUrl, inLanguage: localeConfig.tag }
];
const schemaItems = [...globalSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang={lang ?? localeConfig.tag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f5f2" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/og/autopilots-og.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={effectiveNoindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={localeConfig.og} />
    {alternates.filter((item) => item.locale !== locale).map((item) => <meta property="og:locale:alternate" content={getLocale(item.locale).og} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.tag} href={new URL(item.href, Astro.site ?? Astro.url.origin).toString()} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site ?? Astro.url.origin).toString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(schemaItems).replaceAll("<", "\\u003c")} />
    <slot name="head" />
  </head>
  <body class="ap-autoreviews-clean" id={editorial ? 'ap-editorial-site' : undefined}>
    <a class="ap-skip-link" href="#main-content">{ui.system.skipToContent}</a>
    {!customChrome && (editorial ? <EditorialHeader locale={locale} contentId={contentId}/> : <Header locale={locale} contentId={contentId} />)}
    <main id="main-content">
      <slot />
    </main>
    {!customChrome && <Footer locale={locale} editorial={editorial} />}
    {editorial && <EditorialMotion/>}
    <ConsentManager locale={locale} />
    <script is:inline>
      (() => {
        const sent = new Set();
        const emit = (name, detail = {}, onceKey = "") => {
          const key = onceKey && `${name}:${onceKey}`;
          if (key && sent.has(key)) return;
          if (key) sent.add(key);
          const safe = { event: name, page_path: location.pathname, ...detail, _ap_origin: "layout" };
          window.dispatchEvent(new CustomEvent("autopilots:analytics", { detail: safe }));
          if (window.autopilotsConsent?.analytics && Array.isArray(window.dataLayer)) window.dataLayer.push(safe);
        };
        window.addEventListener("autopilots:analytics", (event) => {
          const detail = event.detail || {};
          if (detail._ap_origin === "layout" || !detail.event) return;
          if (window.autopilotsConsent?.analytics && Array.isArray(window.dataLayer)) window.dataLayer.push({ ...detail, page_path: detail.page_path || location.pathname });
        });
        const productRoot = document.querySelector("[data-product-root]");
        const nicheRoot = document.querySelector("[data-niche-root]");
        if (productRoot) emit("product_viewed", { product: productRoot.dataset.product }, location.pathname);
        if (nicheRoot) emit("niche_viewed", { niche: nicheRoot.dataset.niche }, location.pathname);
        const campaignKeys = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gclid", "fbclid", "msclkid"];
        const campaign = new URLSearchParams(location.search);
        if (campaignKeys.some((key) => campaign.has(key))) {
          document.querySelectorAll('a[href^="/nl/afspraak/"],a[href^="/nl/bestel-direct/"],a[href^="/voorstel/"]').forEach((anchor) => {
            const url = new URL(anchor.href, location.origin);
            campaignKeys.forEach((key) => { if (campaign.has(key) && !url.searchParams.has(key)) url.searchParams.set(key, campaign.get(key)); });
            anchor.href = `${url.pathname}${url.search}${url.hash}`;
          });
        }
        const pricing = document.querySelector("[data-pricing-view]");
        if (pricing && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver((entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            emit("pricing_viewed", { niche: nicheRoot?.dataset.niche }, location.pathname);
            observer.disconnect();
          }, { threshold: .22 });
          observer.observe(pricing);
        }
        document.addEventListener("click", (event) => {
          const target = event.target.closest("[data-ap-event]");
          if (target) emit(target.dataset.apEvent, { product: target.dataset.apProduct || undefined, niche: target.dataset.apNiche || undefined });
          const productChoice = event.target.closest("[data-order-product-choice]");
          if (productChoice) emit("product_selected", { product: productChoice.dataset.orderProductChoice });
          const nicheChoice = event.target.closest("[data-niche]");
          if (nicheChoice) emit("niche_selected", { niche: nicheChoice.dataset.niche, product: productRoot?.dataset.product });
          const demo = event.target.closest("[data-demo-step],[data-niche-step]");
          if (demo) {
            const index = Number(demo.dataset.demoStep ?? demo.dataset.nicheStep ?? 0);
            emit(index >= 3 ? "demo_completed" : "demo_started", { step: index + 1 }, index >= 3 ? location.pathname : `${location.pathname}:start`);
          }
        });
        document.addEventListener("toggle", (event) => {
          const detail = event.target;
          if (detail.matches(".ap-faq-list details,.ap-blog-faq details") && detail.open) emit("faq_opened", { question: detail.querySelector("summary")?.textContent?.trim().slice(0, 120) });
        }, true);
        document.addEventListener("input", (event) => {
          if (event.target.matches("[data-volume],[data-minutes],[data-automation],[data-n-volume],[data-n-minutes],[data-n-automation]")) emit("calculator_used", {}, location.pathname);
        });
        window.addEventListener("autopilots:roi-updated", (event) => emit("roi_calculator_used", event.detail || {}, location.pathname));
      })();
    </script>
  </body>
</html>
